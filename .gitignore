node_modules/
.env
.DS_Store
*.log
*.jsonl
npm-debug.log*
tools/

# local audit dumps
.audit-envvars.txt

# Apple Pay merchant-domain-association files MUST NEVER be committed.
# Each Stripe account issues its own (pspId is account-bound). Sharing one
# file across multiple deployments creates a deterministic cluster signal
# for Stripe Risk. Provide via APPLE_PAY_DOMAIN_ASSOCIATION env var per deploy.
apple-developer-merchantid-domain-association
apple-developer-merchantid-domain-association*
**/.well-known/apple-developer-merchantid-domain-association

# Operator secrets (registrar API keys, etc.) MUST NEVER be committed.
# Read by operator/* scripts. Never share across operators without rotation.
secrets/
secrets/**

# MCP config (contains API tokens)
.cursor/mcp.json

# Local timed agent session state
.agent-session/
dev-runner.js
package.json
start-store.bat
start-campaign.bat

# Generated ad image tests (not campaign assets)
test gens/
