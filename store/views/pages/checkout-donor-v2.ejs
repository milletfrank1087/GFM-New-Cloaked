<!DOCTYPE html>
<html lang="<%= donor.lang || 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= locale.pageTitle %></title>
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <% if (paymentProcessor === 'stripe') { %>
  <script src="https://js.stripe.com/v3/"></script>
  <% } %>
  <% if (metaPixelId) { %>
  <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    (function(){
      var __am = {};
      <% if (donorExternalId) { %>__am.external_id = '<%= donorExternalId %>';<% } %>
      <% if (donorCountryCode) { %>__am.country = '<%= donorCountryCode.toLowerCase() %>';<% } %>
      <% if (donorEmail) { %>__am.em = '<%= donorEmail.toLowerCase().trim() %>';<% } %>
      if (Object.keys(__am).length > 0) { fbq('init', '<%= metaPixelId %>', __am); }
      else { fbq('init', '<%= metaPixelId %>'); }
    })();
  </script>
  <% } %>
  <% if (typeof tiktokPixelId !== 'undefined' && tiktokPixelId) { %>
  <script>
    !function (w, d, t) {
      w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];
      ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie"];
      ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};
      for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);
      ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e};
      ttq.load=function(e,n){var i="https://analytics.tiktok.com/i18n/pixel/events.js";
      ttq._i=ttq._i||{},ttq._i[e]=[],ttq._i[e]._u=i,ttq._t=ttq._t||{},ttq._t[e]=+new Date,ttq._o=ttq._o||{},ttq._o[e]=n||{};
      var o=document.createElement("script");o.type="text/javascript",o.async=!0,o.src=i+"?sdkid="+e+"&lib="+t;
      var a=document.getElementsByTagName("script")[0];a.parentNode.insertBefore(o,a)};
      ttq.load('<%= tiktokPixelId %>');
    }(window, document, 'ttq');
  </script>
  <% } %>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', '-apple-system', 'BlinkMacSystemFont', '"Segoe UI"', 'Roboto', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#ecfdf5', 100: '#d1fae5', 200: '#a7f3d0',
              500: '#10b981', 600: '#059669', 700: '#047857',
              800: '#065f46', 900: '#064e3b'
            },
            surface: {
              subtle: '#f8fafc', card: '#ffffff',
              border: '#e2e8f0', muted: '#64748b'
            }
          },
          boxShadow: {
            'card': '0 4px 20px -2px rgba(15, 23, 42, 0.05), 0 2px 6px -1px rgba(15, 23, 42, 0.02)',
            'card-elevated': '0 16px 36px -4px rgba(15, 23, 42, 0.08), 0 4px 14px -2px rgba(15, 23, 42, 0.03)',
            'brand-glow': '0 8px 24px -2px rgba(5, 150, 105, 0.28)'
          }
        }
      }
    }
  </script>
  <style>
    :root {
      --font-primary: 'Plus Jakarta Sans', sans-serif;
      --color-brand: #059669;
      --color-brand-dark: #047857;
      --color-brand-light: #ecfdf5;
      --ease-spring: cubic-bezier(0.16, 1, 0.3, 1);
    }
    * { -webkit-tap-highlight-color: transparent; }
    html { height: 100%; }
    body {
      min-height: 100%;
      font-family: var(--font-primary);
      background: linear-gradient(135deg, #f0fdf4 0%, #f8fafc 40%, #f1f5f9 100%);
      letter-spacing: -0.012em;
    }
    input:focus, .StripeElement--focus {
      border-color: var(--color-brand) !important;
      box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.12);
    }
    ::selection { background-color: var(--color-brand); color: white; }

    @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    .fade-up { animation: fadeUp 0.4s var(--ease-spring) forwards; }
    .fade-up-delay { animation: fadeUp 0.4s var(--ease-spring) 0.1s forwards; opacity: 0; }

    @keyframes pulse-glow {
      0%, 100% { box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.35); }
      50% { box-shadow: 0 0 0 6px rgba(5, 150, 105, 0); }
    }
    .live-dot { animation: pulse-glow 2s ease-in-out infinite; }

    @keyframes shimmer {
      0% { background-position: -200% 0; }
      100% { background-position: 200% 0; }
    }
    .skeleton-line {
      background: linear-gradient(90deg, #e2e8f0 25%, #f1f5f9 50%, #e2e8f0 75%);
      background-size: 200% 100%;
      animation: shimmer 1.5s infinite;
      border-radius: 6px;
    }
  </style>
</head>
<body class="min-h-full flex items-center justify-center p-4 py-8 antialiased" data-checkout-version="v2">
  <div class="w-full max-w-[460px] fade-up">

    <% if (campaignDisplay && campaignDisplay.image) { %>
    <div class="flex items-center gap-3 mb-4 px-1">
      <img src="<%= campaignDisplay.image %>" alt="" class="w-11 h-11 rounded-xl object-cover shadow-sm border border-white/80">
      <div class="min-w-0">
        <p class="text-xs font-semibold text-slate-600 truncate"><%= locale.supportMessage %></p>
        <p class="text-sm font-bold text-slate-900 truncate"><%= campaignDisplay.beneficiary || campaignDisplay.title || '' %></p>
      </div>
    </div>
    <% } %>

    <div id="checkout-card" class="bg-white rounded-2xl shadow-card-elevated border border-slate-100/80 overflow-hidden">

      <div class="px-6 pt-5 pb-4 border-b border-slate-100">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <button onclick="if(history.length>1){history.back()}else{window.close()}" class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 flex items-center justify-center transition-all active:scale-95 flex-shrink-0 cursor-pointer" aria-label="Back">
              <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <div>
              <h1 class="text-lg font-bold text-slate-900 tracking-tight"><%= locale.title %></h1>
              <p class="text-xs text-slate-400 font-medium mt-0.5 flex items-center gap-1">
                <svg class="w-3 h-3 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                <%= locale.subtitle %>
              </p>
            </div>
          </div>
          <div class="text-right">
            <span class="text-2xl font-extrabold text-brand-700 tracking-tight"><%= formattedTotal %></span>
            <% if (typeof cadence !== 'undefined' && cadence === 'monthly') { %>
            <span class="block text-[10px] text-brand-600 font-semibold mt-0.5"><%= locale.perMonth || '/ month' %></span>
            <% } %>
          </div>
        </div>
      </div>

      <div class="px-6 pt-5 pb-6">

        <% if (showFeeBreakdown) { %>
        <div class="bg-brand-50/60 border border-brand-200/50 rounded-xl p-3 mb-4 text-xs space-y-1">
          <div class="flex justify-between text-slate-600">
            <span><%= locale.contributionLabel %></span>
            <span class="font-semibold text-slate-800"><%= formattedDonation %></span>
          </div>
          <div class="flex justify-between text-slate-600">
            <span><%= locale.feeLabel %></span>
            <span class="font-semibold text-slate-800"><%= formattedFee %></span>
          </div>
          <div class="border-t border-brand-200/50 pt-1 flex justify-between font-bold text-slate-900">
            <span><%= locale.totalLabel %></span>
            <span><%= formattedTotal %></span>
          </div>
        </div>
        <% } %>

        <div class="grid grid-cols-2 gap-3 mb-4">
          <div>
            <label for="billing-email" class="block text-xs font-bold text-slate-700 mb-1.5"><%= locale.email %></label>
            <input type="email" id="billing-email" value="<%= donor.email || '' %>" placeholder="you@example.com" autocomplete="email"
              class="w-full border-2 border-slate-200 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none transition-colors text-slate-900 placeholder-slate-400">
          </div>
          <div>
            <label for="billing-name" class="block text-xs font-bold text-slate-700 mb-1.5"><%= locale.fullName %></label>
            <input type="text" id="billing-name" placeholder="<%= locale.namePlaceholder %>" autocomplete="name"
              class="w-full border-2 border-slate-200 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none transition-colors text-slate-900 placeholder-slate-400">
          </div>
        </div>

        <div class="flex items-center gap-2.5 mb-3">
          <div class="flex-1 h-px bg-slate-200/80"></div>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider"><%= locale.paymentMethod %></span>
          <div class="flex-1 h-px bg-slate-200/80"></div>
        </div>

        <div id="payment-element-wrapper" class="fade-up-delay">
          <div id="payment-loading" class="flex items-center justify-center py-10">
            <div class="flex flex-col items-center gap-2.5">
              <div class="w-8 h-8 rounded-full border-2 border-brand-200 border-t-brand-600 animate-spin"></div>
              <p class="text-xs text-slate-400 font-medium"><%= locale.loading %></p>
            </div>
          </div>
          <% if (paymentProcessor === 'stripe') { %>
          <div id="payment-element"></div>
          <% } else { %>
          <div id="apple-pay-container" class="mb-2"></div>
          <div id="google-pay-container" class="mb-2"></div>
          <div id="paypal-button-container" class="mb-2"></div>
          <div id="venmo-button-container" class="mb-2"></div>
          <div class="flex items-center gap-2 my-3">
            <div class="flex-1 h-px bg-slate-200"></div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">or pay with card</span>
            <div class="flex-1 h-px bg-slate-200"></div>
          </div>
          <div class="space-y-2.5">
            <div id="card-name-field" class="w-full min-h-[42px] rounded-xl"></div>
            <div id="card-number-field" class="w-full min-h-[42px] rounded-xl"></div>
            <div class="grid grid-cols-2 gap-2.5">
              <div id="card-expiry-field" class="w-full min-h-[42px] rounded-xl"></div>
              <div id="card-cvv-field" class="w-full min-h-[42px] rounded-xl"></div>
            </div>
          </div>
          <% } %>
        </div>

        <div id="payment-error" class="hidden text-red-600 text-sm mb-3 p-3 bg-red-50 rounded-xl border border-red-100 font-medium"></div>

        <button id="submit-payment" disabled
          class="w-full bg-brand-600 hover:bg-brand-700 active:scale-[0.98] text-white py-3.5 rounded-xl font-bold text-base transition-all shadow-brand-glow hover:shadow-lg disabled:opacity-40 disabled:cursor-not-allowed flex items-center justify-center gap-2 mt-4 cursor-pointer"
          data-paytext="<%= locale.pay %> <%= formattedTotal %>"
          data-processing="<%= locale.processing %>">
          <svg id="payment-spinner" class="hidden animate-spin w-5 h-5" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
          </svg>
          <svg class="w-4 h-4 -ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          <span id="btn-text"><%= locale.pay %> <%= formattedTotal %></span>
        </button>

        <% if (typeof cadence !== 'undefined' && cadence === 'monthly') { %>
        <p id="cadence-checkout-note" class="text-center text-xs text-slate-500 font-medium mt-2.5"><%= locale.monthlyNote || 'Monthly gift · cancel anytime' %></p>
        <% } %>

        <div class="mt-5 bg-slate-50 rounded-xl p-3.5 border border-slate-100">
          <div class="flex items-center gap-2 mb-2">
            <div class="relative flex-shrink-0">
              <div class="w-2 h-2 rounded-full bg-brand-600 live-dot"></div>
            </div>
            <svg class="w-4 h-4 text-brand-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            <span class="text-xs font-bold text-slate-700"><%= locale.protectedTitle %></span>
          </div>
          <p class="text-[11px] text-slate-400 leading-relaxed pl-8"><%= paymentProcessor === 'paypal' ? locale.protectedDesc.replace(/Stripe/g, 'PayPal') : locale.protectedDesc %></p>
        </div>

        <div class="flex items-center justify-center gap-5 mt-3.5">
          <div class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            <span class="text-[10px] font-semibold text-slate-400"><%= locale.secure %></span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            <span class="text-[10px] font-semibold text-slate-400"><%= locale.ssl %></span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
            </svg>
            <span class="text-[10px] font-semibold text-slate-400"><%= paymentProcessor === 'paypal' ? 'Secured by PayPal' : locale.poweredBy %></span>
          </div>
        </div>
      </div>
    </div>

    <p class="text-center text-[10px] text-slate-400 mt-3.5 leading-relaxed">
      <%= locale.consent %> <button onclick="showLegalModal('terms')" class="underline hover:text-slate-600 font-medium cursor-pointer"><%= locale.terms %></button> <%= locale.and %> <button onclick="showLegalModal('privacy')" class="underline hover:text-slate-600 font-medium cursor-pointer"><%= locale.privacy %></button>.
    </p>

    <div id="legal-modal" class="fixed inset-0 z-[9999] hidden" style="background:rgba(15,23,42,0.4);backdrop-filter:blur(6px)">
      <div class="flex items-center justify-center min-h-full p-4">
        <div class="bg-white rounded-2xl shadow-card-elevated w-full max-w-lg max-h-[80vh] flex flex-col overflow-hidden border border-slate-100">
          <div class="flex items-center justify-between px-5 py-3.5 border-b border-slate-100">
            <h3 id="legal-modal-title" class="font-bold text-slate-900 text-sm tracking-tight"></h3>
            <button onclick="closeLegalModal()" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 flex items-center justify-center transition-colors cursor-pointer">
              <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>
          <div id="legal-modal-body" class="px-5 py-4 overflow-y-auto text-xs text-slate-500 leading-relaxed"></div>
        </div>
      </div>
    </div>
    <script>
    const legalTexts = {
      terms: {
        title: "Terms of Service",
        body: '<h4 class="font-bold text-slate-900 text-sm mb-2">1. Platform Nature & Scope</h4><p class="text-slate-500 text-xs leading-relaxed mb-3">HopeRise operates as a verified medical appeal registry, connecting donors with patients who have documented clinical need for treatments not available or funded through their national health service or insurance. HopeRise is not a charity, hospital, or medical provider. All appeals undergo independent clinical verification before publication.</p><h4 class="font-bold text-slate-900 text-sm mb-2">2. Donor Obligations</h4><p class="text-slate-500 text-xs leading-relaxed mb-3">By contributing, you confirm you are at least 18 years of age and that the payment method used is your own or that you have explicit authorization from the account holder. Contributions are voluntary and non-refundable except as outlined in the Refund Policy. Recurring pledges may be cancelled at any time.</p><h4 class="font-bold text-slate-900 text-sm mb-2">3. Fund Disbursement</h4><p class="text-slate-500 text-xs leading-relaxed mb-3">Funds are held in a segregated trust account and disbursed directly against pro-forma hospital invoices issued by the designated clinical provider. No funds are released to the patient, their family, or any intermediary.</p><h4 class="font-bold text-slate-900 text-sm mb-2">4. Platform Maintenance Contribution</h4><p class="text-slate-500 text-xs leading-relaxed mb-3">An optional platform maintenance tip may be offered at checkout. This contribution is clearly separated from the clinical fund and supports operational costs including payment processing, hosting, donor communications, and outreach.</p><h4 class="font-bold text-slate-900 text-sm mb-2">5. Appeal Verification Standard</h4><p class="text-slate-500 text-xs leading-relaxed mb-3">Each published appeal includes documentation verified against: (a) original hospital diagnostic records, (b) named consulting physician or specialist confirmation, (c) treatment plan issued by the receiving institution, and (d) cost documentation under the applicable medical fee schedule.</p><h4 class="font-bold text-slate-900 text-sm mb-2">6. Limitation of Liability</h4><p class="text-slate-500 text-xs leading-relaxed mb-3">HopeRise facilitates verified appeals but does not guarantee any specific medical outcome. Treatment outcomes depend on the clinical provider and the patient\'s individual medical circumstances.</p><h4 class="font-bold text-slate-900 text-sm mb-2">7. Governing Law</h4><p class="text-slate-500 text-xs leading-relaxed">These terms are governed by applicable law in the donor\'s jurisdiction. Any disputes shall be subject to the appropriate courts.</p>'
      },
      privacy: {
        title: "Privacy Policy",
        body: '<h4 class="font-bold text-slate-900 text-sm mb-2">1. Data Controller</h4><p class="text-slate-500 text-xs leading-relaxed mb-3">HopeRise is the data controller for personal information collected through this platform. We are committed to protecting your privacy in accordance with applicable data protection laws.</p><h4 class="font-bold text-slate-900 text-sm mb-2">2. Information We Collect</h4><p class="text-slate-500 text-xs leading-relaxed mb-3">We collect only the information necessary to process your contribution: name, email address, and payment card details (processed and tokenized by our PCI DSS Level 1 certified payment processor). We do not store raw card numbers on our servers.</p><h4 class="font-bold text-slate-900 text-sm mb-2">3. How We Use Your Data</h4><p class="text-slate-500 text-xs leading-relaxed mb-3">Your data is used to: (a) process and receipt your contribution, (b) manage recurring pledge schedules, (c) send campaign updates you have opted into, and (d) comply with financial regulations and anti-fraud requirements. We do not sell, trade, or rent your personal data to third parties.</p><h4 class="font-bold text-slate-900 text-sm mb-2">4. Anonymous Giving</h4><p class="text-slate-500 text-xs leading-relaxed mb-3">If you select the anonymous contribution option, your name will not appear on any public-facing part of the campaign. Your data will still be retained internally for financial compliance.</p><h4 class="font-bold text-slate-900 text-sm mb-2">5. Data Retention</h4><p class="text-slate-500 text-xs leading-relaxed mb-3">Transaction records are retained for 7 years as required by financial regulations. Donor communication preferences and account data are retained until you request deletion.</p><h4 class="font-bold text-slate-900 text-sm mb-2">6. Your Rights</h4><p class="text-slate-500 text-xs leading-relaxed mb-3">You have the right to: access your personal data, rectify inaccurate data, request erasure (where legally permitted), restrict processing, data portability, and object to processing. Contact <span class="text-brand-600">support@hoperise.uk</span> to exercise these rights.</p><h4 class="font-bold text-slate-900 text-sm mb-2">7. Payment Security</h4><p class="text-slate-500 text-xs leading-relaxed">All payment transactions are encrypted via TLS 1.3 (256-bit) and processed by a PCI DSS Level 1 certified payment processor. Card data is tokenized at the point of entry and never touches our application servers.</p>'
      }
    };
    function showLegalModal(type) {
      var data = legalTexts[type] || legalTexts.terms;
      document.getElementById('legal-modal-title').textContent = data.title;
      document.getElementById('legal-modal-body').innerHTML = data.body;
      document.getElementById('legal-modal').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
    function closeLegalModal() {
      document.getElementById('legal-modal').classList.add('hidden');
      document.body.style.overflow = '';
    }
    document.getElementById('legal-modal').addEventListener('click', function(e) { if (e.target === this) closeLegalModal(); });
    </script>
  </div>

  <meta name="store-name" content="<%= store.name %>">
  <input type="hidden" id="payment-amount" value="<%= paymentAmountUnits %>">
  <input type="hidden" id="payment-currency" value="<%= (donor.currency || 'eur').toLowerCase() %>">
  <input type="hidden" id="payment-decimals" value="<%= currencyDecimals %>">
  <input type="hidden" id="cadence-type" value="<%= typeof cadence !== 'undefined' ? cadence : 'once' %>">
  <input type="hidden" id="selected-tip-amount" value="<%= serviceFee %>">
  <input type="hidden" id="locale-per-month" value="<%= locale.perMonth || '/ month' %>">
  <input type="hidden" id="locale-monthly-note" value="<%= locale.monthlyNote || 'Monthly gift · cancel anytime' %>">
  <input type="hidden" id="locale-email-error" value="<%= locale.emailError %>">
  <% if (metaPixelId) { %>
  <input type="hidden" id="payment-pixel-id" value="<%= metaPixelId %>">
  <% } %>
  <% if (purchaseEventId) { %>
  <input type="hidden" id="payment-event-id" value="<%= purchaseEventId %>">
  <% } %>
  <% if (donorExternalId) { %>
  <input type="hidden" id="payment-external-id" value="<%= donorExternalId %>">
  <% } %>
  <% if (donorCountryCode) { %>
  <input type="hidden" id="payment-country" value="<%= donorCountryCode.toLowerCase() %>">
  <% } %>
  <% if (donorEmail) { %>
  <input type="hidden" id="payment-donor-email" value="<%= donorEmail %>">
  <% } %>
  <% if (paymentProcessor === 'stripe') { %>
  <input type="hidden" id="stripe-key" value="<%= stripePublishableKey %>">
  <input type="hidden" id="payment-locale" value="<%= locale.stripeLocale || donor.lang || 'auto' %>">

  <script>
  window.showSuccessScreen = window.showSuccessScreen || function(d) {
    console.warn('[v2-thankyou] Fallback showSuccessScreen triggered');
    var c = document.getElementById('checkout-card');
    if (c) c.innerHTML = '<div class="text-center p-10"><h2 class="text-xl font-extrabold text-slate-900 mb-2">Thank You</h2><p class="text-sm text-slate-500 mb-4">Your payment has been processed.</p><button onclick="window.location.href=\'' + (d && d.redirectUrl ? d.redirectUrl : '/') + '\'" class="bg-brand-600 text-white px-6 py-3 rounded-xl font-bold text-sm cursor-pointer">Return to Campaign</button></div>';
    else if (d && d.redirectUrl) window.location.href = d.redirectUrl;
  };
  (function() {
    var cadence = document.getElementById('cadence-type')?.value || 'once';
    var isMonthly = cadence === 'monthly';
    var currencySymbol = '<%= symbol %>';
    var currencyCode = '<%= (donor.currency || "EUR").toUpperCase() %>';
    var donationAmount = parseFloat('<%= donationAmount %>');
    var campaignDisplay = {};
    try { campaignDisplay = JSON.parse('<%= campaignDisplayJson %>'); } catch(e) {}
    var beneficiary = campaignDisplay.beneficiary || campaignDisplay.title || '';

    function computeUpsellAmounts(oneTimeAmt) {
      var base = Math.max(1, Math.round(oneTimeAmt * 0.3));
      var lo = Math.max(1, base - 2);
      var mid = base;
      var hi = Math.min(oneTimeAmt, base + 3);
      return [lo, mid, hi].filter(function(v, i, a) { return a.indexOf(v) === i && v >= 1; });
    }

    var _upsellSessionId = null;

    window.showSuccessScreen = function(confirmData) {
      console.log('[v2-thankyou] showSuccessScreen called, isMonthly:', isMonthly, 'confirmData:', JSON.stringify(confirmData));
      _upsellSessionId = confirmData.sessionId || null;
      var card = document.getElementById('checkout-card');
      if (!card) {
        console.error('[v2-thankyou] #checkout-card not found, falling back to redirect');
        if (confirmData.redirectUrl) window.location.href = confirmData.redirectUrl;
        return;
      }
      var wrapper = card.parentElement;

      var headerBanner = wrapper.querySelector('.flex.items-center.gap-3.mb-4');
      if (headerBanner) headerBanner.style.display = 'none';

      if (isMonthly) {
        card.innerHTML = buildThankYouMonthly();
      } else {
        card.innerHTML = buildThankYouOneTime(confirmData);
      }
      card.style.animation = 'none';
      void card.offsetHeight;
      card.style.animation = 'fadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards';

      var consent = wrapper.querySelector('p.text-center.text-\\[10px\\]');
      if (consent) consent.style.display = 'none';
    };

    function buildThankYouMonthly() {
      return '<div class="text-center px-6 py-10">'
        + '<div class="w-16 h-16 rounded-full bg-brand-50 mx-auto mb-4 flex items-center justify-center">'
        + '<svg class="w-8 h-8 text-brand-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>'
        + '</div>'
        + '<h2 class="text-xl font-extrabold text-slate-900 tracking-tight mb-1">You\'re Incredible</h2>'
        + '<p class="text-sm text-slate-500 mb-5">Your monthly gift of <strong class="text-brand-700">' + currencySymbol + donationAmount.toFixed(2) + '/mo</strong> gives ' + (beneficiary ? beneficiary : 'this patient') + ' something money alone can\'t buy — the certainty that someone out there hasn\'t given up on them.</p>'
        + '<div class="bg-brand-50/60 border border-brand-200/50 rounded-xl p-4 mb-6 text-left">'
        + '<p class="text-xs font-bold text-slate-800 mb-1.5">What happens next</p>'
        + '<ul class="text-xs text-slate-600 space-y-1.5">'
        + '<li class="flex items-start gap-2"><svg class="w-3.5 h-3.5 text-brand-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg><span>A receipt has been sent to your email</span></li>'
        + '<li class="flex items-start gap-2"><svg class="w-3.5 h-3.5 text-brand-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg><span>You can cancel anytime with 1 click from any receipt</span></li>'
        + '<li class="flex items-start gap-2"><svg class="w-3.5 h-3.5 text-brand-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg><span>Every month you\'re helping cover another cycle of treatment</span></li>'
        + '</ul>'
        + '</div>'
        + buildShareRow()
        + '<button onclick="returnToCampaign()" class="w-full bg-brand-600 hover:bg-brand-700 active:scale-[0.98] text-white py-3 rounded-xl font-bold text-sm transition-all shadow-brand-glow cursor-pointer mt-2">Return to Campaign</button>'
        + '</div>';
    }

    function buildThankYouOneTime(confirmData) {
      var amounts = computeUpsellAmounts(donationAmount);
      var defaultIdx = Math.min(1, amounts.length - 1);
      var defaultAmt = amounts[defaultIdx];

      var amountChips = '';
      for (var i = 0; i < amounts.length; i++) {
        var sel = i === defaultIdx ? 'border-brand-600 bg-brand-50 text-brand-700' : 'border-slate-200 bg-white text-slate-700 hover:border-brand-300';
        amountChips += '<button data-upsell-amt="' + amounts[i] + '" onclick="selectUpsellAmount(' + amounts[i] + ')" class="upsell-chip px-4 py-2 rounded-xl border-2 text-sm font-bold transition-all cursor-pointer ' + sel + '">' + currencySymbol + amounts[i] + '/mo</button>';
      }

      return '<div class="text-center px-6 py-8">'
        + '<div class="w-16 h-16 rounded-full bg-brand-50 mx-auto mb-4 flex items-center justify-center">'
        + '<svg class="w-8 h-8 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 6L9 17l-5-5"/></svg>'
        + '</div>'
        + '<h2 class="text-xl font-extrabold text-slate-900 tracking-tight mb-1">From the Bottom of Our Hearts</h2>'
        + '<p class="text-sm text-slate-500 mb-2">Your gift of <strong class="text-brand-700">' + currencySymbol + donationAmount.toFixed(2) + '</strong> has been received. Every single contribution, no matter the size, brings ' + (beneficiary ? beneficiary : 'this patient') + ' one step closer to treatment.</p>'
        + '<p class="text-xs text-slate-400 mb-6">Thank you for being the kind of person who acts when it matters most.</p>'

        + '<div class="bg-gradient-to-br from-brand-50 to-slate-50 border border-brand-200/60 rounded-2xl p-5 mb-5 text-left">'
        + '<div class="flex items-center gap-2 mb-2">'
        + '<div class="w-7 h-7 rounded-lg bg-brand-600 flex items-center justify-center flex-shrink-0"><svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg></div>'
        + '<p class="text-sm font-bold text-slate-900">Go even further</p>'
        + '</div>'
        + '<p class="text-xs text-slate-600 mb-1">Treatment doesn\'t stop after one session — it takes months of continuous cycles. A small recurring gift means the medical team can plan ahead with confidence, knowing the funding won\'t disappear between appointments.</p>'
        + '<p class="text-[11px] text-slate-400 mb-4">Your card is already saved. One tap, no forms.</p>'

        + '<div class="flex items-center justify-center gap-2 mb-3">' + amountChips + '</div>'

        + '<div class="mb-3">'
        + '<input id="upsell-slider" type="range" min="1" max="' + Math.max(donationAmount, 20) + '" value="' + defaultAmt + '" class="w-full h-1.5 rounded-full appearance-none cursor-pointer" style="accent-color:#059669" oninput="onUpsellSlider(this.value)">'
        + '<div class="flex justify-between text-[10px] text-slate-400 mt-1"><span>' + currencySymbol + '1/mo</span><span>' + currencySymbol + Math.max(donationAmount, 20) + '/mo</span></div>'
        + '</div>'

        + '<p class="text-center text-xs text-slate-500 mb-3">That\'s just <strong class="text-brand-700" id="upsell-daily">' + currencySymbol + (defaultAmt / 30).toFixed(2) + '/day</strong> — cancel anytime</p>'

        + '<button id="upsell-accept-btn" onclick="acceptUpsell()" class="w-full bg-brand-600 hover:bg-brand-700 active:scale-[0.98] text-white py-3 rounded-xl font-bold text-sm transition-all shadow-brand-glow cursor-pointer flex items-center justify-center gap-2">'
        + '<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>'
        + '<span id="upsell-btn-label">Give ' + currencySymbol + defaultAmt + '/month</span>'
        + '</button>'
        + '</div>'

        + buildShareRow()
        + '<button onclick="returnToCampaign()" class="w-full text-slate-500 hover:text-slate-700 py-2.5 rounded-xl font-semibold text-xs transition-colors cursor-pointer">No thanks, return to campaign</button>'
        + '</div>';
    }

    function buildShareRow() {
      var shareUrl = '<%= typeof campaignOrigin !== "undefined" ? campaignOrigin : "" %>' || window.location.origin;
      return '<div class="flex gap-2 mb-3">'
        + '<a href="https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(shareUrl) + '" target="_blank" rel="noopener" class="flex-1 flex items-center justify-center gap-1.5 py-2.5 bg-[#1877f2] hover:bg-[#166fe5] text-white rounded-xl text-xs font-bold transition-colors no-underline">'
        + '<svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>Share</a>'
        + '<a href="https://wa.me/?text=' + encodeURIComponent(shareUrl) + '" target="_blank" rel="noopener" class="flex-1 flex items-center justify-center gap-1.5 py-2.5 bg-[#25d366] hover:bg-[#22c55e] text-white rounded-xl text-xs font-bold transition-colors no-underline">'
        + '<svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>WhatsApp</a>'
        + '</div>';
    }

    var selectedUpsellAmount = computeUpsellAmounts(donationAmount)[Math.min(1, computeUpsellAmounts(donationAmount).length - 1)];

    window.selectUpsellAmount = function(amt) {
      selectedUpsellAmount = amt;
      document.querySelectorAll('.upsell-chip').forEach(function(c) {
        var isThis = parseInt(c.dataset.upsellAmt) === amt;
        c.className = 'upsell-chip px-4 py-2 rounded-xl border-2 text-sm font-bold transition-all cursor-pointer ' +
          (isThis ? 'border-brand-600 bg-brand-50 text-brand-700' : 'border-slate-200 bg-white text-slate-700 hover:border-brand-300');
      });
      var slider = document.getElementById('upsell-slider');
      if (slider) slider.value = amt;
      document.getElementById('upsell-daily').textContent = currencySymbol + (amt / 30).toFixed(2) + '/day';
      document.getElementById('upsell-btn-label').textContent = 'Give ' + currencySymbol + amt + '/month';
    };

    window.onUpsellSlider = function(val) {
      var amt = Math.max(1, Math.round(parseFloat(val)));
      selectedUpsellAmount = amt;
      document.querySelectorAll('.upsell-chip').forEach(function(c) {
        var isThis = parseInt(c.dataset.upsellAmt) === amt;
        c.className = 'upsell-chip px-4 py-2 rounded-xl border-2 text-sm font-bold transition-all cursor-pointer ' +
          (isThis ? 'border-brand-600 bg-brand-50 text-brand-700' : 'border-slate-200 bg-white text-slate-700 hover:border-brand-300');
      });
      document.getElementById('upsell-daily').textContent = currencySymbol + (amt / 30).toFixed(2) + '/day';
      document.getElementById('upsell-btn-label').textContent = 'Give ' + currencySymbol + amt + '/month';
    };

    window.acceptUpsell = async function() {
      var btn = document.getElementById('upsell-accept-btn');
      if (!btn || btn.disabled) return;
      btn.disabled = true;
      btn.innerHTML = '<svg class="animate-spin w-5 h-5" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg> <span>Processing...</span>';

      try {
        var resp = await fetch('/api/create-subscription-upsell', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ monthlyAmount: selectedUpsellAmount, sessionId: _upsellSessionId })
        });
        var data = await resp.json();
        if (data.success) {
          btn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 6L9 17l-5-5"/></svg> <span>Subscribed!</span>';
          btn.className = 'w-full bg-brand-700 text-white py-3 rounded-xl font-bold text-sm flex items-center justify-center gap-2 cursor-default';
          setTimeout(function() { returnToCampaign(); }, 2000);
        } else {
          btn.disabled = false;
          btn.innerHTML = '<span>Try again</span>';
          setTimeout(function() {
            btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg> <span id="upsell-btn-label">Give ' + currencySymbol + selectedUpsellAmount + '/month</span>';
          }, 2000);
        }
      } catch(e) {
        btn.disabled = false;
        btn.textContent = 'Something went wrong';
      }
    };

    window.returnToCampaign = function() {
      var origin = '<%= typeof campaignOrigin !== "undefined" ? campaignOrigin : "" %>';
      if (origin) {
        window.location.href = origin + '?status=complete';
      } else {
        window.location.href = '/';
      }
    };
  })();
  </script>

  <script src="/js/checkout.js"></script>
  <% } else { %>
  <script src="https://pay.google.com/gp/p/js/pay.js"></script>
  <script src="/js/paypal-sdk.js"></script>
  <script src="/js/paypal-ui.js"></script>
  <script src="/js/paypal-tracking.js"></script>
  <script src="/js/paypal-card-fields.js"></script>
  <script src="/js/paypal-buttons.js"></script>
  <script src="/js/paypal-apple-pay.js"></script>
  <script src="/js/paypal-google-pay.js"></script>
  <script src="/js/checkout-paypal.js"></script>
  <% } %>
</body>
</html>
