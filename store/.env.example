PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

STORE_ID=zenflow-tools
STORE_DOMAIN=zenflowtools.com

STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

CALLBACK_SECRET=your-shared-callback-secret
CAMPAIGN_CALLBACK_URLS=http://localhost:3000

# Resend (donation confirmation email). Verified domain required for the from-address.
RESEND_API_KEY=re_xxx
RESEND_FROM=OPERATION <receipts@risehope.online>
# Optional: where donor replies go (any inbox; e.g. a Gmail). Omit to disable reply-to.
RESEND_REPLY_TO=
# Brand/team name shown in the email body and bank-statement notice. Defaults to OPERATION.
RESEND_BRAND=OPERATION
