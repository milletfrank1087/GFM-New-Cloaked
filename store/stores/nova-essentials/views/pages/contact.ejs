<% const pageTitle = 'Contact'; const extraHead = ''; %>
<%- include('../layouts/store', { body: `
<div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 md:py-14">
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Get in Touch</h1>
    <p class="text-sm text-gray-400">Have a question or need help? We typically respond within 24 hours.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8">
    <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-3">
      <div class="w-9 h-9 rounded-lg bg-teal-50 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
      </div>
      <div class="min-w-0">
        <p class="text-xs font-semibold text-gray-900">Email</p>
        <p class="text-[11px] text-gray-400 truncate">${store.contact_email || 'hello@' + store.domain}</p>
      </div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-3">
      <div class="w-9 h-9 rounded-lg bg-rose-50 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-900">Response</p>
        <p class="text-[11px] text-gray-400">Within 24 hours</p>
      </div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-3">
      <div class="w-9 h-9 rounded-lg bg-amber-50 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418"/></svg>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-900">Global</p>
        <p class="text-[11px] text-gray-400">35+ countries served</p>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <form class="space-y-4" onsubmit="event.preventDefault(); this.querySelector('button').textContent='Message Sent!'; this.querySelector('button').disabled=true;">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">First Name</label>
          <input type="text" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm" placeholder="Jane" required>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Last Name</label>
          <input type="text" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm" placeholder="Smith" required>
        </div>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Email</label>
        <input type="email" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm" placeholder="jane@email.com" required>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Subject</label>
        <select class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-700">
          <option>Product question</option>
          <option>Order support</option>
          <option>Technical issue</option>
          <option>Other</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Message</label>
        <textarea rows="4" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm resize-none" placeholder="Tell us how we can help..." required></textarea>
      </div>
      <button type="submit" class="btn-primary w-full text-white py-2.5 rounded-lg font-semibold text-sm transition hover:shadow-lg">Send Message</button>
    </form>
  </div>

  <div class="mt-6 text-center">
    <p class="text-xs text-gray-400">Or check our <a href="/faq" class="text-primary hover:underline">FAQ</a> for quick answers.</p>
  </div>
</div>
`, store }) %>
