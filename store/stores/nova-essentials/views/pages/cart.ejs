<% const pageTitle = 'Cart'; const extraHead = ''; %>
<%- include('../layouts/store', { body: `
<div class="max-w-2xl mx-auto px-4 sm:px-6 py-10 md:py-16">
  <div id="cart-empty" style="display:none" class="text-center py-10">
    <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center mx-auto mb-5">
      <svg class="w-7 h-7 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z"/>
      </svg>
    </div>
    <h1 class="text-xl font-bold text-gray-900 mb-2">Your cart is empty</h1>
    <p class="text-sm text-gray-400 mb-6 max-w-xs mx-auto">Browse our collection of wellness tools and planners.</p>
    <a href="/products" class="btn-primary inline-flex items-center gap-2 text-white px-6 py-2.5 rounded-xl font-semibold text-sm transition hover:shadow-lg">Browse Products</a>
  </div>

  <div id="cart-filled" style="display:none">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-xl font-bold text-gray-900">Cart</h1>
      <span id="cart-item-count" class="text-xs text-gray-400"></span>
    </div>
    <div id="cart-items" class="bg-white rounded-xl border border-gray-200 p-4 mb-4"></div>
    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <div class="flex items-center justify-between mb-3">
        <span class="text-sm text-gray-500">Subtotal</span>
        <span id="cart-total" class="text-lg font-bold text-gray-900"></span>
      </div>
      <a href="/checkout" class="btn-primary w-full flex items-center justify-center gap-2 text-white py-3 rounded-xl font-semibold text-sm transition hover:shadow-lg">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        Checkout
      </a>
      <button onclick="Cart.clear(); Cart.renderCartPage();" class="w-full text-center text-xs text-gray-400 hover:text-red-500 mt-2 transition">Clear Cart</button>
    </div>
  </div>
</div>
`, store }) %>
