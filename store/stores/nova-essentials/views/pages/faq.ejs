<% const pageTitle = 'FAQ'; const extraHead = ''; %>
<%- include('../layouts/store', { body: `
<div class="max-w-2xl mx-auto px-4 sm:px-6 py-10 md:py-14">
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Frequently Asked Questions</h1>
    <p class="text-sm text-gray-400">Everything you need to know about our products and services.</p>
  </div>

  <div class="space-y-2">
    ${[
      { q: 'What payment methods do you accept?', a: 'We accept all major credit and debit cards including Visa, Mastercard, and American Express through our secure Stripe payment gateway. Apple Pay and Google Pay are also supported.' },
      { q: 'How do I receive my products?', a: 'All products are delivered digitally. After payment, you receive immediate access to download your purchased items. A confirmation email with download links is sent within minutes.' },
      { q: 'Can I get a refund?', a: 'Due to the digital nature of our products, all sales are final. If you experience technical issues or the product does not match its description, contact our support team within 48 hours.' },
      { q: 'Is my payment secure?', a: 'All payment processing is handled by Stripe, PCI-DSS Level 1 certified. Your card details are encrypted with 256-bit SSL and never stored on our servers.' },
      { q: 'Are the wellness guides evidence-based?', a: 'Yes. Our products are created in collaboration with certified wellness professionals and are based on established research in health, nutrition, and behavioral psychology.' },
      { q: 'Do you offer bundle discounts?', a: 'Yes! Our bundles offer significant savings compared to individual purchases. Check our Products page for available bundle options.' },
      { q: 'How often are new products released?', a: 'We release new products and major updates monthly. Subscribe to our newsletter to get notified about releases and early-bird discounts.' },
      { q: 'Do products include updates?', a: 'Yes, all purchases include lifetime access to future updates at no additional cost.' },
      { q: 'What file formats are included?', a: 'Products typically include PDF, XLSX, and printable formats. Specific formats are listed on each product page.' },
      { q: 'How do I contact support?', a: 'Visit our <a href="/contact" class="text-primary hover:underline">contact page</a> or email ${store.contact_email || "hello@" + store.domain}. We respond within 24 hours on business days.' }
    ].map(item => '<details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">' +
      '<summary class="flex items-center justify-between px-4 py-3.5 cursor-pointer list-none font-semibold text-gray-900 text-sm hover:text-primary transition">' +
        '<span class="pr-4">' + item.q + '</span>' +
        '<svg class="w-4 h-4 text-gray-400 group-open:rotate-180 transition-transform shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>' +
      '</summary>' +
      '<div class="px-4 pb-3.5 text-gray-500 text-xs leading-relaxed border-t border-gray-100 pt-3">' + item.a + '</div>' +
    '</details>').join('')}
  </div>

  <div class="bg-gray-50 rounded-xl p-6 text-center mt-10">
    <h3 class="text-base font-bold text-gray-900 mb-2">Still have questions?</h3>
    <p class="text-xs text-gray-400 mb-4">Our support team is happy to help.</p>
    <a href="/contact" class="btn-primary inline-block text-white px-6 py-2.5 rounded-lg font-semibold text-sm transition hover:shadow-lg">Contact Support</a>
  </div>
</div>
`, store }) %>
