      </form>
    </div>
  </div>
</section>

<section class="bg-gray-950 py-12">
  <div class="max-w-xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="text-lg sm:text-xl font-bold text-white mb-2">Stay updated</h2>
    <p class="text-xs text-gray-500 mb-6">New wellness products and exclusive early-bird discounts.</p>
    <form class="flex gap-2 max-w-sm mx-auto" onsubmit="event.preventDefault(); this.querySelector('button').textContent='Done!'; this.querySelector('button').disabled=true; this.querySelector('input').disabled=true;">
      <input type="email" placeholder="you@email.com" required class="flex-1 bg-white/10 border border-white/10 text-white placeholder-gray-600 px-3.5 py-2.5 rounded-lg text-sm focus:outline-none focus:border-white/25">
      <button type="submit" class="btn-primary text-white px-5 py-2.5 rounded-lg font-semibold text-sm shrink-0 transition">Subscribe</button>
