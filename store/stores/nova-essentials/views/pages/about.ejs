<% const pageTitle = 'About'; const extraHead = ''; %>
<%- include('../layouts/store', { body: `
<div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 md:py-14">
  <div class="mb-10">
    <span class="inline-block text-[10px] font-semibold text-primary uppercase tracking-wider mb-2">Our Story</span>
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">About ${store.name}</h1>
    <p class="text-sm text-gray-500 leading-relaxed">Helping people build healthier habits with practical, beautifully designed wellness tools.</p>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-6 mb-8">
    <p class="text-sm text-gray-600 leading-relaxed">${store.about_text || 'We believe that small, consistent actions lead to lasting change. Our team of wellness professionals and designers creates digital tools that make healthy living simple, approachable, and enjoyable. Every product is tested with real people before it reaches our store.'}</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
    <div class="bg-white rounded-xl border border-gray-200 p-5">
      <div class="w-9 h-9 rounded-lg bg-teal-50 flex items-center justify-center mb-3">
        <svg class="w-4.5 h-4.5 text-teal-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
      </div>
      <h3 class="font-semibold text-gray-900 text-sm mb-1.5">Our Mission</h3>
      <p class="text-xs text-gray-500 leading-relaxed">To make wellness accessible through practical digital tools that fit into your daily life.</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-5">
      <div class="w-9 h-9 rounded-lg bg-amber-50 flex items-center justify-center mb-3">
        <svg class="w-4.5 h-4.5 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/></svg>
      </div>
      <h3 class="font-semibold text-gray-900 text-sm mb-1.5">Our Vision</h3>
      <p class="text-xs text-gray-500 leading-relaxed">A world where everyone has the tools to live a more balanced, intentional life.</p>
    </div>
  </div>

  <h2 class="text-lg font-bold text-gray-900 mb-4">What sets us apart</h2>
  <div class="space-y-2 mb-10">
    ${[
      { title: 'Expert-designed', desc: 'Created by certified wellness professionals.' },
      { title: 'Instant access', desc: 'Download and start using within seconds.' },
      { title: 'Dedicated support', desc: 'Real humans answering your questions within 24 hours.' },
      { title: 'Science-backed', desc: 'Evidence-based approaches to habit building and wellness.' },
      { title: 'Regular updates', desc: 'Continuously improved based on customer feedback.' },
      { title: 'Fair pricing', desc: 'Professional quality at accessible prices. No subscriptions.' }
    ].map(item => '<div class="flex items-start gap-2.5 p-3 bg-gray-50 rounded-lg">' +
      '<svg class="w-4 h-4 text-emerald-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>' +
      '<div><p class="font-semibold text-gray-900 text-xs">' + item.title + '</p><p class="text-[11px] text-gray-400">' + item.desc + '</p></div>' +
    '</div>').join('')}
  </div>

  <div class="bg-gray-50 rounded-xl p-6 text-center">
    <h3 class="text-base font-bold text-gray-900 mb-2">Have questions?</h3>
    <p class="text-xs text-gray-400 mb-4">We would love to hear from you.</p>
    <a href="/contact" class="btn-primary inline-block text-white px-6 py-2.5 rounded-lg font-semibold text-sm transition hover:shadow-lg">Contact Us</a>
  </div>
</div>
`, store }) %>
