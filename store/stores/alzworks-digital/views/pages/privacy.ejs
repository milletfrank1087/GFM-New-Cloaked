<% const pageTitle = 'Privacy Policy'; const extraHead = ''; %>
<%- include('../layouts/store', { body: `
<div class="max-w-2xl mx-auto px-4 sm:px-6 py-10 md:py-14">
  <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-1">Privacy Policy</h1>
  <p class="text-xs text-gray-400 mb-8">Last updated: ${new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>

  <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-6 text-gray-500 text-xs leading-relaxed">
    <p>${store.name} (operated by ITG-ALZWORKS, Vinkovci, Croatia) respects your privacy. This policy explains what we collect, why, and how it is kept safe. We comply with the EU GDPR.</p>

    <div>
      <h2 class="text-sm font-bold text-gray-900 mb-2">Information we collect</h2>
      <ul class="list-disc pl-4 space-y-1">
        <li><strong class="text-gray-700">Purchase details:</strong> Name, email and billing address you provide at checkout</li>
        <li><strong class="text-gray-700">Payment data:</strong> Handled by Stripe. We never see or store full card numbers</li>
        <li><strong class="text-gray-700">Usage data:</strong> Anonymous pageview and session stats for site improvement</li>
        <li><strong class="text-gray-700">Support communication:</strong> Anything you share when contacting the studio</li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-bold text-gray-900 mb-2">How we use your information</h2>
      <ul class="list-disc pl-4 space-y-1">
        <li>To process purchases and deliver your digital files</li>
        <li>To send order confirmations and access links</li>
        <li>To respond to support requests</li>
        <li>To improve products and the buying experience</li>
        <li>To meet EU legal and tax obligations</li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-bold text-gray-900 mb-2">Data security</h2>
      <p>Industry-standard protections are in place. Payments are encrypted via 256-bit TLS through Stripe (PCI-DSS Level 1 certified). Order data is stored in encrypted databases hosted in the EU.</p>
    </div>

    <div>
      <h2 class="text-sm font-bold text-gray-900 mb-2">Third-party services</h2>
      <ul class="list-disc pl-4 space-y-1">
        <li><strong class="text-gray-700">Stripe:</strong> Payment processing (<a href="https://stripe.com/privacy" class="text-primary hover:underline" target="_blank" rel="noopener">Stripe Privacy Policy</a>)</li>
        <li><strong class="text-gray-700">Analytics:</strong> Privacy-friendly analytics for site improvement only</li>
      </ul>
      <p class="mt-2">Your personal information is never sold or rented to anyone.</p>
    </div>

    <div>
      <h2 class="text-sm font-bold text-gray-900 mb-2">Cookies</h2>
      <p>Only essential cookies are used \u2014 for checkout sessions and basic site functionality. No advertising or third-party tracking cookies are set without your consent.</p>
    </div>

    <div>
      <h2 class="text-sm font-bold text-gray-900 mb-2">Your rights (GDPR)</h2>
      <p class="mb-1.5">As an EU-based entity we honour the full set of GDPR rights: access, rectification, erasure, restriction, portability and objection. Email the studio to exercise any of these rights and we will respond within thirty days.</p>
    </div>

    <div>
      <h2 class="text-sm font-bold text-gray-900 mb-2">Contact</h2>
      <p>Privacy questions? Email <a href="mailto:${store.contact_email || 'support@' + store.domain}" class="text-primary hover:underline">${store.contact_email || 'support@' + store.domain}</a>.</p>
    </div>
  </div>
</div>
`, store }) %>
