<% const pageTitle = 'FAQ'; const extraHead = ''; %>
<%- include('../layouts/store', { body: `
<div class="max-w-2xl mx-auto px-4 sm:px-6 py-10 md:py-14">
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Frequently asked questions</h1>
    <p class="text-sm text-gray-400">Short answers to the questions buyers ask the studio most often.</p>
  </div>

  <div class="space-y-2">
    ${[
      { q: 'Which payment methods can I use?', a: 'Visa, Mastercard, Amex, Apple Pay and Google Pay are all available. Payments are processed by Stripe over a 256-bit TLS connection. We never see the card number itself.' },
      { q: 'Will I see Alzworks on my statement?', a: 'Your statement will read "ITG-ALZWORKS", the registered legal name of the studio. Same business, slightly more formal label.' },
      { q: 'How do I receive my files?', a: 'A library link appears immediately on the confirmation screen. A copy is also sent to your email within a few minutes of payment.' },
      { q: 'What is the refund policy?', a: 'Because files unlock instantly, all sales are final. If a file will not open, email support within forty-eight hours and we will either send a working copy or refund the order.' },
      { q: 'Are the payments secure?', a: 'Yes. Stripe handles processing end-to-end and is PCI-DSS Level 1 certified. No card details touch our servers.' },
      { q: 'Can I use the assets in paid client work?', a: 'Yes. Every purchase includes a full commercial licence covering personal projects and client deliverables. The only restriction is reselling or redistributing the source files.' },
      { q: 'Do you offer team or bulk pricing?', a: 'For teams of five seats or more we will quote a custom licence. Email support@alzworks.shop with your team size and the products you are interested in.' },
      { q: 'How often do you release new products?', a: 'A handful of new products and meaningful updates each month. Subscribe to the newsletter on the home page to get a heads-up.' },
      { q: 'Are future updates included?', a: 'Yes. When we improve a product you already own, the new version appears in your library automatically at no extra cost.' },
      { q: 'What file formats are included?', a: 'Most products ship as editable Figma, Notion, Sheets, Docs, PPTX or PDF. The exact formats are listed on each individual product page.' },
      { q: 'Where is the studio registered?', a: 'Alzworks Digital is operated by ITG-ALZWORKS, a Croatia-registered entity based in Vinkovci. The team itself is fully remote across the EU.' },
      { q: 'How do I reach support?', a: 'Email support@alzworks.shop or use the form on the <a href="/contact" class="text-primary hover:underline">contact page</a>. We reply within one business day.' }
    ].map(item => '<details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">' +
      '<summary class="flex items-center justify-between px-4 py-3.5 cursor-pointer list-none font-semibold text-gray-900 text-sm hover:text-primary transition">' +
        '<span class="pr-4">' + item.q + '</span>' +
        '<svg class="w-4 h-4 text-gray-400 group-open:rotate-180 transition-transform shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>' +
      '</summary>' +
      '<div class="px-4 pb-3.5 text-gray-500 text-xs leading-relaxed border-t border-gray-100 pt-3">' + item.a + '</div>' +
    '</details>').join('')}
  </div>

  <div class="bg-gray-50 rounded-xl p-6 text-center mt-10">
    <h3 class="text-base font-bold text-gray-900 mb-2">Still stuck?</h3>
    <p class="text-xs text-gray-400 mb-4">The studio is happy to help directly.</p>
    <a href="/contact" class="btn-primary inline-block text-white px-6 py-2.5 rounded-lg font-semibold text-sm transition hover:shadow-lg">Contact support</a>
  </div>
</div>
`, store }) %>
