<% const pageTitle = 'Contact'; const extraHead = ''; %>
<%- include('../layouts/store', { body: `
<div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 md:py-14">
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Talk to the studio</h1>
    <p class="text-sm text-gray-400">Product questions, licence requests, partnership ideas. We answer within one business day.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8">
    <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-3">
      <div class="w-9 h-9 rounded-lg bg-indigo-50 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
      </div>
      <div class="min-w-0">
        <p class="text-xs font-semibold text-gray-900">Email</p>
        <p class="text-[11px] text-gray-400 truncate">${store.contact_email || 'support@' + store.domain}</p>
      </div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-3">
      <div class="w-9 h-9 rounded-lg bg-emerald-50 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-900">Response</p>
        <p class="text-[11px] text-gray-400">Within 24 hours</p>
      </div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-3">
      <div class="w-9 h-9 rounded-lg bg-violet-50 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4 text-violet-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-900">Registered</p>
        <p class="text-[11px] text-gray-400">Vinkovci, Croatia (EU)</p>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <form class="space-y-4" onsubmit="event.preventDefault(); this.querySelector('button').textContent='Message Sent!'; this.querySelector('button').disabled=true;">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">First name</label>
          <input type="text" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm" placeholder="Mara" required>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Last name</label>
          <input type="text" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm" placeholder="Vidi\u0107" required>
        </div>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Email</label>
        <input type="email" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm" placeholder="mara@brand.co" required>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Subject</label>
        <select class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-700">
          <option>Product question</option>
          <option>Order or licence support</option>
          <option>Technical issue</option>
          <option>Team or bulk pricing</option>
          <option>Other</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Message</label>
        <textarea rows="4" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm resize-none" placeholder="What can the studio help with?" required></textarea>
      </div>
      <button type="submit" class="btn-primary w-full text-white py-2.5 rounded-lg font-semibold text-sm transition hover:shadow-lg">Send message</button>
    </form>
  </div>

  <div class="mt-6 text-center">
    <p class="text-xs text-gray-400">Looking for a quick answer? Check the <a href="/faq" class="text-primary hover:underline">FAQ</a>.</p>
  </div>
</div>
`, store }) %>
