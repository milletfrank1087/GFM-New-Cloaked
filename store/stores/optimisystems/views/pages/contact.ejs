<% const pageTitle = 'Talk to us'; const extraHead = ''; %>
<%- include('../layouts/store', { body: `
<div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 md:py-14">
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-2">Talk to us</h1>
    <p class="text-sm text-neutral-400">Tell us what you are building. We respond within one working day.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8">
    <div class="bg-white opt-card rounded-xl p-4 flex items-center gap-3">
      <div class="w-9 h-9 rounded-lg bg-emerald-50 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15A2.25 2.25 0 011.5 17.25V6.75M21 6.75A2.25 2.25 0 0018.75 4.5h-15A2.25 2.25 0 001.5 6.75M21 6.75l-9 6.75-9-6.75"/></svg>
      </div>
      <div class="min-w-0">
        <p class="text-xs font-semibold text-neutral-900">Email</p>
        <p class="text-[11px] text-neutral-400 truncate">${store.contact_email || 'support@' + store.domain}</p>
      </div>
    </div>
    <div class="bg-white opt-card rounded-xl p-4 flex items-center gap-3">
      <div class="w-9 h-9 rounded-lg bg-sky-50 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4 text-sky-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <div>
        <p class="text-xs font-semibold text-neutral-900">Reply window</p>
        <p class="text-[11px] text-neutral-400">Within one working day</p>
      </div>
    </div>
    <div class="bg-white opt-card rounded-xl p-4 flex items-center gap-3">
      <div class="w-9 h-9 rounded-lg bg-amber-50 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12a9 9 0 1118 0 9 9 0 01-18 0zM3 12h18M12 3a13.5 13.5 0 010 18M12 3a13.5 13.5 0 000 18"/></svg>
      </div>
      <div>
        <p class="text-xs font-semibold text-neutral-900">Focus</p>
        <p class="text-[11px] text-neutral-400">EU + UK installer brands</p>
      </div>
    </div>
  </div>

  <div class="bg-white opt-card rounded-xl p-6">
    <form class="space-y-4" onsubmit="event.preventDefault(); this.querySelector('button').textContent='Message sent — we will be in touch'; this.querySelector('button').disabled=true;">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-neutral-600 mb-1">First name</label>
          <input type="text" class="w-full border border-neutral-200 rounded-lg px-3 py-2.5 text-sm" placeholder="Helena" required>
        </div>
        <div>
          <label class="block text-xs font-medium text-neutral-600 mb-1">Last name</label>
          <input type="text" class="w-full border border-neutral-200 rounded-lg px-3 py-2.5 text-sm" placeholder="Renz" required>
        </div>
      </div>
      <div>
        <label class="block text-xs font-medium text-neutral-600 mb-1">Work email</label>
        <input type="email" class="w-full border border-neutral-200 rounded-lg px-3 py-2.5 text-sm" placeholder="helena@your-installer-brand.com" required>
      </div>
      <div>
        <label class="block text-xs font-medium text-neutral-600 mb-1">What are you trying to solve?</label>
        <select class="w-full border border-neutral-200 rounded-lg px-3 py-2.5 text-sm text-neutral-700">
          <option>I want a specific toolkit recommendation</option>
          <option>I want a managed lead generation engagement</option>
          <option>I have a billing or download question</option>
          <option>I want to partner / something else</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-neutral-600 mb-1">Brief context</label>
        <textarea rows="4" class="w-full border border-neutral-200 rounded-lg px-3 py-2.5 text-sm resize-none" placeholder="A few sentences about your market, current monthly install volume and what you have tried so far." required></textarea>
      </div>
      <button type="submit" class="btn-primary w-full text-white py-2.5 rounded-lg font-semibold text-sm transition hover:shadow-lg">Send message</button>
    </form>
  </div>

  <div class="mt-6 text-center">
    <p class="text-xs text-neutral-400">Looking for a quick answer? Most questions are covered in our <a href="/faq" class="text-primary hover:underline">answers</a> section.</p>
  </div>
</div>
`, store }) %>
