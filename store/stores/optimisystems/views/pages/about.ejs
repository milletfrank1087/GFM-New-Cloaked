<% const pageTitle = 'Studio'; const extraHead = ''; %>
<%- include('../layouts/store', { body: `
<div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 md:py-14">
  <div class="mb-10">
    <span class="inline-block text-[10px] font-semibold text-primary uppercase tracking-wider mb-2">About the studio</span>
    <h1 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-3">We sell lead generation to installer brands &mdash; and the systems behind it</h1>
    <p class="text-sm text-neutral-500 leading-relaxed">${store.name} is a lead generation studio focused on residential and small-commercial solar installers across Europe and the UK. We run paid acquisition for a handful of installer brands every quarter, and we package the systems we build for them into off-the-shelf toolkits.</p>
  </div>

  <div class="bg-white opt-card rounded-xl p-6 mb-8">
    <p class="text-sm text-neutral-600 leading-relaxed mb-4">We started in 2015 running Facebook Lead Ads for a single roofing-and-solar installer in Manchester. Eleven years and a few hundred installer brands later, the playbook has not changed all that much &mdash; the offers, scripts and CRM stages still revolve around three questions a homeowner is silently asking before signing.</p>
    <p class="text-sm text-neutral-600 leading-relaxed">We sell two things. The first is a productised lead generation engagement for installer brands &mdash; the studio team handles paid media, creative and reporting on retainer. The second is the underlying toolkit, packaged so any installer marketing team can buy it and run it in-house. Both come from the same operations.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
    <div class="bg-white opt-card rounded-xl p-5">
      <div class="w-9 h-9 rounded-lg bg-emerald-50 flex items-center justify-center mb-3">
        <svg class="w-4.5 h-4.5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12h3l2-6 4 14 3-8 2 4h4"/></svg>
      </div>
      <h3 class="font-semibold text-neutral-900 text-sm mb-1.5">What we are</h3>
      <p class="text-xs text-neutral-500 leading-relaxed">A small, opinionated lead generation studio that only takes installer-side clients. We do not run e-commerce, we do not run B2B SaaS, and we do not promise things we have not shipped before.</p>
    </div>
    <div class="bg-white opt-card rounded-xl p-5">
      <div class="w-9 h-9 rounded-lg bg-sky-50 flex items-center justify-center mb-3">
        <svg class="w-4.5 h-4.5 text-sky-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <h3 class="font-semibold text-neutral-900 text-sm mb-1.5">What we sell</h3>
      <p class="text-xs text-neutral-500 leading-relaxed">Productised lead generation services and the toolkits behind them: ad creative vaults, sales scripts, CRM templates and quarterly market reports. Everything is digital download.</p>
    </div>
  </div>

  <h2 class="text-lg font-bold text-neutral-900 mb-4">How a typical engagement looks</h2>
  <div class="space-y-2 mb-10">
    ${[
      { title: 'Diagnostic week', desc: 'We audit current ad accounts, CRM hygiene, follow-up speed and offer-market fit. Output is a short brief, not a deck.' },
      { title: 'Pipeline rebuild', desc: 'We rebuild the CRM stages, sales scripts and reporting view so leads are tracked the same way every rep handles them.' },
      { title: 'Creative production', desc: 'We ship three to five tested ad concepts per month, including copy, design and landing pages tuned to installer offers.' },
      { title: 'Quarterly review', desc: 'Every quarter we cut what is not working, share an updated market briefing and re-set targets with leadership.' }
    ].map(item => '<div class="flex items-start gap-2.5 p-3 bg-neutral-50 rounded-lg">' +
      '<svg class="w-4 h-4 text-primary mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>' +
      '<div><p class="font-semibold text-neutral-900 text-xs">' + item.title + '</p><p class="text-[11px] text-neutral-400">' + item.desc + '</p></div>' +
    '</div>').join('')}
  </div>

  <div class="bg-neutral-50 rounded-xl p-6 text-center">
    <h3 class="text-base font-bold text-neutral-900 mb-2">Want to see the toolkits before you commit?</h3>
    <p class="text-xs text-neutral-400 mb-4">Most installer brands start with one or two downloadable assets before booking a retainer.</p>
    <a href="/products" class="btn-primary inline-block text-white px-6 py-2.5 rounded-lg font-semibold text-sm transition hover:shadow-lg">Browse the toolkit catalogue</a>
  </div>
</div>
`, store }) %>
