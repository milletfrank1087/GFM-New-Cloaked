<% const pageTitle = 'Cart'; const extraHead = ''; %>
<%- include('../layouts/store', { body: `
<div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 md:py-14">
  <div id="cart-empty" style="display:none" class="text-center py-12">
    <div class="w-16 h-16 rounded-full bg-neutral-100 flex items-center justify-center mx-auto mb-5">
      <svg class="w-7 h-7 text-neutral-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6h16.5l-1.5 11.25A2.25 2.25 0 0116.5 19.5h-9a2.25 2.25 0 01-2.25-2.25L3.75 6zM7.5 6V4.5A3.75 3.75 0 0111.25 .75h1.5A3.75 3.75 0 0116.5 4.5V6"/>
      </svg>
    </div>
    <h1 class="text-xl font-bold text-neutral-900 mb-2">Your cart is empty</h1>
    <p class="text-sm text-neutral-400 mb-6 max-w-xs mx-auto">Browse our installer-grade toolkits to find something that fits your next campaign.</p>
    <a href="/products" class="btn-primary inline-flex items-center gap-2 text-white px-6 py-2.5 rounded-xl font-semibold text-sm transition hover:shadow-lg">Browse toolkits</a>
  </div>

  <div id="cart-filled" style="display:none">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-neutral-900">Your cart</h1>
      <span id="cart-item-count" class="text-xs text-neutral-400"></span>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <div class="lg:col-span-8">
        <div id="cart-items" class="bg-white opt-card rounded-2xl p-4 sm:p-5 mb-3"></div>
        <a href="/products" class="inline-flex items-center gap-1.5 text-xs font-semibold text-neutral-500 hover:text-primary transition">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
          Continue shopping
        </a>
      </div>
      <div class="lg:col-span-4 lg:sticky lg:top-24">
        <div class="bg-white opt-card rounded-2xl p-5">
          <h2 class="text-sm font-bold text-neutral-900 mb-4">Order summary</h2>
          <div class="flex items-center justify-between mb-2">
            <span class="text-sm text-neutral-500">Subtotal</span>
            <span id="cart-total" class="text-lg font-bold text-neutral-900"></span>
          </div>
          <p class="text-[11px] text-neutral-400 mb-4">VAT calculated at checkout where applicable.</p>
          <a href="/checkout?store=1" class="btn-primary w-full flex items-center justify-center gap-2 text-white py-3 rounded-xl font-semibold text-sm transition hover:shadow-lg">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            Proceed to checkout
          </a>
          <button onclick="Cart.clear(); Cart.renderCartPage();" class="w-full text-center text-xs text-neutral-400 hover:text-rose-500 mt-2.5 transition">Clear cart</button>

          <div class="border-t border-neutral-100 mt-4 pt-4 space-y-2.5">
            ${[
              ['M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3', 'Instant download after payment'],
              ['M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z', 'Stripe-encrypted, PCI-DSS Level 1'],
              ['M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z', '14-day fix-or-refund guarantee']
            ].map(b => '<div class="flex items-center gap-2 text-[11px] text-neutral-500"><svg class="w-3.5 h-3.5 text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="' + b[0] + '"/></svg><span>' + b[1] + '</span></div>').join('')}
          </div>
          <div class="flex items-center gap-1.5 mt-4 pt-4 border-t border-neutral-100">
            <svg class="h-5 rounded" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#1A1F71"/><path d="M15.6 16.3l2.4-9h2.9l-2.4 9h-2.9zm11.8-9l-2.7 6.2-.3-1.5-1-5.1s-.1-.6-.8-.6h-4.1l-.1.3s.8.2 1.8.5l2 7.2h3l4.6-7h-2.4zm-16.2 0h-4.5l-.1.3s.9.2 1.7.5c1 .4 1.1.6 1.3 1.3l2.3 7h3l4.7-9.1h-3l-3 6.2-1.2-5.3s-.2-.9-.9-.9z" fill="white"/></svg>
            <svg class="h-5 rounded" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#0b0b0b"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B"/><path d="M19 7.3a7 7 0 010 9.4 7 7 0 000-9.4z" fill="#FF5F00"/></svg>
            <span class="text-[10px] text-neutral-400 ml-1">+ Apple Pay &amp; Google Pay</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`, store }) %>
