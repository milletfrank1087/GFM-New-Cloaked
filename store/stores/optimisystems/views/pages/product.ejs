<% const pageTitle = product.name; const extraHead = ''; %>
<%- include('../layouts/store', { body: `
<div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-12">
  <nav class="flex items-center gap-1.5 text-xs text-neutral-400 mb-6">
    <a href="/" class="hover:text-neutral-600 transition">Home</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
    <a href="/products" class="hover:text-neutral-600 transition">Toolkits</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
    <span class="text-neutral-600">${product.name}</span>
  </nav>

  <div class="max-w-3xl">
    <span class="inline-block text-[10px] font-semibold text-neutral-400 uppercase tracking-wider mb-2">${product.category || 'Toolkit'}</span>
    <h1 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-3">${product.name}</h1>
    <div class="flex items-center gap-2.5 mb-5">
      <span class="text-2xl font-bold text-primary">&euro;${product.price?.toFixed(2) || '0.00'}</span>
      <span class="text-sm text-neutral-300 line-through">&euro;${((product.price || 0) * 1.35).toFixed(2)}</span>
      <span class="bg-emerald-50 text-emerald-700 text-[10px] font-semibold px-2 py-0.5 rounded-full">Studio price</span>
    </div>
    <p class="text-sm text-neutral-500 leading-relaxed mb-6">${product.description || 'A production-grade installer marketing asset, written and field-tested by our studio team.'}</p>

    <div class="bg-neutral-50 rounded-xl p-4 space-y-2.5 mb-6">
      ${[
        { text: 'Instant download after payment' },
        { text: 'Commercial licence for installer brands and their advisers' },
        { text: 'Updates included for the lifetime of the toolkit' },
        { text: 'Email support during business hours (one working day)' },
      ].map(item => '<div class="flex items-center gap-2 text-xs text-neutral-600">' +
        '<svg class="w-3.5 h-3.5 text-primary shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>' +
        '<span>' + item.text + '</span>' +
      '</div>').join('')}
    </div>

    <button onclick="Cart.add('${product.name}', '${product.slug || ''}', ${product.price || 0})" class="btn-primary w-full sm:w-auto text-white px-8 py-3 rounded-xl font-semibold text-sm transition-all hover:shadow-lg hover:shadow-primary/20 flex items-center justify-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.4c.5 0 .95.34 1.08.83l.39 1.44M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.2c1.1-2.3 2.1-4.7 2.9-7.1a60 60 0 00-16.5-1.9M7.5 14.25L5.1 5.27M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/></svg>
      Add to cart &mdash; &euro;${product.price?.toFixed(2) || '0.00'}
    </button>
  </div>

  <div class="mt-12">
    <h2 class="text-lg font-bold text-neutral-900 mb-4">What installer teams say</h2>
    <div class="space-y-3">
      ${[
        { name: 'Markus B.', stars: 5, text: 'Used this on a regional installer launch in Bavaria. The ad copy alone replaced two months of agency work.' },
        { name: 'Sofia M.', stars: 4, text: 'Tight, well-structured, and clearly written by someone who has worked installer accounts before. Worth the price.' },
        { name: 'Daniel V.', stars: 5, text: 'We folded this into our onboarding playbook for new account managers. It is now part of every new client kickoff.' },
      ].map(r =>
        '<div class="bg-neutral-50 rounded-xl p-4">' +
          '<div class="flex items-center gap-2 mb-1.5">' +
            '<span class="font-semibold text-xs text-neutral-900">' + r.name + '</span>' +
            '<span class="text-amber-400 text-[10px]">' + '★'.repeat(r.stars) + '☆'.repeat(5 - r.stars) + '</span>' +
          '</div>' +
          '<p class="text-xs text-neutral-500 leading-relaxed">' + r.text + '</p>' +
        '</div>'
      ).join('')}
    </div>
  </div>

  ${related.length > 0 ? '<div class="mt-12"><h2 class="text-lg font-bold text-neutral-900 mb-4">Other toolkits installers buy alongside this</h2><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">' +
    related.map((r, i) => {
      const accents = ['bg-emerald-50 text-emerald-600','bg-sky-50 text-sky-600','bg-amber-50 text-amber-600','bg-violet-50 text-violet-600'];
      return '<a href="/products/' + (r.slug || '') + '" class="group flex items-center gap-3 bg-white opt-card rounded-xl p-3.5 hover:shadow-sm transition">' +
        '<div class="w-9 h-9 rounded-lg ' + accents[i % 4] + ' flex items-center justify-center shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4"/></svg></div>' +
        '<div class="flex-1 min-w-0"><h3 class="font-semibold text-neutral-900 text-xs truncate group-hover:text-primary transition">' + r.name + '</h3><span class="text-xs font-bold text-neutral-900">\u20ac' + (r.price?.toFixed(2) || '0.00') + '</span></div>' +
      '</a>';
    }).join('') +
  '</div></div>' : ''}
</div>
`, store, product, related }) %>
