<% const pageTitle = product.name; const extraHead = ''; const sym = store.currencySymbol || '\u20ac'; %>
<%- include('../layouts/store', { body: `
<section class="border-b border-stone-100 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-12">
    <nav class="flex items-center gap-1.5 text-xs text-stone-400 mb-6 opt-reveal">
      <a href="/" class="hover:text-stone-600 transition">Home</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      <a href="/products" class="hover:text-stone-600 transition">All products</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      <span class="text-stone-600 truncate max-w-[40vw]">${product.name}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-7 opt-reveal">
        <div class="relative aspect-[5/4] sm:aspect-[16/10] rounded-3xl overflow-hidden opt-card bg-gradient-to-br from-amber-500/15 via-primary/10 to-emerald-500/5 flex items-center justify-center mb-6">
          <div class="opt-grid-bg absolute inset-0 opacity-40"></div>
          <div class="relative w-24 h-24 rounded-3xl bg-white/85 opt-glass flex items-center justify-center shadow-lg">
            <svg class="w-12 h-12 text-primary" fill="none" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5-3v12a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2h3l2-2h4l2 2h3a2 2 0 012 2z"/></svg>
          </div>
          <span class="absolute top-4 left-4 text-[10px] font-semibold text-stone-700 bg-white/85 opt-glass px-2.5 py-1 rounded-full">${product.category || 'Toolkit'}</span>
          <span class="absolute top-4 right-4 inline-flex items-center gap-1 text-[10px] font-semibold text-primary bg-white/85 opt-glass px-2.5 py-1 rounded-full">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
            Digital download
          </span>
        </div>

        <div class="opt-reveal" data-delay="60">
          <h1 class="text-2xl sm:text-3xl font-bold text-stone-900 mb-3">${product.name}</h1>
          <p class="text-sm sm:text-base text-stone-500 leading-relaxed mb-6">${product.description || 'A production-grade installer marketing asset, written and field-tested by our studio team.'}</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
          ${[
            { t: 'Built for installer teams', d: 'Written specifically for residential and commercial solar brands in the EU and UK.' },
            { t: 'Field-tested, not theory', d: 'Every asset comes from live campaigns we have run for installer clients.' },
            { t: 'Editable source files', d: 'Spreadsheets, docs and design files you can adapt to your own brand and process.' },
            { t: 'Lifetime updates', d: 'When we revise a toolkit, you get the new version at no extra cost.' }
          ].map((f, i) => '<div class="opt-reveal opt-card bg-white rounded-2xl p-4" data-delay="' + (i * 60) + '">' +
            '<div class="flex items-center gap-2 mb-1"><svg class="w-4 h-4 text-primary shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>' +
            '<h3 class="font-semibold text-stone-900 text-xs">' + f.t + '</h3></div>' +
            '<p class="text-[11px] text-stone-500 leading-relaxed pl-6">' + f.d + '</p>' +
          '</div>').join('')}
        </div>

        <div class="opt-card bg-primary-50/50 rounded-2xl p-5 mb-2 opt-reveal">
          <h2 class="text-sm font-bold text-stone-900 mb-3">What is inside</h2>
          <div class="space-y-2.5">
            ${[
              'Instant download after payment, delivered to your email',
              'Commercial licence for installer brands and their advisers',
              'Updates included for the lifetime of the toolkit',
              'Email support during business hours (one working day)'
            ].map(item => '<div class="flex items-center gap-2 text-xs text-stone-600">' +
              '<svg class="w-4 h-4 text-primary shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>' +
              '<span>' + item + '</span></div>').join('')}
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 lg:sticky lg:top-24 opt-reveal" data-delay="120">
        <div class="opt-card bg-white rounded-3xl p-6 shadow-lg shadow-stone-900/5">
          <div class="flex items-end gap-2.5 mb-1">
            <span class="text-3xl font-extrabold text-stone-900">${sym}${product.price?.toFixed(2) || '0.00'}</span>
            <span class="text-sm text-stone-300 line-through mb-1">${sym}${((product.price || 0) * 1.35).toFixed(2)}</span>
          </div>
          <div class="flex items-center gap-2 mb-5">
            <span class="bg-primary-50 text-primary text-[10px] font-semibold px-2 py-0.5 rounded-full">Save 26%</span>
            <span class="text-[11px] text-stone-400">One-time payment &middot; VAT may apply</span>
          </div>

          <button onclick="Cart.add('${product.name}', '${product.slug || ''}', ${product.price || 0})" class="btn-primary w-full text-white py-3.5 rounded-full font-semibold text-sm transition-all flex items-center justify-center gap-2 mb-2.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.4c.5 0 .95.34 1.08.83l.39 1.44M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.2c1.1-2.3 2.1-4.7 2.9-7.1a60 60 0 00-16.5-1.9M7.5 14.25L5.1 5.27M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/></svg>
            Add to cart
          </button>
          <a href="/cart" class="block w-full text-center text-xs font-semibold text-stone-500 hover:text-stone-900 transition py-2">Go to cart &rarr;</a>

          <div class="border-t border-stone-100 mt-4 pt-4 space-y-3">
            ${[
              { t: 'Instant access', d: 'Files delivered the moment payment clears' },
              { t: 'Secure checkout', d: 'Stripe-encrypted, PCI-DSS Level 1' },
              { t: 'Issue-resolution guarantee', d: '14-day fix-or-refund on any download fault' }
            ].map(b => '<div class="flex items-start gap-2.5">' +
              '<div class="w-7 h-7 rounded-lg bg-primary-50 flex items-center justify-center shrink-0"><svg class="w-3.5 h-3.5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>' +
              '<div><p class="text-xs font-semibold text-stone-900">' + b.t + '</p><p class="text-[11px] text-stone-400">' + b.d + '</p></div>' +
            '</div>').join('')}
          </div>

          <div class="flex items-center justify-center gap-1.5 mt-5 pt-4 border-t border-stone-100">
            <svg class="h-5 rounded" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#1A1F71"/><path d="M15.6 16.3l2.4-9h2.9l-2.4 9h-2.9zm11.8-9l-2.7 6.2-.3-1.5-1-5.1s-.1-.6-.8-.6h-4.1l-.1.3s.8.2 1.8.5l2 7.2h3l4.6-7h-2.4zm-16.2 0h-4.5l-.1.3s.9.2 1.7.5c1 .4 1.1.6 1.3 1.3l2.3 7h3l4.7-9.1h-3l-3 6.2-1.2-5.3s-.2-.9-.9-.9z" fill="white"/></svg>
            <svg class="h-5 rounded" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#0b0b0b"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B"/><path d="M19 7.3a7 7 0 010 9.4 7 7 0 000-9.4z" fill="#FF5F00"/></svg>
            <span class="text-[10px] text-stone-400 ml-1">+ Apple Pay &amp; Google Pay</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
  <div class="opt-reveal">
    <h2 class="text-lg font-bold text-stone-900 mb-1">What installer teams say</h2>
    <p class="text-sm text-stone-400 mb-5">Verified buyers using this toolkit in live campaigns.</p>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
    ${[
      { name: 'Markus B.', role: 'Installer, DE', stars: 5, text: 'Used this on a regional installer launch in Bavaria. The ad copy alone replaced two months of agency work.' },
      { name: 'Sofia M.', role: 'Marketing lead, ES', stars: 4, text: 'Tight, well-structured, and clearly written by someone who has worked installer accounts before. Worth the price.' },
      { name: 'Daniel V.', role: 'Agency owner, NL', stars: 5, text: 'We folded this into our onboarding playbook for new account managers. It is now part of every client kickoff.' }
    ].map((r, i) => '<figure class="opt-reveal opt-card bg-white rounded-2xl p-5" data-delay="' + (i * 70) + '">' +
      '<div class="flex items-center gap-2 mb-2">' +
        '<span class="text-amber-400 text-xs tracking-tight">' + '\u2605'.repeat(r.stars) + '<span class="text-stone-200">' + '\u2605'.repeat(5 - r.stars) + '</span></span>' +
      '</div>' +
      '<blockquote class="text-xs text-stone-600 leading-relaxed mb-4">&ldquo;' + r.text + '&rdquo;</blockquote>' +
      '<figcaption class="flex items-center gap-2.5"><div class="w-8 h-8 rounded-full bg-stone-100 flex items-center justify-center text-[11px] font-semibold text-stone-500">' + r.name.split(' ').map(w => w[0]).join('') + '</div><div><p class="text-xs font-semibold text-stone-900">' + r.name + '</p><p class="text-[10px] text-stone-400">' + r.role + '</p></div></figcaption>' +
    '</figure>').join('')}
  </div>

  ${related.length > 0 ? '<div class="mt-12"><div class="flex items-end justify-between mb-5 opt-reveal"><h2 class="text-lg font-bold text-stone-900">Bought alongside this</h2><a href="/products" class="text-sm text-primary font-semibold opt-link">All products</a></div>' +
    '<div class="grid grid-cols-2 lg:grid-cols-4 gap-3">' +
    related.map((r, i) => {
      const thumbs = ['from-emerald-500/14 to-emerald-500/4 text-emerald-700','from-amber-500/16 to-amber-500/4 text-amber-700','from-stone-400/18 to-stone-300/5 text-stone-600','from-lime-500/14 to-lime-500/4 text-lime-700'];
      return '<div class="opt-reveal opt-lift group flex flex-col bg-white opt-card rounded-2xl overflow-hidden" data-delay="' + (i * 60) + '">' +
        '<a href="/products/' + (r.slug || '') + '" class="block relative aspect-[4/3] bg-gradient-to-br ' + thumbs[i % 4] + ' flex items-center justify-center"><svg class="w-9 h-9" fill="none" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5-3v12a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2h3l2-2h4l2 2h3a2 2 0 012 2z"/></svg></a>' +
        '<div class="p-3.5 flex flex-col flex-1">' +
          '<a href="/products/' + (r.slug || '') + '" class="block"><h3 class="font-semibold text-stone-900 text-xs mb-2 line-clamp-2 group-hover:text-primary transition flex-1">' + r.name + '</h3></a>' +
          '<div class="flex items-center justify-between mt-auto"><span class="text-sm font-bold text-stone-900">' + sym + (r.price?.toFixed(2) || '0.00') + '</span>' +
          '<button type="button" data-add-to-cart data-name="' + r.name + '" data-slug="' + (r.slug || '') + '" data-price="' + (r.price || 0) + '" class="text-[11px] font-semibold text-primary opt-link">Add +</button></div>' +
        '</div>' +
      '</div>';
    }).join('') +
  '</div></div>' : ''}
</div>
`, store, product, related }) %>
