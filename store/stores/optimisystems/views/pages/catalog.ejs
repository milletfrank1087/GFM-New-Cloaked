<%
  const pageTitle = typeof searchQuery !== 'undefined' && searchQuery ? 'Search: ' + searchQuery : 'Toolkits';
  const extraHead = '';
  const allCats = [...new Set((store.products || []).map(p => p.category).filter(Boolean))];
  const activeQ = (typeof searchQuery !== 'undefined' ? searchQuery : '') || '';
  const sym = store.currencySymbol || '\u20ac';
%>
<%- include('../layouts/store', { body: `
<section class="relative overflow-hidden opt-mesh border-b border-stone-100">
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <nav class="flex items-center gap-1.5 text-xs text-stone-400 mb-4 opt-reveal">
      <a href="/" class="hover:text-stone-600 transition">Home</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      <span class="text-stone-600">${activeQ ? 'Search' : 'All products'}</span>
    </nav>
    <div class="max-w-2xl opt-reveal">
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-stone-900 tracking-tight mb-2">${activeQ ? 'Results for &ldquo;' + activeQ + '&rdquo;' : 'The full collection'}</h1>
      <p class="text-sm text-stone-500">${(products || []).length} downloadable toolkit${(products || []).length === 1 ? '' : 's'} and managed bundles, written and field-tested by our studio.</p>
    </div>
    <form action="/search" method="GET" class="mt-6 max-w-md opt-reveal" data-delay="60">
      <div class="relative">
        <svg class="w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.3-4.3m1.8-4.45a6.25 6.25 0 11-12.5 0 6.25 6.25 0 0112.5 0z"/></svg>
        <input type="text" name="q" placeholder="Search toolkits, scripts, reports..." value="${activeQ}" class="w-full bg-white border border-stone-200 rounded-full pl-10 pr-4 py-3 text-sm shadow-sm focus:outline-none">
      </div>
    </form>
  </div>
</section>

<div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-10">
  <div class="flex flex-wrap items-center gap-2 mb-8 opt-reveal">
    <a href="/products" class="opt-chip text-xs font-semibold px-3.5 py-2 rounded-full border ${activeQ ? 'border-stone-200 text-stone-500 bg-white hover:border-stone-300' : 'border-primary bg-primary text-white'}">All products</a>
    ${allCats.map(c => {
      const on = activeQ.toLowerCase() === c.toLowerCase();
      return '<a href="/search?q=' + encodeURIComponent(c) + '" class="opt-chip text-xs font-semibold px-3.5 py-2 rounded-full border ' + (on ? 'border-primary bg-primary text-white' : 'border-stone-200 text-stone-500 bg-white hover:border-stone-300 hover:text-stone-700') + '">' + c + '</a>';
    }).join('')}
  </div>

  ${(products || []).length === 0 ? (
    '<div class="text-center py-16 opt-reveal">' +
      '<div class="w-16 h-16 rounded-full bg-stone-100 flex items-center justify-center mx-auto mb-4"><svg class="w-7 h-7 text-stone-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.3-4.3m1.8-4.45a6.25 6.25 0 11-12.5 0 6.25 6.25 0 0112.5 0z"/></svg></div>' +
      '<h2 class="text-lg font-bold text-stone-900 mb-2">No products match that search</h2>' +
      '<p class="text-sm text-stone-400 mb-6">Try a broader term, or browse the full collection.</p>' +
      '<a href="/products" class="btn-primary inline-block text-white px-6 py-2.5 rounded-full font-semibold text-sm">View all products</a>' +
    '</div>'
  ) : (
  '<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">' +
    (products || []).map((p, i) => {
      const thumbs = ['from-emerald-500/14 to-emerald-500/4 text-emerald-700','from-amber-500/16 to-amber-500/4 text-amber-700','from-stone-400/18 to-stone-300/5 text-stone-600','from-lime-500/14 to-lime-500/4 text-lime-700','from-orange-500/14 to-orange-500/4 text-orange-700','from-teal-500/14 to-teal-500/4 text-teal-700'];
      const icons = [
        'M9 12l2 2 4-4m5-3v12a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2h3l2-2h4l2 2h3a2 2 0 012 2z',
        'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z',
        'M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z',
        'M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z'
      ];
      const cf = [1.25,1.3,1.35,1.4][i % 4];
      const compare = (p.price * cf).toFixed(2);
      const pct = Math.round((1 - 1/cf) * 100);
      return '<div class="opt-reveal opt-lift group flex flex-col bg-white opt-card rounded-2xl overflow-hidden" data-delay="' + ((i % 4) * 60) + '">' +
        '<a href="/products/' + (p.slug || '') + '" class="block relative aspect-[4/3] bg-gradient-to-br ' + thumbs[i % thumbs.length] + ' flex items-center justify-center">' +
          '<svg class="w-11 h-11" fill="none" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="' + icons[i % icons.length] + '"/></svg>' +
          '<span class="absolute top-2.5 left-2.5 text-[10px] font-semibold text-stone-700 bg-white/85 opt-glass px-2 py-0.5 rounded-full">' + (p.category || 'Toolkit') + '</span>' +
          '<span class="absolute top-2.5 right-2.5 text-[10px] font-bold text-white bg-primary px-2 py-0.5 rounded-full">-' + pct + '%</span>' +
        '</a>' +
        '<div class="p-3.5 sm:p-4 flex flex-col flex-1">' +
          '<a href="/products/' + (p.slug || '') + '" class="block"><h3 class="font-semibold text-stone-900 text-sm leading-snug mb-1.5 line-clamp-2 group-hover:text-primary transition">' + p.name + '</h3></a>' +
          '<p class="text-xs text-stone-400 leading-relaxed line-clamp-2 mb-3">' + (p.description || '') + '</p>' +
          '<div class="flex items-baseline gap-2 mb-3 mt-auto"><span class="text-base font-extrabold text-stone-900">' + sym + (p.price ? p.price.toFixed(2) : '0.00') + '</span><span class="text-xs text-stone-300 line-through">' + sym + compare + '</span></div>' +
          '<button type="button" data-add-to-cart data-name="' + p.name + '" data-slug="' + (p.slug || '') + '" data-price="' + (p.price || 0) + '" class="btn-primary w-full text-white py-2.5 rounded-full font-semibold text-xs inline-flex items-center justify-center gap-1.5"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.4c.5 0 .95.34 1.08.83l.39 1.44M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.2c1.1-2.3 2.1-4.7 2.9-7.1a60 60 0 00-16.5-1.9M7.5 14.25L5.1 5.27"/></svg>Add to cart</button>' +
        '</div>' +
      '</div>';
    }).join('') +
  '</div>'
  )}
</div>
`, store, products, searchQuery: typeof searchQuery !== 'undefined' ? searchQuery : '' }) %>
