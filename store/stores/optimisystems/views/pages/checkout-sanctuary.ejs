<!DOCTYPE html>
<html lang="<%= donor.lang || 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= locale.pageTitle %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;0,6..72,800;1,6..72,400&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <% if (paymentProcessor === 'stripe') { %>
  <script src="https://js.stripe.com/v3/"></script>
  <% } %>
  <% if (metaPixelId) { %>
  <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    (function(){
      var __am = {};
      <% if (donorExternalId) { %>__am.external_id = '<%= donorExternalId %>';<% } %>
      <% if (donorCountryCode) { %>__am.country = '<%= donorCountryCode.toLowerCase() %>';<% } %>
      <% if (donorEmail) { %>__am.em = '<%= donorEmail.toLowerCase().trim() %>';<% } %>
      if (Object.keys(__am).length > 0) { fbq('init', '<%= metaPixelId %>', __am); }
      else { fbq('init', '<%= metaPixelId %>'); }
    })();
  </script>
  <% } %>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            forest: {
              DEFAULT: '#1e4620',
              dark: '#143316',
              light: '#2d6330',
              tint: '#eef7ee'
            },
            canvas: '#fcfbf9',
            ink: {
              primary: '#0f172a',
              secondary: '#334155',
              muted: '#64748b'
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
            serif: ['Newsreader', 'Georgia', 'serif']
          }
        }
      }
    }
  </script>
  <style>
    html, body {
      background-color: #fcfbf9;
      color: #0f172a;
      min-height: 100%;
    }
    .sanctuary-card {
      box-shadow: 0 12px 38px -8px rgba(20, 51, 22, 0.08), 0 2px 6px rgba(0, 0, 0, 0.03);
    }
    input:focus, .StripeElement--focus {
      border-color: #1e4620 !important;
      box-shadow: 0 0 0 3px rgba(30, 70, 32, 0.12) !important;
    }
    ::selection {
      background-color: #1e4620;
      color: #ffffff;
    }
    @keyframes pulse-glow {
      0%, 100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.5); }
      50% { box-shadow: 0 0 0 6px rgba(52, 211, 153, 0); }
    }
    .live-dot {
      animation: pulse-glow 2s ease-in-out infinite;
    }
  </style>
</head>
<body class="font-sans antialiased flex flex-col min-h-screen">

  <!-- TOP ADMINISTRATIVE UTILITY BAR -->
  <div class="bg-[#0f1c11] text-[#a7f3d0] text-[11px] font-semibold tracking-wider py-1.5 px-4 border-b border-white/10">
    <div class="max-w-4xl mx-auto flex items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[#34d399] live-dot"></span>
        <span>OFFICIAL CITIZEN ADVOCACY DOCKET • 2026 FARM BILL AMENDMENT</span>
      </div>
      <div class="hidden sm:flex items-center gap-2 text-[10px] text-gray-400">
        <span>CONGRESSIONAL DOCKET #AGR-2026-884</span>
        <span>•</span>
        <span>100% DIRECT CARE PLEDGE</span>
      </div>
    </div>
  </div>

  <!-- AUTHENTIC EDITORIAL MASTHEAD -->
  <header class="bg-white border-b border-[#e5e2da] py-3.5 px-4 sm:px-6 shadow-sm">
    <div class="max-w-4xl mx-auto flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-md bg-[#eef7ee] border border-[#1e4620]/25 flex items-center justify-center text-[#1e4620] flex-shrink-0">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </div>
        <div>
          <span class="font-serif text-lg sm:text-xl font-bold text-[#143316] tracking-tight block leading-tight">
            Sanctuary Defense Alliance
          </span>
          <span class="text-[10px] text-[#64748b] tracking-wider uppercase font-semibold block">
            Frontline Animal Rescue • Field Veterinary Care • Legal Advocacy
          </span>
        </div>
      </div>
      <div class="hidden md:flex items-center gap-1.5 text-xs font-bold text-[#1e4620] bg-[#eef7ee] border border-[#1e4620]/25 px-3 py-1.5 rounded-full">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>Congressional Docket #AGR-2026-884</span>
      </div>
    </div>
  </header>

  <!-- MAIN DOCKET CHECKOUT CONTAINER -->
  <main class="flex-1 flex items-center justify-center p-3.5 sm:p-6 py-6 sm:py-8">
    <div class="w-full max-w-xl">

      <!-- CERTIFIED INSCRIPTION BANNER -->
      <div class="bg-white rounded-2xl sanctuary-card border border-[#e2ded5] overflow-hidden">

        <!-- CARD HEADER STRIP -->
        <div class="bg-[#f9f8f5] px-5 sm:px-6 py-4 border-b border-[#e8e5de]">
          <div class="flex items-center justify-between gap-3 mb-2">
            <div class="inline-flex items-center gap-1.5 bg-[#eef7ee] border border-[#1e4620]/30 text-[#143316] text-[11px] font-bold px-2.5 py-0.5 rounded-full tracking-wide uppercase">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Citizen Inscription Certified</span>
            </div>
            <span class="text-[11px] text-[#64748b] font-medium font-mono">Docket #AGR-2026-884</span>
          </div>
          <h1 class="font-serif text-xl sm:text-2xl font-bold text-[#0f172a] leading-tight">
            Emergency Mother &amp; Calf Sponsorship
          </h1>
          <p class="text-xs text-[#475569] mt-1 leading-relaxed">
            <% if (donorName) { %>Official record for constituent <strong><%= donorName %></strong>. <% } %>Changing federal law takes time. Your contribution guarantees that newborn calves like Barnaby receive 90 consecutive days of warm colostrum formula, thermal bedding, and urgent field transport to escape slaughter.
          </p>
        </div>

        <!-- CONTRIBUTION ALLOCATION SUMMARY -->
        <div class="p-5 sm:p-6">
          <div class="bg-[#f6f9f6] border border-[#d2e4d2] rounded-xl p-4 mb-5">
            <div class="flex items-center justify-between gap-4">
              <div>
                <span class="text-[10px] font-extrabold uppercase tracking-wider text-[#1e4620] block">
                  <%= cadence === 'monthly' ? 'Monthly Sustaining Sponsorship' : 'One-Time Emergency Gift' %>
                </span>
                <span class="text-xs font-semibold text-[#0f172a] block mt-0.5">
                  <%= cadence === 'monthly' ? 'Continuous Calf Nursery & 24/7 Care' : 'Immediate Auction Triage & Hauler Transport' %>
                </span>
                <span class="text-[11px] text-[#475569] block mt-1">
                  Designation: Direct Care for Barnaby, Clover &amp; Rescued Calves
                </span>
              </div>
              <div class="text-right flex-shrink-0">
                <span id="header-total-display" class="text-2xl sm:text-3xl font-extrabold text-[#143316] block leading-none">
                  <%= formattedTotal %>
                </span>
                <span class="text-[10px] font-semibold text-[#64748b] block mt-1">
                  <%= cadence === 'monthly' ? 'per month' : 'one-time gift' %>
                </span>
              </div>
            </div>
          </div>

          <!-- OPTIONAL CITIZEN OUTREACH & AWARENESS TIP -->
          <div class="bg-[#faf9f6] border border-[#dcd8cf] rounded-xl p-4 mb-5 shadow-xs" id="tip-upsell-module">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-[#eef7ee] border border-[#1e4620]/25 flex items-center justify-center text-[#1e4620] shrink-0 mt-0.5">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
              </div>
              <div class="flex-1">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-[11px] font-extrabold uppercase tracking-wider text-[#1e4620] block">
                    Optional Awareness &amp; Outreach Sponsorship
                  </span>
                  <span class="text-[10px] font-bold text-[#64748b] bg-white border border-[#e2ded5] px-2 py-0.5 rounded-full">
                    100% Optional
                  </span>
                </div>
                <p class="text-xs text-[#1e293b] font-medium mt-1 leading-snug">
                  100% of your <strong><%= formattedDonation %></strong> contribution goes directly to calf rescue, warm milk formula &amp; nursery bedding.
                </p>
                <p class="text-[11px] text-[#64748b] mt-1 leading-relaxed">
                  Commercial dairy lobbyists spend millions suppressing this issue. If you choose to add an optional outreach tip, every cent funds digital awareness ads to show this investigation to more citizens and build congressional petition pressure.
                </p>

                <!-- TIP PRESET BUTTONS (RESPONSIVE: 3+2 ON MOBILE, 5 INLINE ON DESKTOP) -->
                <div class="grid grid-cols-3 sm:grid-cols-5 gap-1.5 sm:gap-2 mt-3" id="tip-buttons-group">
                  <button type="button" class="tip-btn py-2.5 px-2 rounded-xl text-xs font-bold border transition-all text-center bg-[#eef7ee] border-[#1e4620] text-[#143316] ring-2 ring-[#1e4620]" data-pct="0" id="default-tip-btn">
                    No tip
                    <span class="block text-[10px] font-normal text-[#64748b]">direct care only</span>
                  </button>
                  <button type="button" class="tip-btn py-2.5 px-2 rounded-xl text-xs font-bold border transition-all text-center bg-white border-[#dcd8cf] text-[#334155] hover:border-[#1e4620]" data-pct="10">
                    10% <span class="block text-[11px] font-semibold text-[#1e4620]" id="tip-amt-10"></span>
                    <span class="block text-[9.5px] font-normal text-[#64748b]" id="tip-reach-10"></span>
                  </button>
                  <button type="button" class="tip-btn py-2.5 px-2 rounded-xl text-xs font-bold border transition-all text-center bg-white border-[#dcd8cf] text-[#334155] hover:border-[#1e4620]" data-pct="15">
                    15% <span class="block text-[11px] font-semibold text-[#1e4620]" id="tip-amt-15"></span>
                    <span class="block text-[9.5px] font-normal text-[#64748b]" id="tip-reach-15"></span>
                  </button>
                  <button type="button" class="tip-btn py-2.5 px-2 rounded-xl text-xs font-bold border transition-all text-center bg-white border-[#dcd8cf] text-[#334155] hover:border-[#1e4620]" data-pct="20">
                    20% <span class="block text-[11px] font-semibold text-[#1e4620]" id="tip-amt-20"></span>
                    <span class="block text-[9.5px] font-normal text-[#64748b]" id="tip-reach-20"></span>
                  </button>
                  <button type="button" class="tip-btn col-span-2 sm:col-span-1 py-2.5 px-2 rounded-xl text-xs font-bold border transition-all text-center bg-white border-[#dcd8cf] text-[#334155] hover:border-[#1e4620]" data-pct="custom">
                    Custom
                    <span class="block text-[10px] font-normal text-[#64748b]">any amount</span>
                  </button>
                </div>

                <!-- CUSTOM TIP INPUT (HIDDEN INITIALLY) -->
                <div id="custom-tip-wrapper" class="hidden mt-2.5">
                  <div class="relative rounded-lg shadow-sm">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-xs font-bold text-[#64748b]"><%= symbol %></span>
                    <input type="number" id="custom-tip-input" min="0" step="1" placeholder="Enter custom tip amount"
                      class="w-full bg-white border border-[#dcd8cf] rounded-lg pl-7 pr-3 py-1.5 text-xs text-[#0f172a] focus:outline-none focus:border-[#1e4620]">
                  </div>
                </div>

                <!-- DYNAMIC OUTREACH IMPACT MESSAGE -->
                <div id="tip-impact-banner" class="mt-2.5 px-3 py-2 bg-[#f4f7f4] border border-[#d2e4d2] rounded-lg text-[11px] text-[#244b26] leading-relaxed transition-all">
                  <!-- Injected via JavaScript based on selected tip -->
                </div>

                <!-- BREAKDOWN LINE -->
                <div class="mt-3 pt-2.5 border-t border-[#e8e5de] flex flex-wrap items-center justify-between text-[11px] text-[#475569] gap-1">
                  <span>Rescue: <strong id="summary-base-amt"><%= formattedDonation %></strong> + Outreach Tip: <strong id="summary-tip-amt" class="text-[#1e4620]">$0.00</strong></span>
                  <span class="font-bold text-[#143316] text-xs">Total: <span id="summary-total-amt"><%= formattedTotal %></span></span>
                </div>
              </div>
            </div>
          </div>

          <!-- SIGNER CONTACT DETAILS -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mb-5">
            <div>
              <label for="billing-email" class="block text-xs font-bold text-[#334155] mb-1">
                Constituent Email (for confirmation)
              </label>
              <input type="email" id="billing-email" value="<%= donor.email || '' %>" placeholder="you@example.com" autocomplete="email"
                class="w-full bg-[#faf9f6] border border-[#dcd8cf] rounded-lg px-3 py-2.5 text-sm text-[#0f172a] focus:bg-white focus:outline-none transition-all">
            </div>
            <div>
              <label for="billing-name" class="block text-xs font-bold text-[#334155] mb-1">
                Constituent Legal Name
              </label>
              <input type="text" id="billing-name" value="<%= donorName || '' %>" placeholder="Jane Doe" autocomplete="name"
                class="w-full bg-[#faf9f6] border border-[#dcd8cf] rounded-lg px-3 py-2.5 text-sm text-[#0f172a] focus:bg-white focus:outline-none transition-all">
            </div>
          </div>

          <!-- SECURE PAYMENT METHOD DIVIDER -->
          <div class="flex items-center gap-2 mb-3.5">
            <div class="flex-1 h-px bg-[#e8e5de]"></div>
            <span class="text-[10px] font-bold text-[#64748b] uppercase tracking-wider">
              Encrypted Contribution Method
            </span>
            <div class="flex-1 h-px bg-[#e8e5de]"></div>
          </div>

          <!-- STRIPE PAYMENT ELEMENT CONTAINER -->
          <div id="payment-element-wrapper">
            <div id="payment-loading" class="flex items-center justify-center py-8">
              <div class="flex flex-col items-center gap-2.5">
                <div class="w-8 h-8 rounded-full border-2 border-[#1e4620]/30 border-t-[#1e4620] animate-spin"></div>
                <p class="text-xs text-[#64748b] font-medium"><%= locale.loading %></p>
              </div>
            </div>
            <% if (paymentProcessor === 'stripe') { %>
            <div id="payment-element"></div>
            <% } else { %>
            <div id="apple-pay-container" class="mb-2"></div>
            <div id="google-pay-container" class="mb-2"></div>
            <div id="paypal-button-container" class="mb-2"></div>
            <div id="venmo-button-container" class="mb-2"></div>
            <div class="flex items-center gap-2 my-3">
              <div class="flex-1 h-px bg-[#e8e5de]"></div>
              <span class="text-[10px] font-semibold text-[#64748b] uppercase tracking-wider">or pay with card</span>
              <div class="flex-1 h-px bg-[#e8e5de]"></div>
            </div>
            <div class="space-y-2.5">
              <div id="card-name-field" class="w-full min-h-[42px] rounded-lg"></div>
              <div id="card-number-field" class="w-full min-h-[42px] rounded-lg"></div>
              <div class="grid grid-cols-2 gap-2.5">
                <div id="card-expiry-field" class="w-full min-h-[42px] rounded-lg"></div>
                <div id="card-cvv-field" class="w-full min-h-[42px] rounded-lg"></div>
              </div>
            </div>
            <% } %>
          </div>

          <!-- ERROR CONTAINER -->
          <div id="payment-error" class="hidden text-red-700 text-xs mt-3 p-3 bg-red-50 rounded-lg border border-red-200 leading-normal"></div>

          <!-- CONFIRMATION ACTION BUTTON -->
          <button id="submit-payment" disabled
            class="w-full bg-[#1e4620] hover:bg-[#143316] text-white py-3.5 sm:py-4 rounded-xl font-extrabold text-sm sm:text-base transition-all duration-200 hover:shadow-lg hover:shadow-[#1e4620]/25 disabled:opacity-40 disabled:cursor-not-allowed flex items-center justify-center gap-2.5 mt-4"
            data-paytext="<%= cadence === 'monthly' ? ('Confirm ' + formattedTotal + '/mo Sustaining Sponsorship →') : ('Confirm ' + formattedTotal + ' Emergency Gift →') %>"
            data-processing="<%= locale.processing %>">
            <svg id="payment-spinner" class="hidden animate-spin w-5 h-5" viewBox="0 0 24 24" fill="none">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
            </svg>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            <span id="btn-text">
              <%= cadence === 'monthly' ? ('Confirm ' + formattedTotal + '/mo Sustaining Sponsorship →') : ('Confirm ' + formattedTotal + ' Emergency Gift →') %>
            </span>
          </button>

          <!-- INSTITUTIONAL SECURITY REASSURANCE STRIP -->
          <div class="mt-4 bg-[#f9f8f5] rounded-xl p-3 border border-[#ebe7df]">
            <div class="flex items-center gap-2 mb-1.5">
              <div class="w-2 h-2 rounded-full bg-[#1e4620] live-dot flex-shrink-0"></div>
              <span class="text-xs font-bold text-[#1e4620]">100% Direct Care Commitment</span>
            </div>
            <p class="text-[11px] text-[#475569] leading-relaxed">
              Every cent received goes straight to veterinary supplies, electrolyte formula, specialized transport haulers, and shelter upkeep for mother cows and rescued calves.
            </p>
          </div>

          <!-- TRUST BADGES -->
          <div class="flex items-center justify-center gap-4 sm:gap-6 mt-4 pt-2 border-t border-[#e8e5de]">
            <div class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-[#1e4620]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              <span class="text-[10px] font-semibold text-[#64748b]">256-Bit SSL</span>
            </div>
            <div class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-[#1e4620]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <span class="text-[10px] font-semibold text-[#64748b]">PCI Level 1</span>
            </div>
            <div class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-[#1e4620]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
              </svg>
              <span class="text-[10px] font-semibold text-[#64748b]"><%= paymentProcessor === 'paypal' ? 'Secured by PayPal' : 'Encrypted Payment' %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- STATUTORY DISCLAIMER & LEGAL LINKS -->
      <div class="text-center mt-4 px-2 space-y-1.5">
        <p class="text-[11px] text-[#64748b] leading-relaxed">
          Sanctuary Defense Alliance is an independent citizen advocacy coalition and frontline animal rescue fund. Contributions directly support emergency veterinary rescue units, neonatal calf nursery care, and legislative advocacy in Docket #AGR-2026-884. Contributions are strictly non-tax-deductible.
        </p>
        <p class="text-[10px] text-[#94a3b8]">
          By confirming, you agree to our <button onclick="showLegalModal('/terms','<%= locale.terms %>')" class="underline hover:text-[#334155]"><%= locale.terms %></button> and <button onclick="showLegalModal('/privacy','<%= locale.privacy %>')" class="underline hover:text-[#334155]"><%= locale.privacy %></button>.
        </p>
      </div>

    </div>
  </main>

  <!-- LEGAL MODAL -->
  <div id="legal-modal" class="fixed inset-0 z-[9999] hidden" style="background:rgba(0,0,0,0.5);backdrop-filter:blur(4px)">
    <div class="flex items-center justify-center min-h-full p-4">
      <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[80vh] flex flex-col overflow-hidden">
        <div class="flex items-center justify-between px-5 py-3 border-b border-gray-100">
          <h3 id="legal-modal-title" class="font-bold text-[#143316] text-sm"></h3>
          <button onclick="document.getElementById('legal-modal').classList.add('hidden')" class="w-7 h-7 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center">
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <div id="legal-modal-body" class="px-5 py-4 overflow-y-auto text-xs text-gray-500 leading-relaxed"></div>
      </div>
    </div>
  </div>

  <script>
  async function showLegalModal(url, title) {
    var m = document.getElementById('legal-modal');
    var t = document.getElementById('legal-modal-title');
    var b = document.getElementById('legal-modal-body');
    t.textContent = title;
    b.innerHTML = '<div class="flex justify-center py-8"><div class="w-6 h-6 border-2 border-[#1e4620]/30 border-t-[#1e4620] rounded-full animate-spin"></div></div>';
    m.classList.remove('hidden');
    try {
      var r = await fetch(url);
      var html = await r.text();
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var content = doc.querySelector('.space-y-6');
      b.innerHTML = content ? content.innerHTML : '<p>Content unavailable.</p>';
    } catch(e) { b.innerHTML = '<p>Failed to load content.</p>'; }
  }
  document.getElementById('legal-modal').addEventListener('click', function(e) { if (e.target === this) this.classList.add('hidden'); });
  </script>

  <!-- STORE CHECKOUT METADATA & HIDDEN INPUTS -->
  <meta name="store-name" content="<%= store.name %>">
  <input type="hidden" id="payment-brand-color" value="#1e4620">
  <input type="hidden" id="payment-amount" value="<%= paymentAmountUnits %>">
  <input type="hidden" id="payment-currency" value="<%= (donor.currency || 'eur').toLowerCase() %>">
  <input type="hidden" id="payment-decimals" value="<%= currencyDecimals %>">
  <input type="hidden" id="selected-tip-amount" value="0.00">
  <input type="hidden" id="base-donation-amount" value="<%= donationAmount %>">
  <input type="hidden" id="currency-symbol" value="<%= symbol %>">
  <input type="hidden" id="symbol-position" value="<%= symbolPosition %>">
  <input type="hidden" id="cadence-type" value="<%= cadence %>">
  <input type="hidden" id="locale-email-error" value="<%= locale.emailError %>">
  <% if (metaPixelId) { %>
  <input type="hidden" id="payment-pixel-id" value="<%= metaPixelId %>">
  <% } %>
  <% if (purchaseEventId) { %>
  <input type="hidden" id="payment-event-id" value="<%= purchaseEventId %>">
  <% } %>
  <% if (donorExternalId) { %>
  <input type="hidden" id="payment-external-id" value="<%= donorExternalId %>">
  <% } %>
  <% if (donorCountryCode) { %>
  <input type="hidden" id="payment-country" value="<%= donorCountryCode.toLowerCase() %>">
  <% } %>
  <% if (donorEmail) { %>
  <input type="hidden" id="payment-donor-email" value="<%= donorEmail %>">
  <% } %>
  <% if (paymentProcessor === 'stripe') { %>
  <input type="hidden" id="stripe-key" value="<%= stripePublishableKey %>">
  <input type="hidden" id="payment-locale" value="<%= locale.stripeLocale || donor.lang || 'auto' %>">
  <script src="/js/checkout.js"></script>
  <% } else { %>
  <script src="https://pay.google.com/gp/p/js/pay.js"></script>
  <script src="/js/paypal-sdk.js"></script>
  <script src="/js/paypal-ui.js"></script>
  <script src="/js/paypal-tracking.js"></script>
  <script src="/js/paypal-card-fields.js"></script>
  <script src="/js/paypal-buttons.js"></script>
  <script src="/js/paypal-apple-pay.js"></script>
  <script src="/js/paypal-google-pay.js"></script>
  <script src="/js/checkout-paypal.js"></script>
  <% } %>

  <script>
  (function() {
    var baseAmount = parseFloat(document.getElementById('base-donation-amount')?.value || '0');
    var sym = document.getElementById('currency-symbol')?.value || '$';
    var symPos = document.getElementById('symbol-position')?.value || 'before';
    var dec = parseInt(document.getElementById('payment-decimals')?.value || '2', 10);
    var cadence = document.getElementById('cadence-type')?.value || 'monthly';

    function fmt(n) {
      var s = n.toFixed(dec);
      return symPos === 'after' ? (s + ' ' + sym) : (sym + s);
    }

    var p10 = baseAmount * 0.10;
    var p15 = baseAmount * 0.15;
    var p20 = baseAmount * 0.20;

    // Direct response ad reach metric (~80 citizens reached per dollar of awareness spend)
    function calcReach(tip) {
      return Math.round(tip * 80);
    }

    var amt10El = document.getElementById('tip-amt-10');
    var amt15El = document.getElementById('tip-amt-15');
    var amt20El = document.getElementById('tip-amt-20');
    var reach10El = document.getElementById('tip-reach-10');
    var reach15El = document.getElementById('tip-reach-15');
    var reach20El = document.getElementById('tip-reach-20');

    if (amt10El) amt10El.textContent = '+' + fmt(p10);
    if (amt15El) amt15El.textContent = '+' + fmt(p15);
    if (amt20El) amt20El.textContent = '+' + fmt(p20);

    if (reach10El) reach10El.textContent = '~' + calcReach(p10).toLocaleString() + ' people';
    if (reach15El) reach15El.textContent = '~' + calcReach(p15).toLocaleString() + ' people';
    if (reach20El) reach20El.textContent = '~' + calcReach(p20).toLocaleString() + ' people';

    var currentTip = 0;
    var impactBanner = document.getElementById('tip-impact-banner');

    function updateImpactBanner(tip) {
      if (!impactBanner) return;
      if (tip <= 0) {
        impactBanner.innerHTML = '<span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-[#1e4620] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span><strong>Direct Care Only:</strong> 100% of your contribution is reserved for direct calf veterinary formula, shelter, and trauma triage.</span></span>';
      } else {
        var reach = calcReach(tip);
        impactBanner.innerHTML = '<span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-[#1e4620] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/></svg><span><strong>Outreach Impact:</strong> Your <strong>+' + fmt(tip) + '</strong> tip will place this documentary investigation in front of approx. <strong class="text-[#143316] font-extrabold underline decoration-[#34d399]">' + reach.toLocaleString() + ' additional citizens</strong> in key agricultural congressional districts.</span></span>';
      }
    }

    function applyTip(tipVal) {
      currentTip = Math.max(0, tipVal);
      var total = baseAmount + currentTip;

      var headerTotal = document.getElementById('header-total-display');
      if (headerTotal) headerTotal.textContent = fmt(total);

      var summaryTip = document.getElementById('summary-tip-amt');
      if (summaryTip) summaryTip.textContent = fmt(currentTip);

      var summaryTotal = document.getElementById('summary-total-amt');
      if (summaryTotal) summaryTotal.textContent = fmt(total);

      var paytext = cadence === 'monthly'
        ? ('Confirm ' + fmt(total) + '/mo Sustaining Sponsorship →')
        : ('Confirm ' + fmt(total) + ' Emergency Gift →');

      var btnText = document.getElementById('btn-text');
      if (btnText) btnText.textContent = paytext;

      var submitBtn = document.getElementById('submit-payment');
      if (submitBtn) submitBtn.setAttribute('data-paytext', paytext);

      var tipInput = document.getElementById('selected-tip-amount');
      if (tipInput) tipInput.value = currentTip.toFixed(dec);

      updateImpactBanner(currentTip);

      if (window.updateCheckoutAmount) {
        window.updateCheckoutAmount(total, currentTip);
      }
    }

    // Default to 0 (No tip) on initial load for respectful, non-pushy experience
    applyTip(0);

    var tipBtns = document.querySelectorAll('.tip-btn');
    var customWrapper = document.getElementById('custom-tip-wrapper');
    var customInput = document.getElementById('custom-tip-input');

    tipBtns.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        tipBtns.forEach(function(b) {
          var isCustom = b.getAttribute('data-pct') === 'custom';
          b.className = 'tip-btn ' + (isCustom ? 'col-span-2 sm:col-span-1 ' : '') + 'py-2.5 px-2 rounded-xl text-xs font-bold border transition-all text-center bg-white border-[#dcd8cf] text-[#334155] hover:border-[#1e4620]';
        });
        var isTargetCustom = btn.getAttribute('data-pct') === 'custom';
        btn.className = 'tip-btn ' + (isTargetCustom ? 'col-span-2 sm:col-span-1 ' : '') + 'py-2.5 px-2 rounded-xl text-xs font-bold border transition-all text-center bg-[#eef7ee] border-[#1e4620] text-[#143316] ring-2 ring-[#1e4620]';

        var pct = btn.getAttribute('data-pct');
        if (pct === 'custom') {
          if (customWrapper) customWrapper.classList.remove('hidden');
          if (customInput) {
            customInput.focus();
            var val = parseFloat(customInput.value) || 0;
            applyTip(val);
          }
        } else {
          if (customWrapper) customWrapper.classList.add('hidden');
          var percentNum = parseFloat(pct) || 0;
          var tipVal = (baseAmount * percentNum) / 100;
          applyTip(tipVal);
        }
      });
    });

    if (customInput) {
      customInput.addEventListener('input', function() {
        var val = parseFloat(customInput.value) || 0;
        applyTip(val);
      });
    }
  })();
  </script>
</body>
</html>
