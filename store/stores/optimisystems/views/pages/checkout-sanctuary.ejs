<!DOCTYPE html>
<html lang="<%= donor.lang || 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= locale.pageTitle %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;0,6..72,800;1,6..72,400&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <% if (paymentProcessor === 'stripe') { %>
  <script src="https://js.stripe.com/v3/"></script>
  <% } %>
  <% if (metaPixelId) { %>
  <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    (function(){
      var __am = {};
      <% if (donorExternalId) { %>__am.external_id = '<%= donorExternalId %>';<% } %>
      <% if (donorCountryCode) { %>__am.country = '<%= donorCountryCode.toLowerCase() %>';<% } %>
      <% if (donorEmail) { %>__am.em = '<%= donorEmail.toLowerCase().trim() %>';<% } %>
      if (Object.keys(__am).length > 0) { fbq('init', '<%= metaPixelId %>', __am); }
      else { fbq('init', '<%= metaPixelId %>'); }
    })();
  </script>
  <% } %>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            forest: {
              DEFAULT: '#1e4620',
              dark: '#143316',
              light: '#2d6330',
              tint: '#eef7ee'
            },
            canvas: '#fcfbf9',
            ink: {
              primary: '#0f172a',
              secondary: '#334155',
              muted: '#64748b'
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
            serif: ['Newsreader', 'Georgia', 'serif']
          }
        }
      }
    }
  </script>
  <style>
    html, body {
      background-color: #fcfbf9;
      color: #0f172a;
      min-height: 100%;
    }
    .sanctuary-card {
      box-shadow: 0 12px 38px -8px rgba(20, 51, 22, 0.08), 0 2px 6px rgba(0, 0, 0, 0.03);
    }
    input:focus, .StripeElement--focus {
      border-color: #1e4620 !important;
      box-shadow: 0 0 0 3px rgba(30, 70, 32, 0.12) !important;
    }
    ::selection {
      background-color: #1e4620;
      color: #ffffff;
    }
    @keyframes pulse-glow {
      0%, 100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.5); }
      50% { box-shadow: 0 0 0 6px rgba(52, 211, 153, 0); }
    }
    .live-dot {
      animation: pulse-glow 2s ease-in-out infinite;
    }
    #tip-buttons-group { user-select: none; -webkit-tap-highlight-color: transparent; }
  </style>
</head>
<body class="font-sans antialiased flex flex-col min-h-screen">

  <!-- TOP ADMINISTRATIVE UTILITY BAR (DESKTOP ONLY) -->
  <div class="bg-[#0f1c11] text-[#a7f3d0] text-[10.5px] font-semibold tracking-wider py-1.5 px-4 border-b border-white/10 hidden sm:block">
    <div class="max-w-4xl mx-auto flex items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[#34d399] live-dot"></span>
        <span>OFFICIAL CITIZEN ADVOCACY DOCKET • 2026 FARM BILL AMENDMENT</span>
      </div>
      <div class="flex items-center gap-2 text-[10px] text-gray-400">
        <span>CONGRESSIONAL DOCKET #AGR-2026-884</span>
        <span>•</span>
        <span>100% DIRECT CARE PLEDGE</span>
      </div>
    </div>
  </div>

  <!-- COMPACT MASTHEAD -->
  <header class="bg-white border-b border-[#e5e2da] py-2 sm:py-3.5 px-3 sm:px-6 shadow-xs">
    <div class="max-w-4xl mx-auto flex items-center justify-between gap-3">
      <div class="flex items-center gap-2 sm:gap-3">
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-md bg-[#eef7ee] border border-[#1e4620]/25 flex items-center justify-center text-[#1e4620] flex-shrink-0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </div>
        <div>
          <span class="font-serif text-[15px] sm:text-xl font-bold text-[#143316] tracking-tight block leading-tight">
            Sanctuary Defense Alliance
          </span>
          <span class="text-[9px] sm:text-[10px] text-[#64748b] tracking-wider uppercase font-semibold block leading-tight">
            Frontline Animal Rescue • Field Veterinary Care • Legal Advocacy
          </span>
        </div>
      </div>
      <div class="hidden md:flex items-center gap-1.5 text-xs font-bold text-[#1e4620] bg-[#eef7ee] border border-[#1e4620]/25 px-3 py-1.5 rounded-full">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>Congressional Docket #AGR-2026-884</span>
      </div>
    </div>
  </header>

  <!-- MAIN DOCKET CHECKOUT CONTAINER -->
  <main class="flex-1 flex items-center justify-center px-3 sm:p-6 py-3 sm:py-8">
    <div class="w-full max-w-xl">

      <div class="bg-white rounded-2xl sanctuary-card border border-[#e2ded5] overflow-hidden">

        <!-- CARD HEADER: BADGE + TITLE + AMOUNT -->
        <div class="bg-[#f9f8f5] px-3.5 sm:px-6 py-2.5 sm:py-3.5 border-b border-[#e8e5de]">
          <div class="flex items-center justify-between gap-2 mb-1">
            <div class="inline-flex items-center gap-1 bg-[#eef7ee] border border-[#1e4620]/30 text-[#143316] text-[9.5px] sm:text-[10px] font-bold px-1.5 py-0.5 rounded-full tracking-wide uppercase">
              <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Certified Citizen Sponsorship</span>
            </div>
            <span class="text-[9.5px] text-[#64748b] font-mono hidden sm:inline">Docket #AGR-2026-884</span>
          </div>

          <div class="flex items-center justify-between gap-2">
            <div class="min-w-0">
              <h1 class="font-serif text-[17px] sm:text-xl font-bold text-[#0f172a] leading-tight truncate">
                Emergency Calf Sponsorship
              </h1>
              <p class="text-[10.5px] text-[#64748b] mt-0.5 truncate">
                <% if (donorName) { %>Constituent: <strong><%= donorName %></strong> • <% } %>Direct nursery &amp; formula care
              </p>
            </div>
            <div class="text-right flex-shrink-0">
              <span id="header-total-display" class="text-xl sm:text-3xl font-extrabold text-[#143316] block leading-none">
                <%= formattedTotal %>
              </span>
              <span class="text-[9.5px] font-semibold text-[#64748b] block mt-0.5">
                <%= cadence === 'monthly' ? 'per month' : 'one-time gift' %>
              </span>
            </div>
          </div>
        </div>

        <div class="p-3.5 sm:p-6">

          <!-- DONATION PURPOSE — WHERE YOUR MONEY GOES -->
          <div class="mb-3 sm:mb-4 bg-[#eef7ee] rounded-xl p-3 border border-[#1e4620]/15">
            <p class="text-[11.5px] text-[#143316] leading-relaxed">
              <strong>100% of your <%= formattedTotal %> goes directly</strong> to emergency calf rescue, warm colostrum formula, thermal nursery bedding, and round-the-clock veterinary care for newborns like Barnaby who were separated from their mothers within hours of birth.
            </p>
          </div>

          <!-- OPTIONAL OUTREACH TIP — COMPACT SEGMENTED CONTROL -->
          <div class="mb-3 sm:mb-4" id="tip-upsell-module">
            <div class="flex items-center justify-between gap-2 mb-1">
              <div class="flex items-center gap-1.5">
                <span class="w-5 h-5 rounded-full bg-[#f0fdf4] border border-[#1e4620]/20 flex items-center justify-center flex-shrink-0">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#1e4620" stroke-width="2.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
                </span>
                <span class="text-[10px] font-bold uppercase tracking-wider text-[#64748b]">Optional Awareness Tip</span>
              </div>
              <span id="tip-summary-inline" class="text-[10.5px] font-bold text-[#143316]">Total: <span id="summary-total-amt"><%= formattedTotal %></span></span>
            </div>
            <p class="text-[10px] text-[#64748b] leading-snug mb-1.5">
              Optional tips fund digital awareness ads to reach more citizens and build congressional petition pressure. Every cent goes to outreach — never overhead.
            </p>
            <div class="flex rounded-lg border border-[#dcd8cf] overflow-hidden bg-white" id="tip-buttons-group">
              <button type="button" class="tip-btn flex-1 py-2 text-[11px] font-bold text-center transition-all bg-[#eef7ee] text-[#143316] border-r border-[#dcd8cf]" data-pct="0" id="default-tip-btn">None</button>
              <button type="button" class="tip-btn flex-1 py-2 text-[11px] font-bold text-center transition-all text-[#334155] border-r border-[#dcd8cf]" data-pct="10">10%</button>
              <button type="button" class="tip-btn flex-1 py-2 text-[11px] font-bold text-center transition-all text-[#334155] border-r border-[#dcd8cf]" data-pct="15">15%</button>
              <button type="button" class="tip-btn flex-1 py-2 text-[11px] font-bold text-center transition-all text-[#334155] border-r border-[#dcd8cf]" data-pct="20">20%</button>
              <button type="button" class="tip-btn flex-1 py-2 text-[11px] font-bold text-center transition-all text-[#334155]" data-pct="custom">Other</button>
            </div>
            <div id="custom-tip-wrapper" class="hidden mt-1.5">
              <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-xs font-bold text-[#64748b]"><%= symbol %></span>
                <input type="number" id="custom-tip-input" min="0" step="1" placeholder="0.00"
                  class="w-full bg-white border border-[#dcd8cf] rounded-lg pl-6 pr-3 py-1.5 text-xs text-[#0f172a] focus:outline-none focus:border-[#1e4620]">
              </div>
            </div>
            <div id="tip-impact-banner" class="mt-1 text-[10px] text-[#64748b] leading-snug"></div>
            <input type="hidden" id="summary-base-amt-val" value="<%= formattedDonation %>">
            <input type="hidden" id="summary-tip-amt-val" value="0.00">
          </div>

          <!-- SIGNER CONTACT DETAILS -->
          <div class="grid grid-cols-2 gap-2.5 mb-3 sm:mb-5">
            <div>
              <label for="billing-email" class="block text-[10.5px] font-bold text-[#334155] mb-0.5">
                Constituent Email
              </label>
              <input type="email" id="billing-email" value="<%= donor.email || '' %>" placeholder="you@example.com" autocomplete="email"
                class="w-full bg-[#faf9f6] border border-[#dcd8cf] rounded-lg px-2.5 py-2 text-[13px] text-[#0f172a] focus:bg-white focus:outline-none transition-all">
            </div>
            <div>
              <label for="billing-name" class="block text-[10.5px] font-bold text-[#334155] mb-0.5">
                Legal Name
              </label>
              <input type="text" id="billing-name" value="<%= donorName || '' %>" placeholder="Jane Doe" autocomplete="name"
                class="w-full bg-[#faf9f6] border border-[#dcd8cf] rounded-lg px-2.5 py-2 text-[13px] text-[#0f172a] focus:bg-white focus:outline-none transition-all">
            </div>
          </div>

          <!-- SECURE PAYMENT METHOD DIVIDER -->
          <div class="flex items-center gap-2 mb-2.5">
            <div class="flex-1 h-px bg-[#e8e5de]"></div>
            <span class="text-[9.5px] font-bold text-[#64748b] uppercase tracking-wider">
              Encrypted Contribution Method
            </span>
            <div class="flex-1 h-px bg-[#e8e5de]"></div>
          </div>

          <!-- STRIPE PAYMENT ELEMENT CONTAINER -->
          <div id="payment-element-wrapper">
            <div id="payment-loading" class="flex items-center justify-center py-8">
              <div class="flex flex-col items-center gap-2.5">
                <div class="w-8 h-8 rounded-full border-2 border-[#1e4620]/30 border-t-[#1e4620] animate-spin"></div>
                <p class="text-xs text-[#64748b] font-medium"><%= locale.loading %></p>
              </div>
            </div>
            <% if (paymentProcessor === 'stripe') { %>
            <div id="payment-element"></div>
            <% } else { %>
            <div id="apple-pay-container" class="mb-2"></div>
            <div id="google-pay-container" class="mb-2"></div>
            <div id="paypal-button-container" class="mb-2"></div>
            <div id="venmo-button-container" class="mb-2"></div>
            <div class="flex items-center gap-2 my-3">
              <div class="flex-1 h-px bg-[#e8e5de]"></div>
              <span class="text-[10px] font-semibold text-[#64748b] uppercase tracking-wider">or pay with card</span>
              <div class="flex-1 h-px bg-[#e8e5de]"></div>
            </div>
            <div class="space-y-2.5">
              <div id="card-name-field" class="w-full min-h-[42px] rounded-lg"></div>
              <div id="card-number-field" class="w-full min-h-[42px] rounded-lg"></div>
              <div class="grid grid-cols-2 gap-2.5">
                <div id="card-expiry-field" class="w-full min-h-[42px] rounded-lg"></div>
                <div id="card-cvv-field" class="w-full min-h-[42px] rounded-lg"></div>
              </div>
            </div>
            <% } %>
          </div>

          <!-- ERROR CONTAINER -->
          <div id="payment-error" class="hidden text-red-700 text-xs mt-3 p-3 bg-red-50 rounded-lg border border-red-200 leading-normal"></div>

          <!-- CONFIRMATION ACTION BUTTON -->
          <button id="submit-payment" disabled
            class="w-full bg-[#1e4620] hover:bg-[#143316] text-white py-3 sm:py-4 rounded-xl font-extrabold text-sm transition-all duration-200 hover:shadow-lg hover:shadow-[#1e4620]/25 disabled:opacity-40 disabled:cursor-not-allowed flex items-center justify-center gap-2 mt-3"
            data-paytext="<%= cadence === 'monthly' ? ('Confirm ' + formattedTotal + '/mo Sustaining Sponsorship →') : ('Confirm ' + formattedTotal + ' Emergency Gift →') %>"
            data-processing="<%= locale.processing %>">
            <svg id="payment-spinner" class="hidden animate-spin w-5 h-5" viewBox="0 0 24 24" fill="none">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
            </svg>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            <span id="btn-text">
              <%= cadence === 'monthly' ? ('Confirm ' + formattedTotal + '/mo Sustaining Sponsorship →') : ('Confirm ' + formattedTotal + ' Emergency Gift →') %>
            </span>
          </button>

          <!-- 100% DIRECT CARE COMMITMENT -->
          <div class="mt-3 bg-[#f9f8f5] rounded-xl p-2.5 border border-[#e8e5de]">
            <div class="flex items-start gap-2">
              <div class="w-2 h-2 rounded-full bg-[#1e4620] mt-1 flex-shrink-0"></div>
              <div>
                <span class="text-[11px] font-bold text-[#0f172a]">100% Direct Care Commitment</span>
                <p class="text-[10px] text-[#64748b] leading-snug mt-0.5">Every cent received goes straight to veterinary supplies, electrolyte formula, specialized transport haulers, and shelter upkeep for mother cows and rescued calves.</p>
              </div>
            </div>
          </div>

          <!-- SECURITY + TRUST (SINGLE COMPACT ROW) -->
          <div class="flex items-center justify-center gap-3 sm:gap-5 mt-3 pt-2 border-t border-[#e8e5de]">
            <div class="flex items-center gap-1">
              <svg class="w-3 h-3 text-[#1e4620]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              <span class="text-[9.5px] font-semibold text-[#64748b]">256-Bit SSL</span>
            </div>
            <div class="flex items-center gap-1">
              <svg class="w-3 h-3 text-[#1e4620]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <span class="text-[9.5px] font-semibold text-[#64748b]">PCI Level 1</span>
            </div>
            <div class="flex items-center gap-1">
              <svg class="w-3 h-3 text-[#1e4620]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
              </svg>
              <span class="text-[9.5px] font-semibold text-[#64748b]"><%= paymentProcessor === 'paypal' ? 'Secured by PayPal' : 'Encrypted Payment' %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- STATUTORY DISCLAIMER & LEGAL LINKS -->
      <div class="text-center mt-3 px-1 space-y-1">
        <p class="text-[10px] text-[#64748b] leading-snug">
          Sanctuary Defense Alliance is an independent citizen advocacy coalition and frontline animal rescue fund. Contributions directly support emergency veterinary rescue units, neonatal calf nursery care, and legislative advocacy in Docket #AGR-2026-884. Contributions are strictly non-tax-deductible.
        </p>
        <p class="text-[9.5px] text-[#94a3b8]">
          By confirming, you agree to our <button onclick="showLegalModal('/terms','<%= locale.terms %>')" class="underline hover:text-[#334155]"><%= locale.terms %></button> and <button onclick="showLegalModal('/privacy','<%= locale.privacy %>')" class="underline hover:text-[#334155]"><%= locale.privacy %></button>.
        </p>
      </div>

    </div>
  </main>

  <!-- LEGAL MODAL -->
  <div id="legal-modal" class="fixed inset-0 z-[9999] hidden" style="background:rgba(0,0,0,0.5);backdrop-filter:blur(4px)">
    <div class="flex items-center justify-center min-h-full p-4">
      <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[80vh] flex flex-col overflow-hidden">
        <div class="flex items-center justify-between px-5 py-3 border-b border-gray-100">
          <h3 id="legal-modal-title" class="font-bold text-[#143316] text-sm"></h3>
          <button onclick="document.getElementById('legal-modal').classList.add('hidden')" class="w-7 h-7 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center">
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <div id="legal-modal-body" class="px-5 py-4 overflow-y-auto text-xs text-gray-500 leading-relaxed"></div>
      </div>
    </div>
  </div>

  <script>
  async function showLegalModal(url, title) {
    var m = document.getElementById('legal-modal');
    var t = document.getElementById('legal-modal-title');
    var b = document.getElementById('legal-modal-body');
    t.textContent = title;
    b.innerHTML = '<div class="flex justify-center py-8"><div class="w-6 h-6 border-2 border-[#1e4620]/30 border-t-[#1e4620] rounded-full animate-spin"></div></div>';
    m.classList.remove('hidden');
    try {
      var r = await fetch(url);
      var html = await r.text();
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var content = doc.querySelector('.space-y-6');
      b.innerHTML = content ? content.innerHTML : '<p>Content unavailable.</p>';
    } catch(e) { b.innerHTML = '<p>Failed to load content.</p>'; }
  }
  document.getElementById('legal-modal').addEventListener('click', function(e) { if (e.target === this) this.classList.add('hidden'); });
  </script>

  <!-- STORE CHECKOUT METADATA & HIDDEN INPUTS -->
  <meta name="store-name" content="<%= store.name %>">
  <input type="hidden" id="payment-brand-color" value="#1e4620">
  <input type="hidden" id="payment-amount" value="<%= paymentAmountUnits %>">
  <input type="hidden" id="payment-currency" value="<%= (donor.currency || 'eur').toLowerCase() %>">
  <input type="hidden" id="payment-decimals" value="<%= currencyDecimals %>">
  <input type="hidden" id="selected-tip-amount" value="0.00">
  <input type="hidden" id="base-donation-amount" value="<%= donationAmount %>">
  <input type="hidden" id="currency-symbol" value="<%= symbol %>">
  <input type="hidden" id="symbol-position" value="<%= symbolPosition %>">
  <input type="hidden" id="cadence-type" value="<%= cadence %>">
  <input type="hidden" id="locale-email-error" value="<%= locale.emailError %>">
  <% if (metaPixelId) { %>
  <input type="hidden" id="payment-pixel-id" value="<%= metaPixelId %>">
  <% } %>
  <% if (purchaseEventId) { %>
  <input type="hidden" id="payment-event-id" value="<%= purchaseEventId %>">
  <% } %>
  <% if (donorExternalId) { %>
  <input type="hidden" id="payment-external-id" value="<%= donorExternalId %>">
  <% } %>
  <% if (donorCountryCode) { %>
  <input type="hidden" id="payment-country" value="<%= donorCountryCode.toLowerCase() %>">
  <% } %>
  <% if (donorEmail) { %>
  <input type="hidden" id="payment-donor-email" value="<%= donorEmail %>">
  <% } %>
  <% if (paymentProcessor === 'stripe') { %>
  <input type="hidden" id="stripe-key" value="<%= stripePublishableKey %>">
  <input type="hidden" id="payment-locale" value="<%= locale.stripeLocale || donor.lang || 'auto' %>">
  <script src="/js/checkout.js"></script>
  <% } else { %>
  <script src="https://pay.google.com/gp/p/js/pay.js"></script>
  <script src="/js/paypal-sdk.js"></script>
  <script src="/js/paypal-ui.js"></script>
  <script src="/js/paypal-tracking.js"></script>
  <script src="/js/paypal-card-fields.js"></script>
  <script src="/js/paypal-buttons.js"></script>
  <script src="/js/paypal-apple-pay.js"></script>
  <script src="/js/paypal-google-pay.js"></script>
  <script src="/js/checkout-paypal.js"></script>
  <% } %>

  <script>
  (function() {
    var baseAmount = parseFloat(document.getElementById('base-donation-amount')?.value || '0');
    var sym = document.getElementById('currency-symbol')?.value || '$';
    var symPos = document.getElementById('symbol-position')?.value || 'before';
    var dec = parseInt(document.getElementById('payment-decimals')?.value || '2', 10);
    var cadence = document.getElementById('cadence-type')?.value || 'monthly';

    function fmt(n) {
      var s = n.toFixed(dec);
      return symPos === 'after' ? (s + ' ' + sym) : (sym + s);
    }

    var currentTip = 0;
    var impactBanner = document.getElementById('tip-impact-banner');

    function applyTip(tipVal) {
      currentTip = Math.max(0, tipVal);
      var total = baseAmount + currentTip;

      var headerTotal = document.getElementById('header-total-display');
      if (headerTotal) headerTotal.textContent = fmt(total);

      var summaryTotal = document.getElementById('summary-total-amt');
      if (summaryTotal) summaryTotal.textContent = fmt(total);

      var paytext = cadence === 'monthly'
        ? ('Confirm ' + fmt(total) + '/mo Sustaining Sponsorship →')
        : ('Confirm ' + fmt(total) + ' Emergency Gift →');

      var btnText = document.getElementById('btn-text');
      if (btnText) btnText.textContent = paytext;

      var submitBtn = document.getElementById('submit-payment');
      if (submitBtn) submitBtn.setAttribute('data-paytext', paytext);

      var tipInput = document.getElementById('selected-tip-amount');
      if (tipInput) tipInput.value = currentTip.toFixed(dec);

      if (impactBanner) {
        if (currentTip > 0) {
          impactBanner.innerHTML = '<strong>Rescue:</strong> ' + fmt(baseAmount) + ' + <strong>Outreach Tip:</strong> ' + fmt(currentTip) + ' &mdash; Total: ' + fmt(total);
        } else {
          impactBanner.textContent = '100% of your contribution is reserved for direct calf veterinary formula, shelter, and trauma triage.';
        }
      }

      if (window.updateCheckoutAmount) {
        window.updateCheckoutAmount(total, currentTip);
      }
    }

    applyTip(0);

    var tipBtns = document.querySelectorAll('.tip-btn');
    var customWrapper = document.getElementById('custom-tip-wrapper');
    var customInput = document.getElementById('custom-tip-input');
    var inactiveClass = 'tip-btn flex-1 py-2 text-[11px] font-bold text-center transition-all text-[#334155]';
    var activeClass = 'tip-btn flex-1 py-2 text-[11px] font-bold text-center transition-all bg-[#eef7ee] text-[#143316]';

    tipBtns.forEach(function(btn, idx) {
      var hasBorderR = idx < tipBtns.length - 1;
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        tipBtns.forEach(function(b, i) {
          b.className = inactiveClass + (i < tipBtns.length - 1 ? ' border-r border-[#dcd8cf]' : '');
        });
        btn.className = activeClass + (hasBorderR ? ' border-r border-[#dcd8cf]' : '');

        var pct = btn.getAttribute('data-pct');
        if (pct === 'custom') {
          if (customWrapper) customWrapper.classList.remove('hidden');
          if (customInput) {
            customInput.focus();
            applyTip(parseFloat(customInput.value) || 0);
          }
        } else {
          if (customWrapper) customWrapper.classList.add('hidden');
          applyTip((baseAmount * (parseFloat(pct) || 0)) / 100);
        }
      });
    });

    if (customInput) {
      customInput.addEventListener('input', function() {
        applyTip(parseFloat(customInput.value) || 0);
      });
    }
  })();
  </script>
</body>
</html>
