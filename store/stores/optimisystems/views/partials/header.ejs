<header class="<%= store.fingerprint.headerClass %>">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 shrink-0">
      <div class="w-7 h-7 rounded-lg bg-primary flex items-center justify-center">
        <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12h3l2-6 4 14 3-8 2 4h4"/>
        </svg>
      </div>
      <span class="text-base font-bold text-neutral-900"><%= store.name %></span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-neutral-500">
      <a href="/#playbook" class="hover:text-neutral-900 transition">Playbook</a>
      <a href="/products" class="hover:text-neutral-900 transition">Toolkits</a>
      <a href="/about" class="hover:text-neutral-900 transition">Studio</a>
      <a href="/faq" class="hover:text-neutral-900 transition">Answers</a>
      <a href="/contact" class="hover:text-neutral-900 transition">Talk to us</a>
    </nav>

    <div class="flex items-center gap-3">
      <a href="/cart" class="relative p-2 text-neutral-500 hover:text-neutral-900 transition" aria-label="Cart">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6h16.5l-1.5 11.25A2.25 2.25 0 0116.5 19.5h-9a2.25 2.25 0 01-2.25-2.25L3.75 6zM7.5 6V4.5A3.75 3.75 0 0111.25 .75h1.5A3.75 3.75 0 0116.5 4.5V6"/>
        </svg>
        <span data-cart-count class="absolute -top-0.5 -right-0.5 bg-primary text-white text-[10px] w-4.5 h-4.5 rounded-full flex items-center justify-center font-bold leading-none" style="display:none">0</span>
      </a>
      <button id="menu-toggle" class="md:hidden p-2 -mr-2 text-neutral-500 hover:text-neutral-900 transition" aria-label="Menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

<div id="<%= store.fingerprint.overlayId %>" class="<%= store.fingerprint.overlayClass %> fixed inset-0 bg-neutral-900/35 z-50 md:hidden"></div>
<div id="<%= store.fingerprint.navId %>" class="<%= store.fingerprint.navClass %> fixed top-0 right-0 bottom-0 w-72 bg-white z-50 md:hidden shadow-2xl">
  <div class="flex items-center justify-between px-5 h-14 border-b border-neutral-100">
    <span class="font-bold text-neutral-900"><%= store.name %></span>
    <button id="menu-close" class="p-2 -mr-2 text-neutral-400 hover:text-neutral-900 transition" aria-label="Close">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>
  <div class="px-3 py-4 space-y-1">
    <a href="/" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-neutral-50 transition">Home</a>
    <a href="/#playbook" class="nav-link block px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-neutral-50 transition">Playbook</a>
    <a href="/products" class="nav-link block px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-neutral-50 transition">Toolkits</a>
    <a href="/about" class="nav-link block px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-neutral-50 transition">Studio</a>
    <a href="/faq" class="nav-link block px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-neutral-50 transition">Answers</a>
    <a href="/contact" class="nav-link block px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-neutral-50 transition">Talk to us</a>
    <a href="/cart" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-neutral-50 transition">Cart</a>
  </div>
</div>

<script>
(function(){
  var toggle=document.getElementById('menu-toggle'),
      close=document.getElementById('menu-close'),
      drawer=document.getElementById('<%= store.fingerprint.navId %>'),
      overlay=document.getElementById('<%= store.fingerprint.overlayId %>');
  function open(){drawer.classList.add('open');overlay.classList.add('open');document.body.style.overflow='hidden';}
  function shut(){drawer.classList.remove('open');overlay.classList.remove('open');document.body.style.overflow='';}
  if(toggle)toggle.addEventListener('click',open);
  if(close)close.addEventListener('click',shut);
  if(overlay)overlay.addEventListener('click',shut);
  document.querySelectorAll('.nav-link').forEach(function(a){a.addEventListener('click',shut);});
})();
</script>
