<!DOCTYPE html>
<html lang="<%= donor.lang || 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= locale.pageTitle %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet">
  <% if (paymentProcessor === 'stripe') { %>
  <script src="https://js.stripe.com/v3/"></script>
  <% } %>
  <% if (metaPixelId) { %>
  <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    (function(){
      var __am = {};
      <% if (donorExternalId) { %>__am.external_id = '<%= donorExternalId %>';<% } %>
      <% if (donorCountryCode) { %>__am.country = '<%= donorCountryCode.toLowerCase() %>';<% } %>
      <% if (donorEmail) { %>__am.em = '<%= donorEmail.toLowerCase().trim() %>';<% } %>
      if (Object.keys(__am).length > 0) { fbq('init', '<%= metaPixelId %>', __am); }
      else { fbq('init', '<%= metaPixelId %>'); }
    })();
  </script>
  <% } %>
  <style>
    :root {
      --paper: #f8f6ef;
      --surface: #fffefa;
      --ink: #263e33;
      --muted: #646960;
      --green: #2d5140;
      --green-hover: #213e30;
      --green-active: #182e24;
      --sage: #eaf0e5;
      --sage-ink: #486044;
      --line: #d8dccf;
      --control-line: #828c7c;
      --ochre: #816329;
      --disabled: #e1e4dc;
      --shadow: 0 8px 30px rgba(38, 62, 51, 0.05);
      --serif: 'Newsreader', Georgia, serif;
      --sans: 'DM Sans', sans-serif;
      --xs: .75rem;
      --sm: .875rem;
      --base: 1rem;
      --lg: 1.125rem;
      --xl: 1.375rem;
      --s1: .25rem;
      --s2: .5rem;
      --s3: .75rem;
      --s4: 1rem;
      --s5: 1.25rem;
      --s6: 1.5rem;
      --s8: 2rem;
      --radius: 6px;
      --radius-card: 10px;
      --pill: 100px;
      --fast: 160ms;
      --ease: cubic-bezier(.22, 1, .36, 1);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font: var(--base)/1.6 var(--sans);
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    ::selection { background: var(--sage); color: var(--ink); }
    :focus-visible { outline: 2px solid var(--green); outline-offset: 3px; border-radius: 2px; }
    a { color: inherit; text-decoration: none; }
    [hidden], .hidden { display: none !important; }
    button, input { font: inherit; }
    button { cursor: pointer; }
    h1, h2, h3, p { margin: 0; }
    h1, h2 { font-family: var(--serif); font-weight: 400; letter-spacing: -.03em; line-height: 1.15; }

    /* Site Masthead */
    .site-header {
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      min-height: 64px;
      display: flex;
      align-items: center;
    }
    .header-inner {
      width: min(1200px, calc(100% - var(--s6)));
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--s4);
    }
    .brand {
      display: inline-flex;
      align-items: center;
      gap: var(--s2);
      text-decoration: none;
      font: 500 1.5rem/1 var(--serif);
      letter-spacing: -.03em;
      color: var(--ink);
    }
    .brand-mark {
      width: 28px;
      height: 28px;
      stroke-width: 1.6;
      color: var(--green);
    }
    .brand-sub {
      display: block;
      margin-top: 2px;
      font: 600 .5625rem/1.2 var(--sans);
      letter-spacing: .18em;
      color: var(--muted);
    }
    .header-actions {
      display: flex;
      align-items: center;
      gap: var(--s3);
    }
    .docket-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: var(--xs);
      font-weight: 600;
      color: var(--sage-ink);
      background: var(--sage);
      border: 1px solid var(--line);
      padding: 5px 12px;
      border-radius: var(--pill);
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--s1);
      font-size: var(--xs);
      font-weight: 600;
      color: var(--muted);
      padding: 6px 12px;
      border-radius: var(--pill);
      background: var(--surface);
      border: 1px solid var(--line);
      transition: color var(--fast), border-color var(--fast);
      cursor: pointer;
      text-decoration: none;
    }
    .back-link:hover {
      color: var(--ink);
      border-color: var(--control-line);
    }

    /* Checkout Main Layout */
    .checkout-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: var(--s5) var(--s3) var(--s8);
    }
    .checkout-wrap {
      width: min(450px, 100%);
      margin: 0 auto;
    }
    .action-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-card);
      box-shadow: var(--shadow);
      overflow: hidden;
    }
    .journey {
      display: flex;
      gap: var(--s4);
      margin: 0;
      padding: var(--s3) var(--s5);
      background: var(--sage);
      list-style: none;
      border-bottom: 1px solid var(--line);
      font-size: .6875rem;
    }
    .journey li {
      display: flex;
      align-items: center;
      gap: var(--s2);
      color: var(--muted);
      white-space: nowrap;
    }
    .journey li[aria-current="step"] {
      color: var(--green);
      font-weight: 700;
    }
    .journey li > span {
      display: grid;
      place-items: center;
      width: 20px;
      height: 20px;
      border: 1px solid var(--control-line);
      border-radius: 50%;
      font-size: var(--xs);
    }
    .journey li.completed > span {
      background: var(--green);
      color: var(--surface);
      border-color: var(--green);
    }
    .journey li[aria-current="step"] > span {
      background: var(--green);
      color: var(--surface);
      border-color: var(--green);
    }
    .panel {
      padding: var(--s5) var(--s5);
    }
    .receipt {
      display: inline-flex;
      gap: var(--s2);
      align-items: center;
      font-size: .75rem;
      font-weight: 700;
      color: #1e7e34;
      margin-bottom: var(--s3);
      background: #eef8f1;
      padding: 4px 10px;
      border-radius: var(--radius-card);
    }
    .receipt .icon {
      width: 13px;
      height: 13px;
    }
    .panel h1, .panel h2 {
      font-family: var(--serif);
      font-size: 1.875rem;
      font-weight: 400;
      letter-spacing: -.03em;
      line-height: 1.15;
      color: var(--ink);
      margin-bottom: var(--s2);
    }
    .panel-copy {
      color: var(--muted);
      font-size: var(--sm);
      line-height: 1.5;
      margin-bottom: var(--s4);
    }

    /* Sponsorship Summary Bar */
    .sponsorship-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: var(--s3) var(--s4);
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      margin-bottom: var(--s3);
    }
    .sponsorship-amt-block {
      display: flex;
      align-items: baseline;
      gap: var(--s2);
    }
    .sponsorship-amt {
      font-size: 1.625rem;
      font-weight: 700;
      color: var(--green);
      letter-spacing: -.02em;
      line-height: 1;
    }
    .sponsorship-cadence {
      font-size: var(--xs);
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: .08em;
    }
    .sponsorship-edit-link {
      font-size: var(--xs);
      font-weight: 600;
      color: var(--green);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    /* Purpose Card */
    .gift-purpose {
      display: flex;
      align-items: flex-start;
      gap: var(--s2);
      padding: var(--s3);
      margin-bottom: var(--s4);
      background: var(--paper);
      border-radius: var(--radius);
      font-size: var(--xs);
      line-height: 1.45;
      color: var(--ink);
    }
    .gift-purpose .icon {
      width: 20px;
      height: 20px;
      color: var(--green);
      flex-shrink: 0;
      margin-top: 1px;
    }

    /* Tip Module */
    .tip-section {
      margin-bottom: var(--s4);
      padding-top: var(--s3);
      border-top: 1px solid var(--line);
    }
    .tip-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 4px;
    }
    .tip-label {
      font-size: var(--xs);
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .tip-badge {
      font-size: .625rem;
      font-weight: 600;
      color: var(--muted);
      background: var(--paper);
      border: 1px solid var(--line);
      padding: 2px 6px;
      border-radius: var(--pill);
    }
    .tip-explainer {
      font-size: var(--xs);
      color: var(--muted);
      line-height: 1.45;
      margin-bottom: var(--s2);
    }
    .tip-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 5px;
    }
    .tip-btn {
      padding: 7px 2px;
      text-align: center;
      border-radius: var(--radius);
      border: 1.5px solid var(--line);
      background: var(--surface);
      color: var(--muted);
      transition: all var(--fast);
      cursor: pointer;
    }
    .tip-btn:hover {
      border-color: var(--control-line);
      background: var(--paper);
    }
    .tip-btn.active {
      background: var(--sage);
      border-color: var(--green);
      color: var(--green);
      font-weight: 700;
    }
    .tip-pct {
      display: block;
      font-size: var(--xs);
      font-weight: 700;
      line-height: 1.2;
    }
    .tip-sub {
      display: block;
      font-size: .5625rem;
      line-height: 1.2;
      margin-top: 2px;
      opacity: 0.85;
      white-space: pre-line;
    }
    .custom-tip-wrap {
      position: relative;
      display: flex;
      align-items: center;
      margin-top: var(--s2);
    }
    .custom-prefix {
      position: absolute;
      left: var(--s3);
      font-size: var(--xs);
      font-weight: 700;
      color: var(--muted);
      pointer-events: none;
    }
    .custom-tip-input {
      width: 100%;
      min-height: 40px;
      padding: 0.4rem var(--s3) 0.4rem calc(var(--s3) + 12px);
      color: var(--ink);
      background: var(--surface);
      border: 1.5px solid var(--control-line);
      border-radius: var(--radius);
      font-size: 15px;
    }

    /* Form Fields */
    .name-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--s2);
      margin-top: var(--s4);
      margin-bottom: var(--s3);
    }
    .field {
      min-width: 0;
    }
    .field label {
      display: block;
      font-size: var(--xs);
      font-weight: 600;
      margin-bottom: 4px;
      color: var(--ink);
    }
    .field input {
      width: 100%;
      min-height: 42px;
      min-width: 0;
      padding: 0.45rem var(--s3);
      color: var(--ink);
      background: var(--surface);
      border: 1.5px solid var(--control-line);
      border-radius: var(--radius);
      font-size: 15px;
      line-height: 1.4;
    }
    .field input:focus, .custom-tip-input:focus, .StripeElement--focus {
      border-color: var(--green) !important;
      outline: none !important;
      box-shadow: 0 0 0 2px rgba(45, 81, 64, 0.15) !important;
    }

    /* Payment Element Area */
    .payment-divider {
      display: flex;
      align-items: center;
      text-align: center;
      margin: var(--s4) 0 var(--s3);
    }
    .payment-divider::before, .payment-divider::after {
      content: '';
      flex: 1;
      border-bottom: 1px solid var(--line);
    }
    .payment-divider span {
      padding: 0 var(--s3);
      font-size: .625rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: var(--muted);
    }
    .payment-loader {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: var(--s6) 0;
    }
    .clean-loader-ring {
      width: 32px;
      height: 32px;
      border: 2.5px solid var(--sage);
      border-top-color: var(--green);
      border-radius: 50%;
      animation: cleanSpin 0.9s linear infinite;
      margin-bottom: var(--s2);
    }
    @keyframes cleanSpin { to { transform: rotate(360deg); } }

    /* Action Buttons */
    .button {
      min-height: 48px;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: var(--s2);
      width: 100%;
      padding: var(--s2) var(--s4);
      border: 1px solid transparent;
      border-radius: var(--radius);
      font-size: var(--sm);
      font-weight: 700;
      text-align: center;
      text-decoration: none;
      transition: background var(--fast), transform var(--fast);
      cursor: pointer;
    }
    .button.primary {
      background: var(--green);
      color: var(--surface);
      margin-top: var(--s4);
    }
    .button.primary:hover:not(:disabled) {
      background: var(--green-hover);
      transform: translateY(-1px);
    }
    .button.primary:active:not(:disabled) {
      background: var(--green-active);
    }
    .button.primary:disabled {
      background: var(--disabled);
      color: var(--muted);
      cursor: not-allowed;
      transform: none;
    }
    .button.quiet {
      background: transparent;
      color: var(--muted);
      text-decoration: underline;
      text-underline-offset: 3px;
      margin-top: var(--s2);
      font-size: var(--xs);
      font-weight: 500;
    }
    .button.quiet:hover {
      color: var(--green);
    }
    .spinner {
      width: 18px;
      height: 18px;
      animation: cleanSpin 0.9s linear infinite;
    }
    .spinner-track { opacity: 0.25; }
    .spinner-head { opacity: 0.75; }

    /* Reassurance row */
    .reassurance {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--s2);
      color: var(--muted);
      font-size: .6875rem;
      line-height: 1.4;
      margin-top: var(--s3);
      text-align: center;
    }
    .reassurance .icon {
      width: 13px;
      height: 13px;
      color: var(--green);
      flex-shrink: 0;
    }
    .descriptor-notice {
      margin-top: var(--s2);
      font-size: .6875rem;
      color: var(--muted);
      text-align: center;
      line-height: 1.4;
    }
    .descriptor-notice strong {
      color: var(--ink);
      font-weight: 700;
      letter-spacing: .03em;
    }

    /* Error Box */
    .payment-error-box {
      margin-top: var(--s3);
      padding: var(--s3);
      background: #fdf2f2;
      border: 1px solid #f8b4b4;
      border-radius: var(--radius);
      color: #9b1c1c;
      font-size: var(--xs);
      line-height: 1.4;
    }

    /* Footer */
    .checkout-footer {
      text-align: center;
      margin-top: var(--s4);
      padding: 0 var(--s2);
    }
    .legal-links {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: var(--s2);
      font-size: var(--xs);
      color: var(--muted);
      margin-bottom: var(--s2);
    }
    .legal-links button {
      background: none;
      border: none;
      padding: 0;
      color: var(--muted);
      text-decoration: underline;
      text-underline-offset: 2px;
      cursor: pointer;
      font-size: var(--xs);
    }
    .legal-links button:hover {
      color: var(--ink);
    }
    .checkout-footer p {
      font-size: .6875rem;
      color: var(--muted);
      line-height: 1.4;
    }

    /* Success Screen */
    .success-header {
      background: var(--sage);
      padding: var(--s6) var(--s5) var(--s5);
      text-align: center;
      border-bottom: 1px solid var(--line);
    }
    .completion-mark {
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--green);
      color: var(--surface);
      margin: 0 auto var(--s3);
    }
    .completion-mark .icon {
      width: 24px;
      height: 24px;
    }
    .success-summary-box {
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: var(--s4);
      margin-bottom: var(--s3);
    }
    .success-docket-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: .625rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--muted);
      margin-bottom: var(--s2);
    }
    .success-amount-display {
      font-family: var(--serif);
      font-size: 2.25rem;
      font-weight: 400;
      color: var(--green);
      line-height: 1;
      margin-bottom: 4px;
    }
    .notice {
      font-size: var(--xs);
      color: var(--muted);
      background: var(--paper);
      border: 1px solid var(--line);
      padding: var(--s3);
      border-radius: var(--radius);
      line-height: 1.5;
    }
    .success-tip-note {
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: var(--s3);
      margin-top: var(--s3);
      font-size: var(--xs);
      color: var(--muted);
      line-height: 1.45;
    }
    .success-actions {
      display: flex;
      flex-direction: column;
      gap: var(--s2);
      margin-top: var(--s4);
    }

    /* Legal Modal */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: rgba(38, 62, 51, 0.6);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--s4);
    }
    .modal-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-card);
      box-shadow: 0 16px 40px rgba(0,0,0,0.15);
      width: min(500px, 100%);
      max-height: 80vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: var(--s3) var(--s4);
      background: var(--paper);
      border-bottom: 1px solid var(--line);
    }
    .modal-header h3 {
      font-size: var(--sm);
      font-weight: 700;
      color: var(--ink);
    }
    .modal-close {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: var(--sage);
      border: none;
      display: grid;
      place-items: center;
      cursor: pointer;
      color: var(--ink);
    }
    .modal-body {
      padding: var(--s4);
      overflow-y: auto;
      font-size: var(--xs);
      color: var(--muted);
      line-height: 1.6;
    }

    @media (max-width: 440px) {
      .panel { padding: var(--s4) var(--s3); }
      .name-grid { grid-template-columns: 1fr; }
      .tip-grid { gap: 3px; }
      .tip-sub { font-size: .5rem; }
      .header-actions .docket-badge { display: none; }
    }
  </style>
</head>
<body>

  <!-- CLEAN SITE HEADER (Exact match to petition) -->
  <header class="site-header">
    <div class="header-inner">
      <a href="<%= campaignOrigin ? (campaignOrigin + '/petition') : '#' %>" class="brand" aria-label="Frontline Calf Rescue home">
        <svg class="brand-mark" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 28V12M16 20C4 20 4 6 4 6s12 0 12 14ZM16 15C16 5 28 5 28 5s0 10-12 10Z"/>
        </svg>
        <span>Frontline<span class="brand-sub">CALF RESCUE</span></span>
      </a>
      <div class="header-actions">
        <span class="docket-badge">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Docket #AGR-2026-884
        </span>
        <% if (campaignOrigin) { %>
        <a href="<%= campaignOrigin %>/petition#action" class="back-link">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span>Return to petition</span>
        </a>
        <% } else { %>
        <button onclick="if(history.length>1){history.back()}else{window.close()}" class="back-link">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span>Back</span>
        </button>
        <% } %>
      </div>
    </div>
  </header>

  <!-- MAIN CHECKOUT AREA -->
