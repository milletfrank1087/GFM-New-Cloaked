      <!-- INSTITUTIONAL FOOTER LINKS -->
      <footer id="checkout-disclaimer" class="checkout-footer">
        <div class="legal-links">
          <button type="button" onclick="showLegalModal('/terms','Terms of Civic Inscription')">Terms of Inscription</button>
          <span>·</span>
          <button type="button" onclick="showLegalModal('/privacy','Donor Privacy Protection')">Privacy Policy</button>
