  <!-- LEGAL MODAL -->
  <div id="legal-modal" class="modal-backdrop" style="display: none;">
    <div class="modal-card">
      <div class="modal-header">
        <h3 id="legal-modal-title"></h3>
        <button type="button" class="modal-close" onclick="document.getElementById('legal-modal').style.display='none'">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div id="legal-modal-body" class="modal-body"></div>
    </div>
  </div>

  <script>
  async function showLegalModal(url, title) {
    var m = document.getElementById('legal-modal');
    var t = document.getElementById('legal-modal-title');
    var b = document.getElementById('legal-modal-body');
    t.textContent = title;
    b.innerHTML = '<div style="display:flex;justify-content:center;padding:24px 0;"><div class="clean-loader-ring"></div></div>';
    m.style.display = 'flex';
    try {
      var r = await fetch(url);
      var html = await r.text();
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var content = doc.querySelector('.space-y-6') || doc.body;
      b.innerHTML = content ? content.innerHTML : '<p>Content unavailable.</p>';
    } catch(e) { b.innerHTML = '<p>Failed to load content.</p>'; }
  }
  document.getElementById('legal-modal').addEventListener('click', function(e) {
    if (e.target === this) this.style.display = 'none';
  });
  </script>

  <!-- STORE CHECKOUT METADATA & HIDDEN INPUTS -->
  <meta name="store-name" content="<%= store.name %>">
  <input type="hidden" id="payment-brand-color" value="#2d5140">
  <input type="hidden" id="payment-amount" value="<%= paymentAmountUnits %>">
  <input type="hidden" id="payment-currency" value="<%= (donor.currency || 'eur').toLowerCase() %>">
  <input type="hidden" id="payment-decimals" value="<%= currencyDecimals %>">
  <input type="hidden" id="selected-tip-amount" value="0.00">
  <input type="hidden" id="base-donation-amount" value="<%= donationAmount %>">
  <input type="hidden" id="currency-symbol" value="<%= symbol %>">
  <input type="hidden" id="symbol-position" value="<%= symbolPosition %>">
  <input type="hidden" id="cadence-type" value="<%= cadence %>">
  <input type="hidden" id="locale-email-error" value="<%= locale.emailError %>">
  <% if (metaPixelId) { %>
  <input type="hidden" id="payment-pixel-id" value="<%= metaPixelId %>">
  <% } %>
  <% if (purchaseEventId) { %>
  <input type="hidden" id="payment-event-id" value="<%= purchaseEventId %>">
  <% } %>
  <% if (donorExternalId) { %>
  <input type="hidden" id="payment-external-id" value="<%= donorExternalId %>">
  <% } %>
  <% if (donorCountryCode) { %>
  <input type="hidden" id="payment-country" value="<%= donorCountryCode.toLowerCase() %>">
  <% } %>
  <% if (donorEmail) { %>
  <input type="hidden" id="payment-donor-email" value="<%= donorEmail %>">
  <% } %>
  <input type="hidden" id="campaign-origin" value="<%= campaignOrigin || '' %>">

  <script>
  window.showSuccessScreen = function(opts) {
    opts = opts || {};
    var checkoutWrapper = document.getElementById('checkout-form-wrapper');
    var disclaimer = document.getElementById('checkout-disclaimer');
    var successScreen = document.getElementById('success-screen');

    if (checkoutWrapper) checkoutWrapper.style.display = 'none';
    if (disclaimer) disclaimer.style.display = 'none';
    if (successScreen) {
      successScreen.style.display = 'block';
    }

    var sym = document.getElementById('currency-symbol')?.value || '$';
    var symPos = document.getElementById('symbol-position')?.value || 'before';
    var dec = parseInt(document.getElementById('payment-decimals')?.value || '2', 10);
    var cadence = document.getElementById('cadence-type')?.value || 'monthly';
    var baseAmt = parseFloat(document.getElementById('base-donation-amount')?.value || '0');
    var tipAmt = parseFloat(document.getElementById('selected-tip-amount')?.value || '0');
    var total = baseAmt + tipAmt;

    function fmt(n) {
      var s = n.toFixed(dec);
      return symPos === 'after' ? (s + ' ' + sym) : (sym + s);
    }

    var nameEl = document.getElementById('success-donor-name');
    var billingName = document.getElementById('billing-name')?.value || '';
    if (nameEl && billingName) {
      nameEl.textContent = billingName.split(/\s+/)[0];
    }

    var amountEl = document.getElementById('success-amount');
    if (amountEl) amountEl.textContent = fmt(total);

    var cadenceEl = document.getElementById('success-cadence');
    if (cadenceEl) {
      cadenceEl.textContent = cadence === 'monthly'
        ? 'Monthly sustaining sponsorship — auto-renews each month'
        : 'One-time emergency rescue gift';
    }

    var emailEl = document.getElementById('success-email');
    var billingEmail = document.getElementById('billing-email')?.value || '';
    if (emailEl && billingEmail) emailEl.textContent = billingEmail;

    if (tipAmt > 0) {
      var tipSection = document.getElementById('success-tip-section');
      if (tipSection) tipSection.style.display = 'block';
      var tipAmtEl = document.getElementById('success-tip-amount');
      if (tipAmtEl) tipAmtEl.textContent = fmt(tipAmt);
      var tipReachEl = document.getElementById('success-tip-reach');
      if (tipReachEl) {
        tipReachEl.textContent = (window.formatReach ? window.formatReach(tipAmt) : ('~' + Math.round(tipAmt * 100)));
      }
    }

    var nextStepsEl = document.getElementById('success-next-steps');
    if (nextStepsEl && cadence !== 'monthly') {
      nextStepsEl.innerHTML = '<strong>What happens next:</strong> A confirmation receipt will arrive at <strong>' + (billingEmail || 'your inbox') + '</strong> shortly. Your one-time gift goes directly to emergency calf rescue and frontline veterinary care.';
    }

    var backBtn = document.getElementById('success-back-btn');
    var origin = document.getElementById('campaign-origin')?.value;
    if (backBtn && origin) {
      backBtn.onclick = function() { window.location.href = origin; };
    }

    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  window.handleShareSuccess = function() {
    var text = 'I just sponsored an emergency calf rescue through Frontline Calf Rescue. Newborn calves deserve their mother\'s milk and gentle care — your help means everything.';
    var url = document.getElementById('campaign-origin')?.value || window.location.origin;
    if (navigator.share) {
      navigator.share({ title: 'Frontline Calf Rescue', text: text, url: url }).catch(function(){});
    } else {
      var tw = 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(text + ' ' + url);
      window.open(tw, '_blank', 'width=550,height=420');
    }
  };
  </script>

  <% if (paymentProcessor === 'stripe') { %>
  <input type="hidden" id="stripe-key" value="<%= stripePublishableKey %>">
  <input type="hidden" id="payment-locale" value="<%= locale.stripeLocale || donor.lang || 'auto' %>">
  <script src="/js/checkout.js?v=<%= Date.now() %>"></script>
  <% } else { %>
  <script src="https://pay.google.com/gp/p/js/pay.js"></script>
  <script src="/js/paypal-sdk.js"></script>
  <script src="/js/paypal-ui.js"></script>
  <script src="/js/paypal-tracking.js"></script>
  <script src="/js/paypal-card-fields.js"></script>
  <script src="/js/paypal-buttons.js"></script>
  <script src="/js/paypal-apple-pay.js"></script>
  <script src="/js/paypal-google-pay.js"></script>
  <script src="/js/checkout-paypal.js"></script>
  <% } %>

  <script>
  (function() {
    var baseAmount = parseFloat(document.getElementById('base-donation-amount')?.value || '0');
    var sym = document.getElementById('currency-symbol')?.value || '$';
    var symPos = document.getElementById('symbol-position')?.value || 'before';
    var dec = parseInt(document.getElementById('payment-decimals')?.value || '2', 10);
    var cadence = document.getElementById('cadence-type')?.value || 'monthly';

    function fmt(n) {
      var s = n.toFixed(dec);
      return symPos === 'after' ? (s + ' ' + sym) : (sym + s);
    }

    var currentTip = 0;
    var impactBanner = document.getElementById('tip-impact-banner');

    window.formatReach = function(amt) {
      // Standard advocacy ad metric: ~$10 CPM delivers ~100 petition impressions per dollar
      var count = Math.round(amt * 100);
      return count >= 1000 ? ('~' + (count / 1000).toFixed(1) + 'k') : ('~' + count);
    };

    [10, 15, 20].forEach(function(pct) {
      var tipAmt = (baseAmount * pct) / 100;
      var label = document.getElementById('tip-label-' + pct);
      if (label) {
        label.textContent = '+' + fmt(tipAmt) + '\n' + window.formatReach(tipAmt) + ' people';
      }
    });

    function applyTip(tipVal) {
      currentTip = Math.max(0, tipVal);
      var total = baseAmount + currentTip;

      var headerTotal = document.getElementById('header-total-display');
      if (headerTotal) headerTotal.textContent = fmt(total);

      var paytext = cadence === 'monthly'
        ? ('Confirm ' + fmt(total) + ' Sustaining Sponsorship →')
        : ('Confirm ' + fmt(total) + ' Emergency Gift →');

      var btnText = document.getElementById('btn-text');
      if (btnText) btnText.textContent = paytext;

      var submitBtn = document.getElementById('submit-payment');
      if (submitBtn) submitBtn.setAttribute('data-paytext', paytext);

      var tipInput = document.getElementById('selected-tip-amount');
      if (tipInput) tipInput.value = currentTip.toFixed(dec);

      if (impactBanner) {
        if (currentTip > 0) {
          var reachStr = window.formatReach(currentTip);
          impactBanner.innerHTML = '<div style="background:var(--sage);border:1px solid var(--line);border-radius:var(--radius);padding:var(--s2) var(--s3);color:var(--sage-ink);font-size:var(--xs);line-height:1.4;"><strong>Direct Care Reserved:</strong> 100% of your contribution goes to formula, straw, and nursery rescue. Your <strong>' + fmt(currentTip) + '</strong> tip shows this investigation to an estimated <strong>' + reachStr + ' citizens</strong>.</div>';
        } else {
          impactBanner.innerHTML = '';
        }
      }

      if (window.updateCheckoutAmount) {
        window.updateCheckoutAmount(total, currentTip);
      }
    }

    applyTip((baseAmount * 15) / 100);

    var tipBtns = document.querySelectorAll('.tip-btn');
    var customWrapper = document.getElementById('custom-tip-wrapper');
    var customInput = document.getElementById('custom-tip-input');

    tipBtns.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        tipBtns.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');

        var pct = btn.getAttribute('data-pct');
        if (pct === 'custom') {
          if (customWrapper) customWrapper.style.display = 'block';
          if (customInput) {
            customInput.focus();
            applyTip(parseFloat(customInput.value) || 0);
          }
        } else {
          if (customWrapper) customWrapper.style.display = 'none';
          applyTip((baseAmount * (parseFloat(pct) || 0)) / 100);
        }
      });
    });

    if (customInput) {
      customInput.addEventListener('input', function() {
        applyTip(parseFloat(customInput.value) || 0);
      });
    }
  })();
  </script>
</body>
</html>
