            </svg>
            <span id="btn-text">
              <%= cadence === 'monthly' ? ('Confirm ' + formattedTotal + ' Sustaining Sponsorship →') : ('Confirm ' + formattedTotal + ' Emergency Gift →') %>
            </span>
          </button>

          <!-- Reassurance -->
          <p class="reassurance">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            Secure 256-bit encrypted checkout. You remain in full control.
          </p>

          <p class="descriptor-notice">
            Charges will appear on your statement as <strong>RISEHOPE</strong>.
