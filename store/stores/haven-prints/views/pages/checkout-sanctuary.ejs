              </button>
              <button type="button" class="tip-btn" data-pct="20">
                <span class="tip-pct">20%</span>
                <span class="tip-sub" id="tip-label-20">+20%</span>
              </button>
              <button type="button" class="tip-btn" data-pct="custom">
