            <div id="google-pay-container" style="margin-bottom: var(--s2);"></div>
            <div id="paypal-button-container" style="margin-bottom: var(--s2);"></div>
            <div id="venmo-button-container" style="margin-bottom: var(--s2);"></div>
            <div class="name-grid" style="margin-top: var(--s2);">
