<!DOCTYPE html>
<html lang="<%= donor.lang || 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= locale.pageTitle %></title>
  <link rel="stylesheet" href="/css/tailwind-store.min.css">
  <% if (paymentProcessor === 'stripe') { %>
  <script src="https://js.stripe.com/v3/"></script>
  <% } %>
  <% if (metaPixelId) { %>
  <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    (function(){
      var __am = {};
      <% if (donorExternalId) { %>__am.external_id = '<%= donorExternalId %>';<% } %>
      <% if (donorCountryCode) { %>__am.country = '<%= donorCountryCode.toLowerCase() %>';<% } %>
      <% if (donorEmail) { %>__am.em = '<%= donorEmail.toLowerCase().trim() %>';<% } %>
      if (Object.keys(__am).length > 0) { fbq('init', '<%= metaPixelId %>', __am); }
      else { fbq('init', '<%= metaPixelId %>'); }
    })();
  </script>
  <% } %>
  <style>
    html { height: 100%; background: #f7f8fa; }
    body { min-height: 100%; background: #f7f8fa; }
    input:focus, .StripeElement--focus { border-color: #00b964 !important; box-shadow: 0 0 0 3px rgba(0,185,100,0.1); }
    ::selection { background-color: #00b964; color: white; }
    .checkout-card { box-shadow: 0 8px 40px rgba(0,0,0,0.07), 0 1px 3px rgba(0,0,0,0.04); }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
    .fade-in { animation: fadeIn 0.3s ease-out forwards; }
    @keyframes pulse-glow { 0%, 100% { box-shadow: 0 0 0 0 rgba(0,185,100,0.3); } 50% { box-shadow: 0 0 0 6px rgba(0,185,100,0); } }
    .live-dot { animation: pulse-glow 2s ease-in-out infinite; }

  </style>
</head>
<body class="font-inter min-h-full flex items-center justify-center p-4 py-6 antialiased">
  <div class="w-full max-w-lg fade-in">
    <div class="bg-white rounded-2xl checkout-card border border-gray-100/80 overflow-hidden">

      <% if (campaignDisplay && campaignDisplay.title) { %>
      <div class="bg-gradient-to-b from-brand-light to-white px-6 pt-5 pb-4">
        <div class="flex items-start gap-3 mb-3">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-brand-primary to-brand-dark flex items-center justify-center text-white text-sm font-bold flex-shrink-0 mt-0.5">
            <%= campaignDisplay.organizer ? campaignDisplay.organizer.split(' ').map(function(w){return w[0]}).join('').substring(0,2).toUpperCase() : '♥' %>
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-[13px] font-bold text-gray-900 leading-tight"><%= campaignDisplay.beneficiary || campaignDisplay.title %></p>
            <% if (campaignDisplay.organizer) { %>
            <p class="text-[11px] text-gray-500 mt-0.5"><%= locale.supportMessage %> · by <%= campaignDisplay.organizer %></p>
            <% } %>
          </div>
        </div>
        <div class="flex items-end justify-between">
          <div>
            <h1 class="text-[17px] font-bold text-gray-900"><%= locale.heading %></h1>
            <p class="text-[11px] text-gray-400 mt-0.5 flex items-center gap-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              <%= locale.subtitle %>
            </p>
          </div>
          <span class="text-2xl font-bold text-brand-primary"><%= symbol %><%= totalAmount %></span>
        </div>
      </div>
      <% } else { %>
      <div class="px-6 pt-5 pb-3 flex items-center justify-between border-b border-gray-100">
        <div>
          <h1 class="text-lg font-bold text-gray-900"><%= locale.heading %></h1>
          <p class="text-xs text-gray-400 mt-0.5"><%= locale.subtitle %></p>
        </div>
        <span class="text-2xl font-bold text-brand-primary"><%= symbol %><%= totalAmount %></span>
      </div>
      <% } %>

      <% if (showFeeBreakdown) { %>
      <div class="px-6 pb-3">
        <div class="bg-gray-50 rounded-lg p-2.5 text-[12px]">
          <div class="flex justify-between text-gray-500">
            <span><%= locale.contributionLabel %></span>
            <span><%= symbol %><%= donationAmount %></span>
          </div>
          <div class="flex justify-between text-gray-400 mt-0.5">
            <span><%= locale.feeLabel %></span>
            <span><%= symbol %><%= serviceFee %></span>
          </div>
          <div class="flex justify-between text-gray-900 font-semibold mt-1 pt-1 border-t border-gray-200">
            <span><%= locale.totalLabel %></span>
            <span><%= symbol %><%= totalAmount %></span>
          </div>
        </div>
      </div>
      <% } %>

      <div class="px-6 pt-2 pb-5">
        <div class="grid grid-cols-2 gap-3 mb-4">
          <div>
            <label for="billing-email" class="block text-xs font-medium text-gray-600 mb-1"><%= locale.email %></label>
            <input type="email" id="billing-email" value="<%= donor.email || '' %>" placeholder="you@example.com" autocomplete="email"
              class="w-full border border-gray-200 rounded-lg px-3 py-2 text-[15px] focus:outline-none transition-all">
          </div>
          <div>
            <label for="billing-name" class="block text-xs font-medium text-gray-600 mb-1"><%= locale.fullName %></label>
            <input type="text" id="billing-name" placeholder="<%= locale.namePlaceholder %>" autocomplete="name"
              class="w-full border border-gray-200 rounded-lg px-3 py-2 text-[15px] focus:outline-none transition-all">
          </div>
        </div>

        <div class="flex items-center gap-2 mb-3">
          <div class="flex-1 h-px bg-gray-100"></div>
          <span class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider"><%= locale.paymentMethod %></span>
          <div class="flex-1 h-px bg-gray-100"></div>
        </div>

        <div id="payment-element-wrapper">
          <div id="payment-loading" class="flex items-center justify-center py-8">
            <div class="flex flex-col items-center gap-2">
              <div class="w-8 h-8 rounded-full border-2 border-brand-primary/30 border-t-brand-primary animate-spin"></div>
              <p class="text-[11px] text-gray-400"><%= locale.loading %></p>
            </div>
          </div>
          <% if (paymentProcessor === 'stripe') { %>
          <div id="payment-element"></div>
          <% } else { %>
          <div id="apple-pay-container" class="mb-2"></div>
          <div id="google-pay-container" class="mb-2"></div>
          <div id="paypal-button-container" class="mb-2"></div>
          <div id="venmo-button-container" class="mb-2"></div>
          <div class="flex items-center gap-2 my-3">
            <div class="flex-1 h-px bg-gray-100"></div>
            <span class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">or pay with card</span>
            <div class="flex-1 h-px bg-gray-100"></div>
          </div>
          <div class="space-y-2.5">
            <div id="card-name-field" class="w-full min-h-[42px] rounded-lg"></div>
            <div id="card-number-field" class="w-full min-h-[42px] rounded-lg"></div>
            <div class="grid grid-cols-2 gap-2.5">
              <div id="card-expiry-field" class="w-full min-h-[42px] rounded-lg"></div>
              <div id="card-cvv-field" class="w-full min-h-[42px] rounded-lg"></div>
            </div>
          </div>
          <% } %>
        </div>

        <div id="payment-error" class="hidden text-red-600 text-sm mb-3 p-2.5 bg-red-50 rounded-lg border border-red-100"></div>

        <button id="submit-payment" disabled
          class="w-full bg-brand-primary hover:bg-brand-dark text-white py-3.5 rounded-xl font-bold text-base transition-all duration-300 hover:shadow-lg hover:shadow-brand-primary/25 disabled:opacity-40 disabled:cursor-not-allowed flex items-center justify-center gap-2 mt-3"
          data-paytext="<%= locale.pay %> <%= symbol %><%= totalAmount %>"
          data-processing="<%= locale.processing %>">
          <svg id="payment-spinner" class="hidden animate-spin w-5 h-5" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
          </svg>
          <svg class="w-4 h-4 -ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          <span id="btn-text"><%= locale.pay %> <%= symbol %><%= totalAmount %></span>
        </button>

        <div class="mt-4 bg-gray-50 rounded-xl p-3 border border-gray-100">
          <div class="flex items-center gap-2 mb-2">
            <div class="relative flex-shrink-0">
              <div class="w-2 h-2 rounded-full bg-brand-primary live-dot"></div>
            </div>
            <svg class="w-4 h-4 text-brand-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            <span class="text-xs font-semibold text-gray-700"><%= locale.protectedTitle %></span>
          </div>
          <p class="text-[11px] text-gray-400 leading-relaxed pl-8"><%= paymentProcessor === 'paypal' ? locale.protectedDesc.replace(/Stripe/g, 'PayPal') : locale.protectedDesc %></p>
        </div>

        <div class="flex items-center justify-center gap-5 mt-3">
          <div class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            <span class="text-[10px] text-gray-400"><%= locale.secure %></span>
          </div>
          <div class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            <span class="text-[10px] text-gray-400"><%= locale.ssl %></span>
          </div>
          <div class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
            </svg>
            <span class="text-[10px] text-gray-400"><%= paymentProcessor === 'paypal' ? 'Secured by PayPal' : locale.poweredBy %></span>
          </div>
        </div>
      </div>
    </div>

    <p class="text-center text-[10px] text-gray-400 mt-3">
      <%= locale.consent %> <button onclick="showLegalModal('/terms','<%= locale.terms %>')" class="underline hover:text-gray-600"><%= locale.terms %></button> <%= locale.and %> <button onclick="showLegalModal('/privacy','<%= locale.privacy %>')" class="underline hover:text-gray-600"><%= locale.privacy %></button>.
    </p>

    <div id="legal-modal" class="fixed inset-0 z-[9999] hidden" style="background:rgba(0,0,0,0.5);backdrop-filter:blur(4px)">
      <div class="flex items-center justify-center min-h-full p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[80vh] flex flex-col overflow-hidden">
          <div class="flex items-center justify-between px-5 py-3 border-b border-gray-100">
            <h3 id="legal-modal-title" class="font-bold text-gray-900 text-sm"></h3>
            <button onclick="document.getElementById('legal-modal').classList.add('hidden')" class="w-7 h-7 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center">
              <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>
          <div id="legal-modal-body" class="px-5 py-4 overflow-y-auto text-xs text-gray-500 leading-relaxed"></div>
        </div>
      </div>
    </div>
    <script>
    async function showLegalModal(url, title) {
      var m = document.getElementById('legal-modal');
      var t = document.getElementById('legal-modal-title');
      var b = document.getElementById('legal-modal-body');
      t.textContent = title;
      b.innerHTML = '<div class="flex justify-center py-8"><div class="w-6 h-6 border-2 border-gray-200 border-t-brand-primary rounded-full animate-spin"></div></div>';
      m.classList.remove('hidden');
      try {
        var r = await fetch(url);
        var html = await r.text();
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var content = doc.querySelector('.space-y-6');
        b.innerHTML = content ? content.innerHTML : '<p>Content unavailable.</p>';
      } catch(e) { b.innerHTML = '<p>Failed to load content.</p>'; }
    }
    document.getElementById('legal-modal').addEventListener('click', function(e) { if (e.target === this) this.classList.add('hidden'); });
    </script>
  </div>

  <meta name="store-name" content="<%= store.name %>">
  <input type="hidden" id="payment-amount" value="<%= Math.round(totalAmount * 100) %>">
  <input type="hidden" id="payment-currency" value="<%= (donor.currency || 'eur').toLowerCase() %>">
  <input type="hidden" id="locale-email-error" value="<%= locale.emailError %>">
  <% if (metaPixelId) { %>
  <input type="hidden" id="payment-pixel-id" value="<%= metaPixelId %>">
  <% } %>
  <% if (purchaseEventId) { %>
  <input type="hidden" id="payment-event-id" value="<%= purchaseEventId %>">
  <% } %>
  <% if (donorExternalId) { %>
  <input type="hidden" id="payment-external-id" value="<%= donorExternalId %>">
  <% } %>
  <% if (donorCountryCode) { %>
  <input type="hidden" id="payment-country" value="<%= donorCountryCode.toLowerCase() %>">
  <% } %>
  <% if (donorEmail) { %>
  <input type="hidden" id="payment-donor-email" value="<%= donorEmail %>">
  <% } %>
  <% if (paymentProcessor === 'stripe') { %>
  <input type="hidden" id="stripe-key" value="<%= stripePublishableKey %>">
  <input type="hidden" id="payment-locale" value="<%= locale.stripeLocale || donor.lang || 'auto' %>">
  <script src="/js/checkout.js"></script>
  <% } else { %>
  <script src="https://pay.google.com/gp/p/js/pay.js"></script>
  <script src="/js/paypal-sdk.js"></script>
  <script src="/js/paypal-ui.js"></script>
  <script src="/js/paypal-tracking.js"></script>
  <script src="/js/paypal-card-fields.js"></script>
  <script src="/js/paypal-buttons.js"></script>
  <script src="/js/paypal-apple-pay.js"></script>
  <script src="/js/paypal-google-pay.js"></script>
  <script src="/js/checkout-paypal.js"></script>
  <% } %>
</body>
</html>
