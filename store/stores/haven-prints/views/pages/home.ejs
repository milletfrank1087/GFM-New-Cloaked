      <div>
        <p class="text-xl sm:text-2xl font-bold text-gray-900">4.8</p>
        <p class="text-xs text-gray-400 mt-0.5">Avg. rating</p>
      </div>
    </div>
  </div>
</section>

<section id="products" class="py-12 md:py-16 scroll-mt-16">
