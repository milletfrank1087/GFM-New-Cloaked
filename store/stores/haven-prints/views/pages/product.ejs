<% const pageTitle = product.name; const extraHead = ''; %>
<%- include('../layouts/store', { body: `
<div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-12">
  <nav class="flex items-center gap-1.5 text-xs text-gray-400 mb-6">
    <a href="/" class="hover:text-gray-600 transition">Home</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
    <a href="/products" class="hover:text-gray-600 transition">Collections</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
    <span class="text-gray-600">${product.name}</span>
  </nav>

  <div class="max-w-3xl">
    <span class="inline-block text-[10px] font-semibold text-gray-400 uppercase tracking-wider mb-2">${product.category || 'Printable Art'}</span>
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">${product.name}</h1>
    <div class="flex items-center gap-2.5 mb-5">
      <span class="text-2xl font-bold text-primary">&pound;${product.price?.toFixed(2) || '0.00'}</span>
      <span class="text-sm text-gray-300 line-through">&pound;${((product.price || 0) * 1.4).toFixed(2)}</span>
      <span class="bg-emerald-50 text-emerald-700 text-[10px] font-semibold px-2 py-0.5 rounded-full">-30%</span>
    </div>
    <p class="text-sm text-gray-500 leading-relaxed mb-6">${product.description || 'A curated set of printable artwork and design resources for your home. Created by professional interior stylists and optimised for home and professional printing.'}</p>

    <div class="bg-gray-50 rounded-xl p-4 space-y-2.5 mb-6">
      ${[
        { text: 'Instant digital download' },
        { text: 'High-resolution 300 DPI files' },
        { text: 'Print from A5 to A1' },
        { text: 'Personal and commercial licence' },
      ].map(item => '<div class="flex items-center gap-2 text-xs text-gray-600">' +
        '<svg class="w-3.5 h-3.5 text-emerald-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>' +
        '<span>' + item.text + '</span>' +
      '</div>').join('')}
    </div>

    <button onclick="Cart.add('${product.name}', '${product.slug || ''}', ${product.price || 0})" class="btn-primary w-full sm:w-auto text-white px-8 py-3 rounded-xl font-semibold text-sm transition-all hover:shadow-lg hover:shadow-primary/20 flex items-center justify-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/></svg>
      Add to Cart &mdash; &pound;${product.price?.toFixed(2) || '0.00'}
    </button>
  </div>

  <div class="mt-12">
    <h2 class="text-lg font-bold text-gray-900 mb-4">Customer Reviews</h2>
    <div class="space-y-3">
      ${[
        { name: 'Fiona P.', stars: 5, text: 'Printed these on heavyweight matte paper and popped them in oak frames — my living room looks like a Pinterest board. Incredible value for the quality.' },
        { name: 'Tom H.', stars: 4, text: 'Used the planner to rearrange our open-plan kitchen-diner. The scaled furniture cut-outs saved us from buying a sofa that would never have fitted.' },
        { name: 'Jasmine K.', stars: 5, text: 'I style rental properties and this has become my go-to resource. The colour palette tool is especially brilliant for pulling a room scheme together quickly.' },
      ].map(r =>
        '<div class="bg-gray-50 rounded-xl p-4">' +
          '<div class="flex items-center gap-2 mb-1.5">' +
            '<span class="font-semibold text-xs text-gray-900">' + r.name + '</span>' +
            '<span class="text-amber-400 text-[10px]">' + String.fromCharCode(9733).repeat(r.stars) + String.fromCharCode(9734).repeat(5 - r.stars) + '</span>' +
          '</div>' +
          '<p class="text-xs text-gray-500 leading-relaxed">' + r.text + '</p>' +
        '</div>'
      ).join('')}
    </div>
  </div>

  ${related.length > 0 ? '<div class="mt-12"><h2 class="text-lg font-bold text-gray-900 mb-4">You might also like</h2><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">' +
    related.map((r, i) => {
      const bgColors = ['bg-amber-50', 'bg-teal-50', 'bg-rose-50', 'bg-stone-100'];
      const textColors = ['text-amber-700', 'text-teal-600', 'text-rose-600', 'text-stone-600'];
      return '<a href="/products/' + (r.slug || '') + '" class="group flex items-center gap-3 bg-white border border-gray-200 rounded-xl p-3.5 hover:border-gray-300 transition">' +
        '<div class="w-9 h-9 rounded-lg ' + bgColors[i % 4] + ' flex items-center justify-center ' + textColors[i % 4] + ' shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5a1.5 1.5 0 001.5-1.5V5.25a1.5 1.5 0 00-1.5-1.5H3.75a1.5 1.5 0 00-1.5 1.5V19.5a1.5 1.5 0 001.5 1.5z"/></svg></div>' +
        '<div class="flex-1 min-w-0"><h3 class="font-semibold text-gray-900 text-xs truncate group-hover:text-primary transition">' + r.name + '</h3><span class="text-xs font-bold text-gray-900">\u00a3' + (r.price?.toFixed(2) || '0.00') + '</span></div>' +
      '</a>';
    }).join('') +
  '</div></div>' : ''}
</div>
`, store, product, related }) %>
