    </div>

    <div>
      <h2 class="text-sm font-bold text-gray-900 mb-2">7. Limitation of Liability</h2>
      <p>${store.name} provides home decor products "as is" without warranties of any kind. We shall not be liable for indirect, incidental or consequential damages. Colour accuracy may vary depending on your printer, paper stock and screen calibration.</p>
    </div>

    <div>
      <h2 class="text-sm font-bold text-gray-900 mb-2">8. Changes</h2>
      <p>We reserve the right to update these Terms at any time. Continued use constitutes acceptance.</p>
    </div>

    <div>
      <h2 class="text-sm font-bold text-gray-900 mb-2">9. Contact</h2>
      <p>Questions about these terms? Email <a href="mailto:${store.contact_email || 'hello@' + store.domain}" class="text-primary hover:underline">${store.contact_email || 'hello@' + store.domain}</a>.</p>
    </div>
  </div>
</div>
`, store }) %>
