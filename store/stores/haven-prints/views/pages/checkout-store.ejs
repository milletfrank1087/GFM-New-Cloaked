<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checkout | <%= store.name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://js.stripe.com/v3/"></script>
  <script>
    tailwind.config = { theme: { extend: { fontFamily: { inter: ['Inter', 'system-ui', 'sans-serif'] } } } }
  </script>
  <style>
    :root {
      --color-primary: <%= store.colors?.primary || '#00b964' %>;
      --color-accent: <%= store.colors?.accent || '#02a95c' %>;
    }
    .btn-primary { background-color: var(--color-primary); }
    .btn-primary:hover { filter: brightness(1.08); }
    .text-primary { color: var(--color-primary); }
    ::selection { background-color: var(--color-primary); color: white; }
    input:focus, select:focus { border-color: var(--color-primary) !important; box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 12%, transparent); outline: none; }
  </style>
</head>
<body class="font-inter bg-gray-50 min-h-screen antialiased">
  <header class="bg-white border-b border-gray-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-md bg-primary flex items-center justify-center">
          <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>
        </div>
        <span class="text-sm font-bold text-gray-900"><%= store.name %></span>
      </a>
      <div class="flex items-center gap-1.5 text-xs text-gray-400">
        <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        Secure Checkout
      </div>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-8 md:py-12">
    <div id="empty-cart" class="hidden text-center py-16">
      <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z"/></svg>
      </div>
      <h2 class="text-lg font-bold text-gray-900 mb-2">Your cart is empty</h2>
      <p class="text-sm text-gray-400 mb-6">Browse our home decor collections to find something you love.</p>
      <a href="/products" class="btn-primary inline-block text-white px-6 py-2.5 rounded-lg font-semibold text-sm">Browse Products</a>
    </div>

    <div id="checkout-content" class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-7">
        <h1 class="text-lg font-bold text-gray-900 mb-1">Complete your purchase</h1>
        <p class="text-xs text-gray-400 mb-6">Enter your details and payment information.</p>

        <div class="bg-white rounded-xl border border-gray-200 p-5 mb-4">
          <div class="grid grid-cols-2 gap-3 mb-4">
            <div>
              <label for="store-email" class="block text-xs font-medium text-gray-600 mb-1">Email</label>
              <input type="email" id="store-email" placeholder="you@example.com" autocomplete="email"
                class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none transition-all">
            </div>
            <div>
              <label for="store-name" class="block text-xs font-medium text-gray-600 mb-1">Full name</label>
              <input type="text" id="store-name" placeholder="Emma Taylor" autocomplete="name"
                class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none transition-all">
            </div>
          </div>

          <div class="flex items-center gap-2 mb-3">
            <div class="flex-1 h-px bg-gray-100"></div>
            <span class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Payment method</span>
            <div class="flex-1 h-px bg-gray-100"></div>
          </div>

          <div id="payment-loading" class="flex items-center justify-center py-8">
            <div class="flex flex-col items-center gap-2">
              <div class="w-8 h-8 rounded-full border-2 border-gray-200 border-t-emerald-500 animate-spin"></div>
              <p class="text-[11px] text-gray-400">Loading secure payment...</p>
            </div>
          </div>
          <div id="payment-element"></div>

          <div id="payment-error" class="hidden text-red-600 text-xs mb-3 p-2.5 bg-red-50 rounded-lg border border-red-100 mt-3"></div>

          <button id="submit-payment" disabled
            class="btn-primary w-full text-white py-3 rounded-xl font-semibold text-sm transition-all hover:shadow-lg disabled:opacity-40 disabled:cursor-not-allowed flex items-center justify-center gap-2 mt-4"
            data-paytext="Complete Purchase" data-processing="Processing...">
            <svg id="payment-spinner" class="hidden animate-spin w-4 h-4" viewBox="0 0 24 24" fill="none">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
            </svg>
            <span id="btn-text">Complete Purchase</span>
          </button>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-4 text-[10px] text-gray-400">
          <div class="flex items-center gap-1">
            <svg class="w-3 h-3 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            256-bit SSL
          </div>
          <div class="flex items-center gap-1">
            <svg class="w-3 h-3 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
            PCI Compliant
          </div>
          <div class="flex items-center gap-1">Powered by Stripe</div>
        </div>
      </div>

      <div class="md:col-span-5">
        <div class="bg-white rounded-xl border border-gray-200 p-5 sticky top-20">
          <h2 class="text-sm font-bold text-gray-900 mb-4">Order Summary</h2>
          <div id="order-items" class="space-y-2.5 mb-4"></div>
          <div class="border-t border-gray-100 pt-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-gray-900">Total</span>
              <span id="order-total" class="text-base font-bold text-primary">&pound;0.00</span>
            </div>
          </div>
        </div>

        <div class="mt-3 bg-white rounded-xl border border-gray-200 p-4">
          <div class="flex items-center gap-2.5 mb-2">
            <div class="w-7 h-7 rounded-full bg-emerald-50 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-900">Instant Delivery</p>
              <p class="text-[10px] text-gray-400">Home decor files delivered immediately</p>
            </div>
          </div>
          <div class="flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-full bg-teal-50 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5 text-teal-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-900">Commercial Licence</p>
              <p class="text-[10px] text-gray-400">Use in homes, rentals and client projects</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <input type="hidden" id="stripe-key" value="<%= stripePublishableKey %>">

  <script>
  (function() {
    var CART_KEY = 'store_cart';
    var items = [];
    try { items = JSON.parse(localStorage.getItem(CART_KEY)) || []; } catch(e) {}

    var emptyEl = document.getElementById('empty-cart');
    var contentEl = document.getElementById('checkout-content');

    if (!items.length) {
      emptyEl.classList.remove('hidden');
      contentEl.style.display = 'none';
      return;
    }

    var orderItemsEl = document.getElementById('order-items');
    var orderTotalEl = document.getElementById('order-total');
    var total = 0;

    items.forEach(function(item) {
      total += item.price * item.quantity;
      orderItemsEl.innerHTML += '<div class="flex items-center gap-3">' +
        '<div class="w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center shrink-0">' +
          '<svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5a1.5 1.5 0 001.5-1.5V5.25a1.5 1.5 0 00-1.5-1.5H3.75a1.5 1.5 0 00-1.5 1.5V19.5a1.5 1.5 0 001.5 1.5z"/></svg>' +
        '</div>' +
        '<div class="flex-1 min-w-0">' +
          '<p class="text-xs font-medium text-gray-900 truncate">' + item.name + '</p>' +
          '<p class="text-[10px] text-gray-400">Qty: ' + item.quantity + '</p>' +
        '</div>' +
        '<span class="text-xs font-semibold text-gray-900">&pound;' + (item.price * item.quantity).toFixed(2) + '</span>' +
      '</div>';
    });

    orderTotalEl.textContent = '\u00a3' + total.toFixed(2);

    var stripeKey = document.getElementById('stripe-key').value;
    var stripe = Stripe(stripeKey);
    var elements, paymentElement;

    var submitBtn = document.getElementById('submit-payment');
    var errorEl = document.getElementById('payment-error');
    var spinnerEl = document.getElementById('payment-spinner');
    var btnText = document.getElementById('btn-text');
    var loadingEl = document.getElementById('payment-loading');

    btnText.textContent = 'Pay \u00a3' + total.toFixed(2);
    submitBtn.setAttribute('data-paytext', 'Pay \u00a3' + total.toFixed(2));

    setTimeout(function() {
      elements = stripe.elements({
        mode: 'payment',
        amount: Math.round(total * 100),
        currency: 'gbp',
        appearance: {
          theme: 'stripe',
          variables: {
            colorPrimary: '#00b964',
            borderRadius: '8px',
            fontFamily: 'Inter, system-ui, -apple-system, sans-serif',
            spacingUnit: '4px'
          },
          rules: {
            '.Input': { border: '1px solid #e5e7eb', boxShadow: 'none', padding: '10px 12px' },
            '.Input:focus': { border: '1px solid #00b964', boxShadow: '0 0 0 3px rgba(0,185,100,0.08)' },
            '.Tab': { border: '1px solid #e5e7eb', boxShadow: 'none' },
            '.Tab--selected': { border: '1px solid #00b964', boxShadow: '0 0 0 1px #00b964' }
          }
        }
      });

      paymentElement = elements.create('payment', { layout: 'tabs' });
      paymentElement.mount('#payment-element');
      paymentElement.on('ready', function() {
        if (loadingEl) loadingEl.classList.add('hidden');
        submitBtn.disabled = false;
      });
    }, 1200);

    submitBtn.addEventListener('click', async function(e) {
      e.preventDefault();
      if (submitBtn.disabled) return;

      var email = document.getElementById('store-email').value.trim();
      var name = document.getElementById('store-name').value.trim();

      if (!email || !email.includes('@')) {
        errorEl.textContent = 'Please enter a valid email address.';
        errorEl.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      spinnerEl.classList.remove('hidden');
      btnText.textContent = 'Processing...';
      errorEl.classList.add('hidden');

      var submitResult = await elements.submit();
      if (submitResult.error) {
        errorEl.textContent = submitResult.error.message;
        errorEl.classList.remove('hidden');
        submitBtn.disabled = false;
        spinnerEl.classList.add('hidden');
        btnText.textContent = submitBtn.dataset.paytext;
        return;
      }

      try {
        var res = await fetch('/api/store-checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: items })
        });
        var data = await res.json();
        if (!data.clientSecret) throw new Error(data.error || 'Payment setup failed');

        var confirmResult = await stripe.confirmPayment({
          elements: elements,
          clientSecret: data.clientSecret,
          confirmParams: {
            payment_method_data: {
              billing_details: { name: name || undefined, email: email || undefined }
            }
          },
          redirect: 'if_required'
        });

        if (confirmResult.error) {
          errorEl.textContent = confirmResult.error.message;
          errorEl.classList.remove('hidden');
          submitBtn.disabled = false;
          spinnerEl.classList.add('hidden');
          btnText.textContent = submitBtn.dataset.paytext;
          return;
        }

        localStorage.removeItem(CART_KEY);
        document.querySelector('main').innerHTML = '<div class="text-center py-20">' +
          '<div class="w-16 h-16 rounded-full bg-emerald-50 flex items-center justify-center mx-auto mb-4">' +
            '<svg class="w-8 h-8 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>' +
          '</div>' +
          '<h2 class="text-xl font-bold text-gray-900 mb-2">Order Complete</h2>' +
          '<p class="text-sm text-gray-400 mb-6">Thank you for your purchase. A confirmation email with download links will arrive shortly.</p>' +
          '<a href="/" class="btn-primary inline-block text-white px-6 py-2.5 rounded-lg font-semibold text-sm">Back to Shop</a>' +
        '</div>';
      } catch(err) {
        errorEl.textContent = err.message;
        errorEl.classList.remove('hidden');
        submitBtn.disabled = false;
        spinnerEl.classList.add('hidden');
        btnText.textContent = submitBtn.dataset.paytext;
      }
    });
  })();
  </script>
</body>
</html>
