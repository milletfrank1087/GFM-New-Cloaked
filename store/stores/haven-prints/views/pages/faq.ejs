<% const pageTitle = 'FAQ'; const extraHead = ''; %>
<%- include('../layouts/store', { body: `
<div class="max-w-2xl mx-auto px-4 sm:px-6 py-10 md:py-14">
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Frequently Asked Questions</h1>
    <p class="text-sm text-gray-400">Everything you need to know about our printable art and design resources.</p>
  </div>

  <div class="space-y-2">
    ${[
      { q: 'What payment methods do you accept?', a: 'We accept all major credit and debit cards including Visa, Mastercard and American Express through our secure Stripe payment gateway. Apple Pay and Google Pay are also supported.' },
      { q: 'How do I receive my prints?', a: 'All products are delivered as high-resolution digital files. After payment you receive instant access to download your purchased items. A confirmation email with download links arrives within minutes.' },
      { q: 'What sizes can I print?', a: 'Our files are 300 DPI and designed to print beautifully from A5 up to A1. Each product listing notes the recommended size range. Most wall art collections include multiple aspect ratios (4:5, 3:4, 2:3 and A-series).' },
      { q: 'Is my payment secure?', a: 'All payment processing is handled by Stripe, PCI-DSS Level 1 certified. Your card details are encrypted with 256-bit SSL and never stored on our servers.' },
      { q: 'What paper should I use?', a: 'For wall art we recommend 200-250 gsm matte or satin card stock for the best results. Standard home inkjet printers handle up to A4 brilliantly. For larger sizes upload the files to a local or online print shop — most offer same-day turnaround.' },
      { q: 'Can I use the designs commercially?', a: 'Yes. All products include a personal and commercial licence. You may use them in your own home, rental properties, Airbnb listings, client staging projects or offices. Redistribution or resale of the original files is not permitted.' },
      { q: 'What file formats are included?', a: 'Art prints come as high-resolution PDF and JPEG. Design kits and planners include PDF, XLSX and PNG. Colour palette generators come as interactive XLSX files. Specific formats are listed on each product page.' },
      { q: 'Can I get a refund?', a: 'Due to the digital nature of our products, all sales are final once download access is provided. If you experience technical issues or the product does not match its description, please contact our support team within 48 hours.' },
      { q: 'Do you release new collections?', a: 'Yes — we publish new collections and seasonal updates monthly. Subscribe to our newsletter to be the first to know about releases and early-bird pricing.' },
      { q: 'How do I contact support?', a: 'Visit our <a href="/contact" class="text-primary hover:underline">contact page</a> or email ${store.contact_email || "hello@" + store.domain}. We respond within 24 hours on business days.' }
    ].map(item => '<details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">' +
      '<summary class="flex items-center justify-between px-4 py-3.5 cursor-pointer list-none font-semibold text-gray-900 text-sm hover:text-primary transition">' +
        '<span class="pr-4">' + item.q + '</span>' +
        '<svg class="w-4 h-4 text-gray-400 group-open:rotate-180 transition-transform shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>' +
      '</summary>' +
      '<div class="px-4 pb-3.5 text-gray-500 text-xs leading-relaxed border-t border-gray-100 pt-3">' + item.a + '</div>' +
    '</details>').join('')}
  </div>

  <div class="bg-gray-50 rounded-xl p-6 text-center mt-10">
    <h3 class="text-base font-bold text-gray-900 mb-2">Still have questions?</h3>
    <p class="text-xs text-gray-400 mb-4">Our team is happy to help with sizing, printing or styling advice.</p>
    <a href="/contact" class="btn-primary inline-block text-white px-6 py-2.5 rounded-lg font-semibold text-sm transition hover:shadow-lg">Contact Support</a>
  </div>
</div>
`, store }) %>
