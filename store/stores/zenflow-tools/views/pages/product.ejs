<% const pageTitle = product.name; const extraHead = ''; %>
<%- include('../layouts/store', { body: `
<div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-12">
  <nav class="flex items-center gap-1.5 text-xs text-gray-400 mb-6">
    <a href="/" class="hover:text-gray-600 transition">Home</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
    <a href="/products" class="hover:text-gray-600 transition">Products</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
    <span class="text-gray-600">${product.name}</span>
  </nav>

  <div class="max-w-3xl">
    <span class="inline-block text-[10px] font-semibold text-gray-400 uppercase tracking-wider mb-2">${product.category || 'Digital Product'}</span>
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">${product.name}</h1>
    <div class="flex items-center gap-2.5 mb-5">
      <span class="text-2xl font-bold text-primary">&euro;${product.price?.toFixed(2) || '0.00'}</span>
      <span class="text-sm text-gray-300 line-through">&euro;${((product.price || 0) * 1.4).toFixed(2)}</span>
      <span class="bg-emerald-50 text-emerald-700 text-[10px] font-semibold px-2 py-0.5 rounded-full">-30%</span>
    </div>
    <p class="text-sm text-gray-500 leading-relaxed mb-6">${product.description || 'A premium digital product designed to enhance your workflow and productivity. Crafted by industry experts and tested with real businesses.'}</p>

    <div class="bg-gray-50 rounded-xl p-4 space-y-2.5 mb-6">
      ${[
        { text: 'Instant digital delivery' },
        { text: 'Commercial license included' },
        { text: 'Lifetime access with free updates' },
        { text: 'Secure payment via Stripe' },
      ].map(item => '<div class="flex items-center gap-2 text-xs text-gray-600">' +
        '<svg class="w-3.5 h-3.5 text-emerald-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>' +
        '<span>' + item.text + '</span>' +
      '</div>').join('')}
    </div>

    <button onclick="Cart.add('${product.name}', '${product.slug || ''}', ${product.price || 0})" class="btn-primary w-full sm:w-auto text-white px-8 py-3 rounded-xl font-semibold text-sm transition-all hover:shadow-lg hover:shadow-primary/20 flex items-center justify-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/></svg>
      Add to Cart &mdash; &euro;${product.price?.toFixed(2) || '0.00'}
    </button>
  </div>

  <div class="mt-12">
    <h2 class="text-lg font-bold text-gray-900 mb-4">Customer Reviews</h2>
    <div class="space-y-3">
      ${[
        { name: 'Sarah M.', stars: 5, text: 'Exactly what I needed. Clean design and easy to customize for my business.' },
        { name: 'David K.', stars: 4, text: 'Great value for the price. Saved me hours of work setting things up from scratch.' },
        { name: 'Emily R.', stars: 5, text: 'Professional quality. I use these daily and they have streamlined my workflow significantly.' },
      ].map(r =>
        '<div class="bg-gray-50 rounded-xl p-4">' +
          '<div class="flex items-center gap-2 mb-1.5">' +
            '<span class="font-semibold text-xs text-gray-900">' + r.name + '</span>' +
            '<span class="text-amber-400 text-[10px]">' + '★'.repeat(r.stars) + '☆'.repeat(5 - r.stars) + '</span>' +
          '</div>' +
          '<p class="text-xs text-gray-500 leading-relaxed">' + r.text + '</p>' +
        '</div>'
      ).join('')}
    </div>
  </div>

  ${related.length > 0 ? '<div class="mt-12"><h2 class="text-lg font-bold text-gray-900 mb-4">You might also like</h2><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">' +
    related.map((r, i) => {
      const bgColors = ['bg-blue-50', 'bg-emerald-50', 'bg-violet-50', 'bg-amber-50'];
      const textColors = ['text-blue-600', 'text-emerald-600', 'text-violet-600', 'text-amber-600'];
      return '<a href="/products/' + (r.slug || '') + '" class="group flex items-center gap-3 bg-white border border-gray-200 rounded-xl p-3.5 hover:border-gray-300 transition">' +
        '<div class="w-9 h-9 rounded-lg ' + bgColors[i % 4] + ' flex items-center justify-center ' + textColors[i % 4] + ' shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg></div>' +
        '<div class="flex-1 min-w-0"><h3 class="font-semibold text-gray-900 text-xs truncate group-hover:text-primary transition">' + r.name + '</h3><span class="text-xs font-bold text-gray-900">\u20ac' + (r.price?.toFixed(2) || '0.00') + '</span></div>' +
      '</a>';
    }).join('') +
  '</div></div>' : ''}
</div>
`, store, product, related }) %>
