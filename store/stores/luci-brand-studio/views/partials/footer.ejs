          class="flex-1 bg-white/5 border border-white/10 text-white placeholder-slate-500 rounded-xl px-4 py-3 text-sm focus:outline-none">
        <button type="submit" class="btn-primary text-white px-5 py-3 rounded-full font-semibold text-sm whitespace-nowrap">Subscribe</button>
