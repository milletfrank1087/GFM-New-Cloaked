      <form class="flex flex-col sm:flex-row gap-2.5" onsubmit="event.preventDefault(); var b=this.querySelector('button'); var i=this.querySelector('input'); i.value=''; i.placeholder='You are on the list \u2713'; b.textContent='Subscribed'; b.disabled=true;">
