<%
  const pageTitle = 'Answers';
  const extraHead = '';
  const email = store.contact_email || ('support@' + store.domain);
%>
<%- include('../layouts/store', { body: `
<section class="relative overflow-hidden lb-mesh border-b border-slate-100">
  <div class="relative max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-16 text-center lb-reveal">
    <span class="inline-flex items-center gap-1.5 bg-white/70 lb-glass border border-primary/15 text-primary text-xs font-semibold px-3 py-1.5 rounded-full mb-4">Help centre</span>
    <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">Answers</h1>
    <p class="text-sm sm:text-base text-slate-500 leading-relaxed max-w-xl mx-auto">Common questions creative professional founders and marketing leads ask before they buy. Still stuck? <a href="/contact" class="text-primary font-semibold hover:underline">Talk to us</a>.</p>
  </div>
</section>

<div class="max-w-2xl mx-auto px-4 sm:px-6 py-10 md:py-14 space-y-10">
  ${[
    {
      group: 'Buying & delivery',
      items: [
        { q: 'Who is this actually for?', a: 'Residential and small-commercial brand creative professionals operating in the UK. If you are a homeowner looking for an installation, this is not the right place &mdash; please contact a local creative professional instead.' },
        { q: 'How are the Resources delivered?', a: 'Every Resource is a digital download. After payment you receive a confirmation email with the download links and any accompanying spreadsheets, Figma files or PDFs. Delivery is immediate.' },
        { q: 'How long does setup take?', a: 'Most downloadable Resources are usable the same day. For managed services we book a kickoff within seven business days of payment.' },
        { q: 'What languages are the materials in?', a: 'Resources ship in English by default. Ad creative variations and sales scripts are available in German, French, Italian, Polish and Spanish on request &mdash; mention it at checkout or email us afterwards.' }
      ]
    },
    {
      group: 'Payments & security',
      items: [
        { q: 'What payment methods do you accept?', a: 'We accept all major credit and debit cards (Visa, Mastercard, American Express) through Stripe. Apple Pay and Google Pay are supported where available. For larger service bundles we can also issue an invoice on request.' },
        { q: 'Is the data and payment process secure?', a: 'All payments are processed through Stripe, a PCI-DSS Level 1 certified processor. Cards are encrypted with 256-bit SSL and never touch our servers.' },
        { q: 'Can I get a refund?', a: 'Because the assets are delivered instantly and cannot be returned, we operate a 14-day issue-resolution policy: if a download fails, a file is corrupt or a service deliverable was not produced as described, we either fix it or issue a refund. Email ' + email + ' within 14 days of purchase.' }
      ]
    },
    {
      group: 'Licensing & services',
      items: [
        { q: 'Can I use the Resources with my clients?', a: 'Yes &mdash; the standard licence covers internal use and use with your creative professional clients. Reselling the original files as a competing product is not allowed.' },
        { q: 'Do you offer custom work?', a: 'Yes. The Lead Generation Quarterly Retainer and Annual Growth Partnership are managed engagements. Reach out via the contact page if you want a scope-of-work proposal.' },
        { q: 'Do you replace our existing agency?', a: 'Sometimes. Many creative professionals keep an in-house marketing manager and buy individual Resources. Others move from a generalist agency onto our quarterly retainer. Both work.' }
      ]
    }
  ].map(section => '<div class="lb-reveal">' +
    '<h2 class="text-xs font-semibold text-primary uppercase tracking-wider mb-3 pl-1">' + section.group + '</h2>' +
    '<div class="space-y-2">' +
      section.items.map(item => '<details class="group lb-card bg-white rounded-xl overflow-hidden">' +
        '<summary class="flex items-center justify-between px-4 py-3.5 cursor-pointer list-none font-semibold text-slate-900 text-sm hover:text-primary transition">' +
          '<span class="pr-4">' + item.q + '</span>' +
          '<svg class="w-4 h-4 text-slate-400 group-open:rotate-180 group-open:text-primary transition-transform shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>' +
        '</summary>' +
        '<div class="px-4 pb-4 text-slate-500 text-xs leading-relaxed border-t border-slate-100 pt-3">' + item.a + '</div>' +
      '</details>').join('') +
    '</div>' +
  '</div>').join('')}

  <div class="lb-reveal relative overflow-hidden rounded-3xl bg-grad-primary p-8 sm:p-10 text-center">
    <div class="lb-grid-bg absolute inset-0 opacity-20"></div>
    <div class="relative">
      <h3 class="text-xl sm:text-2xl font-bold text-white mb-2">Still have questions?</h3>
      <p class="text-sm text-white/80 mb-6 max-w-md mx-auto">We answer most enquiries within one working day.</p>
      <a href="/contact" class="inline-flex items-center justify-center gap-2 text-primary bg-white px-6 py-3.5 rounded-full font-semibold text-sm transition hover:shadow-lg">Send us a message
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
      </a>
    </div>
  </div>
</div>
`, store }) %>
