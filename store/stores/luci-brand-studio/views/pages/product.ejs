<% const pageTitle = product.name; const extraHead = ''; const sym = store.currencySymbol || '\u20ac'; %>
<%- include('../layouts/store', { body: `
<section class="border-b border-slate-100 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-12">
    <nav class="flex items-center gap-1.5 text-xs text-slate-400 mb-6 lb-reveal">
      <a href="/" class="hover:text-slate-600 transition">Home</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      <a href="/products" class="hover:text-slate-600 transition">All products</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      <span class="text-slate-600 truncate max-w-[40vw]">${product.name}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-7 lb-reveal">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-primary bg-primary-50 px-3 py-1.5 rounded-full">${product.category || 'Resource'}</span>
          <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-slate-600 bg-slate-100 px-3 py-1.5 rounded-full">
            <svg class="w-3.5 h-3.5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
            Digital download
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-slate-900 leading-tight tracking-tight mb-4">${product.name}</h1>
        <div class="flex items-center gap-3 mb-6">
          <div class="flex items-center gap-0.5 text-amber-400">${Array(5).fill('<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29a1 1 0 00.95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 00-.37 1.12l1.07 3.29c.3.92-.75 1.69-1.54 1.12l-2.8-2.03a1 1 0 00-1.17 0l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.29a1 1 0 00-.37-1.12L2.98 8.72c-.78-.57-.38-1.81.59-1.81h3.46a1 1 0 00.95-.69L9.05 2.93z"/></svg>').join('')}</div>
          <span class="text-xs text-slate-400">Trusted by 320+ creative professionals across the UK</span>
        </div>
        <p class="text-sm sm:text-base text-slate-500 leading-relaxed mb-8">${product.description || 'A production-grade brand and design resource, written and field-tested by our studio team.'}</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
          ${[
            { t: 'Built for design teams', d: 'Written specifically for residential and commercial brand brands in the UK.' },
            { t: 'Field-tested, not theory', d: 'Every asset comes from live campaigns we have run for creative professional clients.' },
            { t: 'Editable source files', d: 'Spreadsheets, docs and design files you can adapt to your own brand and process.' },
            { t: 'Lifetime updates', d: 'When we revise a Resource, you get the new version at no extra cost.' }
          ].map((f, i) => '<div class="lb-reveal lb-card bg-white rounded-2xl p-4" data-delay="' + (i * 60) + '">' +
            '<div class="flex items-center gap-2 mb-1"><svg class="w-4 h-4 text-primary shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>' +
            '<h3 class="font-semibold text-slate-900 text-xs">' + f.t + '</h3></div>' +
            '<p class="text-[11px] text-slate-500 leading-relaxed pl-6">' + f.d + '</p>' +
          '</div>').join('')}
        </div>

        <div class="lb-card bg-primary-50/50 rounded-2xl p-5 mb-2 lb-reveal">
          <h2 class="text-sm font-bold text-slate-900 mb-3">What is inside</h2>
          <div class="space-y-2.5">
            ${[
              'Instant download after payment, delivered to your email',
              'Commercial licence for creative professionals and their advisers',
              'Updates included for the lifetime of the Resource',
              'Email support during business hours (one working day)'
            ].map(item => '<div class="flex items-center gap-2 text-xs text-slate-600">' +
              '<svg class="w-4 h-4 text-primary shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>' +
              '<span>' + item + '</span></div>').join('')}
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 lg:sticky lg:top-24 lb-reveal" data-delay="120">
        <div class="lb-card bg-white rounded-3xl p-6 shadow-lg shadow-slate-900/5">
          <div class="flex items-end gap-2.5 mb-1">
            <span class="text-3xl font-extrabold text-slate-900">${sym}${product.price?.toFixed(2) || '0.00'}</span>
            <span class="text-sm text-slate-300 line-through mb-1">${sym}${((product.price || 0) * 1.35).toFixed(2)}</span>
          </div>
          <div class="flex items-center gap-2 mb-5">
            <span class="bg-primary-50 text-primary text-[10px] font-semibold px-2 py-0.5 rounded-full">Save 26%</span>
            <span class="text-[11px] text-slate-400">One-time payment &middot; VAT may apply</span>
          </div>

          <button onclick="Cart.add('${product.name}', '${product.slug || ''}', ${product.price || 0})" class="btn-primary w-full text-white py-3.5 rounded-full font-semibold text-sm transition-all flex items-center justify-center gap-2 mb-2.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.4c.5 0 .95.34 1.08.83l.39 1.44M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.2c1.1-2.3 2.1-4.7 2.9-7.1a60 60 0 00-16.5-1.9M7.5 14.25L5.1 5.27M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/></svg>
            Add to cart
          </button>
          <a href="/cart" class="block w-full text-center text-xs font-semibold text-slate-500 hover:text-slate-900 transition py-2">Go to cart &rarr;</a>

          <div class="border-t border-slate-100 mt-4 pt-4 space-y-3">
            ${[
              { t: 'Instant access', d: 'Files delivered the moment payment clears' },
              { t: 'Secure checkout', d: 'Encrypted checkout, PCI-DSS Level 1' },
              { t: 'Issue-resolution guarantee', d: '14-day fix-or-refund on any download fault' }
            ].map(b => '<div class="flex items-start gap-2.5">' +
              '<div class="w-7 h-7 rounded-lg bg-primary-50 flex items-center justify-center shrink-0"><svg class="w-3.5 h-3.5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>' +
              '<div><p class="text-xs font-semibold text-slate-900">' + b.t + '</p><p class="text-[11px] text-slate-400">' + b.d + '</p></div>' +
            '</div>').join('')}
          </div>

          <div class="flex items-center justify-center gap-1.5 mt-5 pt-4 border-t border-slate-100">
            <svg class="h-5 rounded" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#1A1F71"/><path d="M15.6 16.3l2.4-9h2.9l-2.4 9h-2.9zm11.8-9l-2.7 6.2-.3-1.5-1-5.1s-.1-.6-.8-.6h-4.1l-.1.3s.8.2 1.8.5l2 7.2h3l4.6-7h-2.4zm-16.2 0h-4.5l-.1.3s.9.2 1.7.5c1 .4 1.1.6 1.3 1.3l2.3 7h3l4.7-9.1h-3l-3 6.2-1.2-5.3s-.2-.9-.9-.9z" fill="white"/></svg>
            <svg class="h-5 rounded" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#0b0b0b"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B"/><path d="M19 7.3a7 7 0 010 9.4 7 7 0 000-9.4z" fill="#FF5F00"/></svg>
            <span class="text-[10px] text-slate-400 ml-1">+ Apple Pay &amp; Google Pay</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
  <div class="lb-reveal">
    <h2 class="text-lg font-bold text-slate-900 mb-1">What design teams say</h2>
    <p class="text-sm text-slate-400 mb-5">Verified buyers using this Resource in live campaigns.</p>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
    ${[
      { name: 'Markus B.', role: 'creative professional, DE', stars: 5, text: 'Used this on a regional creative professional launch in Bavaria. The ad copy alone replaced two months of agency work.' },
      { name: 'Sofia M.', role: 'Marketing lead, ES', stars: 4, text: 'Tight, well-structured, and clearly written by someone who has worked creative professional accounts before. Worth the price.' },
      { name: 'Daniel V.', role: 'Agency owner, NL', stars: 5, text: 'We folded this into our onboarding playbook for new account managers. It is now part of every client kickoff.' }
    ].map((r, i) => '<figure class="lb-reveal lb-card bg-white rounded-2xl p-5" data-delay="' + (i * 70) + '">' +
      '<div class="flex items-center gap-2 mb-2">' +
        '<span class="text-amber-400 text-xs tracking-tight">' + '\u2605'.repeat(r.stars) + '<span class="text-slate-200">' + '\u2605'.repeat(5 - r.stars) + '</span></span>' +
      '</div>' +
      '<blockquote class="text-xs text-slate-600 leading-relaxed mb-4">&ldquo;' + r.text + '&rdquo;</blockquote>' +
      '<figcaption class="flex items-center gap-2.5"><div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-[11px] font-semibold text-slate-500">' + r.name.split(' ').map(w => w[0]).join('') + '</div><div><p class="text-xs font-semibold text-slate-900">' + r.name + '</p><p class="text-[10px] text-slate-400">' + r.role + '</p></div></figcaption>' +
    '</figure>').join('')}
  </div>

  ${related.length > 0 ? '<div class="mt-12"><div class="flex items-end justify-between mb-5 lb-reveal"><h2 class="text-lg font-bold text-slate-900">Bought alongside this</h2><a href="/products" class="text-sm text-primary font-semibold lb-link">All products</a></div>' +
    '<div class="grid grid-cols-2 lg:grid-cols-4 gap-3">' +
    related.map((r, i) => {
      return '<div class="lb-reveal lb-lift group flex flex-col bg-white lb-card rounded-2xl p-4" data-delay="' + (i * 60) + '">' +
        '<span class="inline-flex w-fit items-center text-[10px] font-semibold text-primary bg-primary-50 px-2.5 py-1 rounded-full mb-3">' + (r.category || 'Resource') + '</span>' +
        '<a href="/products/' + (r.slug || '') + '" class="block flex-1"><h3 class="font-semibold text-slate-900 text-xs leading-snug mb-3 line-clamp-2 group-hover:text-primary transition">' + r.name + '</h3></a>' +
        '<div class="flex items-center justify-between mt-auto pt-2"><span class="text-sm font-bold text-slate-900">' + sym + (r.price?.toFixed(2) || '0.00') + '</span>' +
        '<button type="button" data-add-to-cart data-name="' + r.name + '" data-slug="' + (r.slug || '') + '" data-price="' + (r.price || 0) + '" class="text-[11px] font-semibold text-primary lb-link">Add +</button></div>' +
      '</div>';
    }).join('') +
  '</div></div>' : ''}
</div>
`, store, product, related }) %>
