<% const pageTitle = 'Privacy Policy'; const extraHead = ''; %>
<%- include('../layouts/store', { body: `
<div class="max-w-2xl mx-auto px-4 sm:px-6 py-10 md:py-14">
  <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-1">Privacy Policy</h1>
  <p class="text-xs text-gray-400 mb-8">Last updated: ${new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>

  <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-6 text-gray-500 text-xs leading-relaxed">
    <p>${store.name} respects your privacy. This policy explains what data we collect, why, and how we protect it.</p>

    <div>
      <h2 class="text-sm font-bold text-gray-900 mb-2">Information We Collect</h2>
      <ul class="list-disc pl-4 space-y-1">
        <li><strong class="text-gray-700">Purchase Details:</strong> Name, email, and billing info provided at checkout</li>
        <li><strong class="text-gray-700">Payment Data:</strong> Processed securely by Stripe. We never see or store full card numbers</li>
        <li><strong class="text-gray-700">Usage Data:</strong> Pages visited and time on site for anonymous analytics</li>
        <li><strong class="text-gray-700">Communications:</strong> Any info you share when contacting support</li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-bold text-gray-900 mb-2">How We Use Your Information</h2>
      <ul class="list-disc pl-4 space-y-1">
        <li>Process purchases and deliver digital files</li>
        <li>Send order confirmations and access links</li>
        <li>Respond to support enquiries</li>
        <li>Improve products and website experience</li>
        <li>Meet legal and regulatory obligations</li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-bold text-gray-900 mb-2">Data Security</h2>
      <p>We rely on industry-standard protections. Payments are encrypted via 256-bit SSL through Stripe, which is PCI-DSS Level 1 certified.</p>
    </div>

    <div>
      <h2 class="text-sm font-bold text-gray-900 mb-2">Third-Party Services</h2>
      <ul class="list-disc pl-4 space-y-1">
        <li><strong class="text-gray-700">Stripe:</strong> Payment processing (<a href="https://stripe.com/privacy" class="text-primary hover:underline" target="_blank" rel="noopener">Stripe Privacy Policy</a>)</li>
        <li><strong class="text-gray-700">Analytics:</strong> Privacy-friendly analytics for site improvement</li>
      </ul>
      <p class="mt-2">We do not sell or rent your personal information to anyone.</p>
    </div>

    <div>
      <h2 class="text-sm font-bold text-gray-900 mb-2">Cookies</h2>
      <p>We use essential cookies only — for checkout sessions and basic site functionality. No advertising or third-party tracking cookies are used.</p>
    </div>

    <div>
      <h2 class="text-sm font-bold text-gray-900 mb-2">Your Rights</h2>
      <p class="mb-1.5">You may have the right to access, correct, delete, restrict, or port your data depending on your jurisdiction. Contact us to exercise these rights.</p>
    </div>

    <div>
      <h2 class="text-sm font-bold text-gray-900 mb-2">Contact</h2>
      <p class="mb-2">ECOMJJ LIMITED &middot; Reg.&nbsp;80789959 &middot; Unit 903A, 9/F., Cameron Comm Centre, 458&ndash;468 Hennessy Road, Causeway Bay, Hong Kong.</p>
      <p>Privacy questions? Email <a href="mailto:${store.contact_email || 'support@' + store.domain}" class="text-primary hover:underline">${store.contact_email || 'support@' + store.domain}</a></p>
    </div>
  </div>
</div>
`, store }) %>
