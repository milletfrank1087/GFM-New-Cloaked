<% const pageTitle = 'Cart'; const extraHead = ''; %>
<%- include('../layouts/store', { body: `
<div class="max-w-2xl mx-auto px-4 sm:px-6 py-10 md:py-16">
  <div id="cart-empty" style="display:none" class="text-center py-10">
    <div class="w-16 h-16 rounded-full bg-neutral-100 flex items-center justify-center mx-auto mb-5">
      <svg class="w-7 h-7 text-neutral-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6h16.5l-1.5 11.25A2.25 2.25 0 0116.5 19.5h-9a2.25 2.25 0 01-2.25-2.25L3.75 6zM7.5 6V4.5A3.75 3.75 0 0111.25 .75h1.5A3.75 3.75 0 0116.5 4.5V6"/>
      </svg>
    </div>
    <h1 class="text-xl font-bold text-neutral-900 mb-2">Your cart is empty</h1>
    <p class="text-sm text-neutral-400 mb-6 max-w-xs mx-auto">Browse our patterns, guides and lookbooks to find your next download.</p>
    <a href="/products" class="btn-primary inline-flex items-center gap-2 text-white px-6 py-2.5 rounded-xl font-semibold text-sm transition hover:shadow-lg">Shop the collection</a>
  </div>

  <div id="cart-filled" style="display:none">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-xl font-bold text-neutral-900">Cart</h1>
      <span id="cart-item-count" class="text-xs text-neutral-400"></span>
    </div>
    <div id="cart-items" class="bg-white pc-card rounded-xl p-4 mb-4"></div>
    <div class="bg-white pc-card rounded-xl p-4">
      <div class="flex items-center justify-between mb-3">
        <span class="text-sm text-neutral-500">Subtotal</span>
        <span id="cart-total" class="text-lg font-bold text-neutral-900"></span>
      </div>
      <a href="/checkout?store=1" class="btn-primary w-full flex items-center justify-center gap-2 text-white py-3 rounded-xl font-semibold text-sm transition hover:shadow-lg">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        Proceed to checkout
      </a>
      <button onclick="Cart.clear(); Cart.renderCartPage();" class="w-full text-center text-xs text-neutral-400 hover:text-rose-500 mt-2 transition">Clear cart</button>
    </div>
  </div>
</div>
`, store }) %>
