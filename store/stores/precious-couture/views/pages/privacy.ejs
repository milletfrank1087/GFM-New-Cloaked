<% const pageTitle = 'Privacy Policy'; const extraHead = ''; %>
<%- include('../layouts/store', { body: `
<div class="max-w-2xl mx-auto px-4 sm:px-6 py-10 md:py-14">
  <h1 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-1">Privacy Policy</h1>
  <p class="text-xs text-neutral-400 mb-8">Last updated: ${new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>

  <div class="bg-white pc-card rounded-xl p-6 space-y-6 text-neutral-500 text-xs leading-relaxed">
    <p>${store.name} respects your privacy. This policy explains what information we collect when you visit our website or buy a download, how we use it, and the choices you have. We act as the data controller for the data described below.</p>

    <div>
      <h2 class="text-sm font-bold text-neutral-900 mb-2">Information we collect</h2>
      <ul class="list-disc pl-4 space-y-1">
        <li><strong class="text-neutral-700">Order details:</strong> the name, email and billing address you provide at checkout.</li>
        <li><strong class="text-neutral-700">Payment data:</strong> handled directly by Stripe. We receive only metadata such as card brand, last four digits and country &mdash; never full card numbers.</li>
        <li><strong class="text-neutral-700">Support messages:</strong> messages you send us and our replies, retained for support and audit purposes.</li>
        <li><strong class="text-neutral-700">Usage data:</strong> anonymised analytics about pages viewed and products downloaded, used to improve the catalogue.</li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-bold text-neutral-900 mb-2">How we use it</h2>
      <ul class="list-disc pl-4 space-y-1">
        <li>To fulfil and deliver your orders.</li>
        <li>To send order confirmations and download links.</li>
        <li>To provide customer support.</li>
        <li>To improve the patterns, guides and products we sell.</li>
        <li>To meet our legal and tax obligations.</li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-bold text-neutral-900 mb-2">Security</h2>
      <p>All transactions are encrypted with 256-bit TLS. Payments are processed by Stripe under their PCI-DSS Level 1 certification. Order metadata is stored in databases with role-based access controls.</p>
    </div>

    <div>
      <h2 class="text-sm font-bold text-neutral-900 mb-2">Third-party processors</h2>
      <ul class="list-disc pl-4 space-y-1">
        <li><strong class="text-neutral-700">Stripe:</strong> payment processing (<a href="https://stripe.com/privacy" target="_blank" rel="noopener" class="text-primary hover:underline">privacy policy</a>).</li>
        <li><strong class="text-neutral-700">Email delivery:</strong> for transactional emails such as order confirmations and download links.</li>
        <li><strong class="text-neutral-700">Analytics:</strong> privacy-friendly, IP-anonymised analytics for site improvement.</li>
      </ul>
      <p class="mt-2">We do not sell or rent personal information. We share data with third parties only as necessary to deliver the product you purchased.</p>
    </div>

    <div>
      <h2 class="text-sm font-bold text-neutral-900 mb-2">Cookies</h2>
      <p>We use essential cookies for session management and checkout. Optional analytics cookies are limited to first-party, IP-anonymised page-view counting.</p>
    </div>

    <div>
      <h2 class="text-sm font-bold text-neutral-900 mb-2">Your rights</h2>
      <p>You have the right to access, correct, delete, restrict or port your personal data, and to object to processing. To exercise these rights, contact us at the email below.</p>
    </div>

    <div>
      <h2 class="text-sm font-bold text-neutral-900 mb-2">Contact</h2>
      <p>For privacy enquiries: <a href="mailto:${store.contact_email || 'support@' + store.domain}" class="text-primary hover:underline">${store.contact_email || 'support@' + store.domain}</a>.</p>
    </div>
  </div>
</div>
`, store }) %>
