<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checkout | <%= store.name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <% if (paymentProcessor === 'stripe') { %>
  <script src="https://js.stripe.com/v3/"></script>
  <% } %>
  <script>
    tailwind.config = { theme: { extend: { fontFamily: { inter: ['Inter', 'system-ui', 'sans-serif'] } } } }
  </script>
  <style>
    :root {
      --color-primary: <%= store.colors?.primary || '#b76e79' %>;
      --color-accent: <%= store.colors?.accent || '#9c5760' %>;
    }
    .btn-primary { background-color: var(--color-primary); }
    .btn-primary:hover { filter: brightness(1.06); }
    .text-primary { color: var(--color-primary); }
    .bg-primary { background-color: var(--color-primary); }
    ::selection { background-color: var(--color-primary); color: white; }
    input:focus, select:focus { border-color: var(--color-primary) !important; box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 12%, transparent); outline: none; }
  </style>
</head>
<body class="font-inter bg-neutral-50 min-h-screen antialiased">
  <header class="bg-white border-b border-neutral-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-md bg-primary flex items-center justify-center">
          <svg class="w-3 h-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3l4 3-4 3-4-3 4-3zM12 9v3m0 0l-6 9h12l-6-9z"/></svg>
        </div>
        <span class="text-sm font-bold text-neutral-900"><%= store.name %></span>
      </a>
      <div class="flex items-center gap-1.5 text-xs text-neutral-400">
        <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        Secure Checkout
      </div>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-8 md:py-12">
    <div id="empty-cart" class="hidden text-center py-16">
      <div class="w-16 h-16 rounded-full bg-neutral-100 flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-neutral-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6h16.5l-1.5 11.25A2.25 2.25 0 0116.5 19.5h-9a2.25 2.25 0 01-2.25-2.25L3.75 6z"/></svg>
      </div>
      <h2 class="text-lg font-bold text-neutral-900 mb-2">Your cart is empty</h2>
      <p class="text-sm text-neutral-400 mb-6">Browse our patterns, guides and lookbooks to find your next download.</p>
      <a href="/products" class="btn-primary inline-block text-white px-6 py-2.5 rounded-lg font-semibold text-sm">Shop the collection</a>
    </div>

    <div id="checkout-content" class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-7">
        <h1 class="text-lg font-bold text-neutral-900 mb-1">Complete your order</h1>
        <p class="text-xs text-neutral-400 mb-6">Enter your details and payment information. Download links are emailed instantly.</p>

        <div class="bg-white rounded-xl border border-neutral-200 p-5 mb-4">
          <div class="grid grid-cols-2 gap-3 mb-4">
            <div>
              <label for="store-email" class="block text-xs font-medium text-neutral-600 mb-1">Email</label>
              <input type="email" id="store-email" placeholder="you@example.com" autocomplete="email"
                class="w-full border border-neutral-200 rounded-lg px-3 py-2 text-sm focus:outline-none transition-all">
            </div>
            <div>
              <label for="store-name" class="block text-xs font-medium text-neutral-600 mb-1">Full name</label>
              <input type="text" id="store-name" placeholder="Amara Lindgren" autocomplete="name"
                class="w-full border border-neutral-200 rounded-lg px-3 py-2 text-sm focus:outline-none transition-all">
            </div>
          </div>

          <div class="flex items-center gap-2 mb-3">
            <div class="flex-1 h-px bg-neutral-100"></div>
            <span class="text-[10px] font-semibold text-neutral-400 uppercase tracking-wider">Payment method</span>
            <div class="flex-1 h-px bg-neutral-100"></div>
          </div>

          <div id="payment-loading" class="flex items-center justify-center py-8">
            <div class="flex flex-col items-center gap-2">
              <div class="w-8 h-8 rounded-full border-2 border-neutral-200 border-t-emerald-500 animate-spin"></div>
              <p class="text-[11px] text-neutral-400">Loading secure payment...</p>
            </div>
          </div>
          <% if (paymentProcessor === 'stripe') { %>
          <div id="payment-element"></div>
          <% } else { %>
          <div id="paypal-button-container" class="mb-3"></div>
          <div class="flex items-center gap-2 my-3">
            <div class="flex-1 h-px bg-neutral-100"></div>
            <span class="text-[10px] font-semibold text-neutral-400 uppercase tracking-wider">or pay with card</span>
            <div class="flex-1 h-px bg-neutral-100"></div>
          </div>
          <div class="space-y-2.5">
            <div id="card-name-field" class="w-full min-h-[42px] rounded-lg"></div>
            <div id="card-number-field" class="w-full min-h-[42px] rounded-lg"></div>
            <div class="grid grid-cols-2 gap-2.5">
              <div id="card-expiry-field" class="w-full min-h-[42px] rounded-lg"></div>
              <div id="card-cvv-field" class="w-full min-h-[42px] rounded-lg"></div>
            </div>
          </div>
          <% } %>

          <div id="payment-error" class="hidden text-red-600 text-xs mb-3 p-2.5 bg-red-50 rounded-lg border border-red-100 mt-3"></div>

          <button id="submit-payment" disabled
            class="btn-primary w-full text-white py-3 rounded-xl font-semibold text-sm transition-all hover:shadow-lg disabled:opacity-40 disabled:cursor-not-allowed flex items-center justify-center gap-2 mt-4"
            data-paytext="Complete Order" data-processing="Processing...">
            <svg id="payment-spinner" class="hidden animate-spin w-4 h-4" viewBox="0 0 24 24" fill="none">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
            </svg>
            <span id="btn-text">Complete Order</span>
          </button>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-4 text-[10px] text-neutral-400">
          <div class="flex items-center gap-1">
            <svg class="w-3 h-3 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            256-bit SSL
          </div>
          <div class="flex items-center gap-1">
            <svg class="w-3 h-3 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            PCI Compliant
          </div>
          <div class="flex items-center gap-1">Powered by <%= paymentProcessor === 'paypal' ? 'PayPal' : 'Stripe' %></div>
        </div>
      </div>

      <div class="md:col-span-5">
        <div class="bg-white rounded-xl border border-neutral-200 p-5 sticky top-20">
          <h2 class="text-sm font-bold text-neutral-900 mb-4">Order summary</h2>
          <div id="order-items" class="space-y-2.5 mb-4"></div>
          <div class="border-t border-neutral-100 pt-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-neutral-900">Total</span>
              <span id="order-total" class="text-base font-bold text-primary"><%= store.currencySymbol || '$' %>0.00</span>
            </div>
          </div>
        </div>

        <div class="mt-3 bg-white rounded-xl border border-neutral-200 p-4">
          <div class="flex items-center gap-2.5 mb-2">
            <div class="w-7 h-7 rounded-full bg-emerald-50 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
            </div>
            <div>
              <p class="text-xs font-semibold text-neutral-900">Instant download</p>
              <p class="text-[10px] text-neutral-400">Your files are emailed right after payment</p>
            </div>
          </div>
          <div class="flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-full bg-sky-50 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5 text-sky-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
            </div>
            <div>
              <p class="text-xs font-semibold text-neutral-900">Lifetime updates</p>
              <p class="text-[10px] text-neutral-400">Free file revisions, yours to keep</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <meta name="store-name" content="<%= store.name %>">
  <meta name="payment-processor" content="<%= paymentProcessor %>">
  <input type="hidden" id="payment-currency" value="<%= (store.currency || 'USD').toLowerCase() %>">
  <input type="hidden" id="payment-symbol" value="<%= store.currencySymbol || '$' %>">
  <input type="hidden" id="payment-decimals" value="<%= store.currencyDecimals != null ? store.currencyDecimals : 2 %>">
  <input type="hidden" id="payment-symbol-position" value="<%= store.currencyPosition || 'before' %>">

  <script src="/js/checkout-store-cart.js"></script>
  <% if (paymentProcessor === 'stripe') { %>
  <input type="hidden" id="stripe-key" value="<%= stripePublishableKey %>">
  <script src="/js/checkout-store-stripe.js"></script>
  <% } else { %>
  <script src="/js/checkout-store-paypal.js"></script>
  <% } %>
</body>
</html>
