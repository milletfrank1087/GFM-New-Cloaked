<section class="relative overflow-hidden bg-stone-900">
  <div class="lk-mesh absolute inset-0 opacity-40"></div>
  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-14">
    <div class="lk-reveal lk-card rounded-2xl bg-white/[0.03] lk-glass border-white/10 p-6 sm:p-8 grid grid-cols-1 md:grid-cols-2 gap-6 items-center" style="background:rgba(255,255,255,0.04)">
      <div>
        <h3 class="text-white font-bold text-lg sm:text-xl mb-1.5">Join the Larkwell letter</h3>
        <p class="text-stone-400 text-xs leading-relaxed max-w-sm">One short email a month: new arrivals, a small styling idea for the home, and the occasional subscriber-only offer. No clutter, unsubscribe anytime.</p>
      </div>
      <form class="flex flex-col sm:flex-row gap-2.5" onsubmit="event.preventDefault(); var b=this.querySelector('button'); var i=this.querySelector('input'); i.value=''; i.placeholder='You are on the list ✓'; b.textContent='Subscribed'; b.disabled=true;">
        <input type="email" required placeholder="you@example.com" aria-label="Email address"
          class="flex-1 bg-white/5 border border-white/10 text-white placeholder-stone-500 rounded-xl px-4 py-3 text-sm focus:outline-none">
        <button type="submit" class="btn-primary text-white px-5 py-3 rounded-full font-semibold text-sm whitespace-nowrap">Subscribe</button>
      </form>
    </div>
  </div>
</section>

