<% const pageTitle = 'Our story'; const extraHead = ''; %>
<%- include('../layouts/store', { body: `
<section class="relative overflow-hidden lk-mesh border-b border-stone-100">
  <div class="lk-grid-bg absolute inset-0 opacity-60 pointer-events-none"></div>
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-14 md:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7 lk-reveal">
        <span class="inline-flex items-center gap-1.5 bg-white/70 lk-glass border border-primary/15 text-primary text-xs font-semibold px-3 py-1.5 rounded-full mb-5">Our story</span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight leading-[1.12] mb-4">A small homeware shop for calmer, tidier living</h1>
        <p class="text-sm sm:text-base text-stone-500 leading-relaxed max-w-xl">${store.name} is a family-run homeware shop. We curate kitchen, storage, organisation and tableware pieces that are genuinely useful day to day &mdash; and pleasant enough to leave on the counter. Everything is chosen for materials, finish and honest construction, then shipped across the EU with care.</p>
      </div>
      <div class="lg:col-span-5 lk-reveal" data-delay="120">
        <div class="lk-card lk-glass bg-white/80 rounded-2xl p-6 shadow-xl shadow-stone-900/5">
          <div class="grid grid-cols-2 gap-4">
            ${[
              { v: '24', s: '', l: 'Pieces in the range' },
              { v: '2\u20134', s: ' days', l: 'Typical EU delivery' },
              { v: '30', s: ' days', l: 'Easy returns' },
              { v: 'Free', s: '', l: 'EU delivery over \u20ac50' }
            ].map(m => '<div class="rounded-xl bg-stone-50 border border-stone-100 p-4">' +
              '<p class="text-xl font-extrabold text-stone-900">' + m.v + m.s + '</p>' +
              '<p class="text-[11px] text-stone-400 mt-0.5">' + m.l + '</p></div>').join('')}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-16">
  <div class="lk-reveal lk-card bg-white rounded-2xl p-6 sm:p-8 mb-8">
    <p class="text-sm text-stone-600 leading-relaxed mb-4">Larkwell Home started around a kitchen table, frustrated that so much homeware is either beautiful but useless or useful but ugly. We wanted a small, edited collection of pieces that quietly make a home run better &mdash; a spice rack that actually holds your jars, storage that folds away, tableware you reach for every day.</p>
    <p class="text-sm text-stone-600 leading-relaxed">So we keep the range small and the standards high. Every piece is one we would happily live with: natural materials where we can, finishes that wear in rather than out, and packaging designed to arrive intact. If something is not right, we make it right.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-12">
    <div class="lk-reveal lk-lift lk-card bg-white rounded-2xl p-6">
      <div class="w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center mb-4">
        <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10.5L12 3l9 7.5M5.25 9.75V19.5a.75.75 0 00.75.75h3.75v-5.25a1.5 1.5 0 011.5-1.5h1.5a1.5 1.5 0 011.5 1.5v5.25H18a.75.75 0 00.75-.75V9.75"/></svg>
      </div>
      <h3 class="font-semibold text-stone-900 text-sm mb-1.5">What we are</h3>
      <p class="text-xs text-stone-500 leading-relaxed">A small, family-run homeware shop with a tightly edited range of kitchen, storage and organisation pieces. No endless catalogue &mdash; just things we believe in.</p>
    </div>
    <div class="lk-reveal lk-lift lk-card bg-white rounded-2xl p-6" data-delay="80">
      <div class="w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center mb-4">
        <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <h3 class="font-semibold text-stone-900 text-sm mb-1.5">What we sell</h3>
      <p class="text-xs text-stone-500 leading-relaxed">Physical homeware: spice racks, storage bins, canisters, organisers, tableware and a few larger pieces. Shipped to your door, with free EU delivery over &euro;50.</p>
    </div>
  </div>

  <h2 class="text-lg font-bold text-stone-900 mb-5 lk-reveal">How we choose what to stock</h2>
  <div class="relative pl-6 mb-12">
    <div class="absolute left-[7px] top-2 bottom-2 w-px bg-stone-200"></div>
    <div class="space-y-4">
      ${[
        { title: 'Find a real need', desc: 'We start with a small annoyance at home &mdash; a messy drawer, a cluttered counter &mdash; and look for the piece that quietly solves it.' },
        { title: 'Test the materials', desc: 'We handle samples ourselves: bamboo, glass, stoneware and powder-coated steel that feel good and last.' },
        { title: 'Get the packaging right', desc: 'Fragile pieces are packed to survive the courier, using recyclable materials wherever we can.' },
        { title: 'Stand behind it', desc: '30-day returns and friendly email support. If it arrives damaged or is not right, we sort it out quickly.' }
      ].map((item, i) => '<div class="lk-reveal relative" data-delay="' + (i * 70) + '">' +
        '<div class="absolute -left-6 top-1 w-3.5 h-3.5 rounded-full bg-primary ring-4 ring-white"></div>' +
        '<div class="lk-card bg-white rounded-xl p-4"><p class="font-semibold text-stone-900 text-sm mb-0.5">' + item.title + '</p><p class="text-xs text-stone-500 leading-relaxed">' + item.desc + '</p></div>' +
      '</div>').join('')}
    </div>
  </div>

  <h2 class="text-lg font-bold text-stone-900 mb-5 lk-reveal">What we care about</h2>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-12">
    ${[
      { t: 'Useful first', d: 'Every piece has to earn its place at home &mdash; looks alone are never enough.' },
      { t: 'Made to last', d: 'We favour natural materials and honest construction over throwaway trends.' },
      { t: 'Looked after', d: 'Careful packing, easy returns and real replies from real people.' }
    ].map((v, i) => '<div class="lk-reveal lk-card bg-stone-50 rounded-xl p-5" data-delay="' + (i * 70) + '">' +
      '<div class="w-8 h-8 rounded-lg bg-white border border-stone-100 flex items-center justify-center mb-3 text-primary font-bold text-xs">' + (i + 1) + '</div>' +
      '<h3 class="font-semibold text-stone-900 text-sm mb-1">' + v.t + '</h3>' +
      '<p class="text-xs text-stone-500 leading-relaxed">' + v.d + '</p></div>').join('')}
  </div>

  <div class="lk-reveal relative overflow-hidden rounded-3xl bg-grad-primary p-8 sm:p-10 text-center">
    <div class="lk-grid-bg absolute inset-0 opacity-20"></div>
    <div class="relative">
      <h3 class="text-xl sm:text-2xl font-bold text-white mb-2">Have a look around the shop</h3>
      <p class="text-sm text-white/80 mb-6 max-w-md mx-auto">From spice racks to storage carts, every piece is chosen to make home feel a little calmer.</p>
      <a href="/products" class="inline-flex items-center justify-center gap-2 text-primary bg-white px-6 py-3.5 rounded-full font-semibold text-sm transition hover:shadow-lg">Shop the collection
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
      </a>
    </div>
  </div>
</div>
`, store }) %>
