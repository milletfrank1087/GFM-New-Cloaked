<%
  const pageTitle = typeof searchQuery !== 'undefined' && searchQuery ? 'Search: ' + searchQuery : 'Shop';
  const extraHead = '';
  const allCats = [...new Set((store.products || []).map(p => p.category).filter(Boolean))];
  const activeQ = (typeof searchQuery !== 'undefined' ? searchQuery : '') || '';
  const sym = store.currencySymbol || '\u20ac';
  const img = (p) => '/img/products/' + (p.slug || '') + '.png';
%>
<%- include('../layouts/store', { body: `
<section class="relative overflow-hidden lk-mesh border-b border-stone-100">
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <nav class="flex items-center gap-1.5 text-xs text-stone-400 mb-4 lk-reveal">
      <a href="/" class="hover:text-stone-600 transition">Home</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      <span class="text-stone-600">${activeQ ? 'Search' : 'All products'}</span>
    </nav>
    <div class="max-w-2xl lk-reveal">
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-stone-900 tracking-tight mb-2">${activeQ ? 'Results for &ldquo;' + activeQ + '&rdquo;' : 'The full collection'}</h1>
      <p class="text-sm text-stone-500">${(products || []).length} home &amp; kitchen piece${(products || []).length === 1 ? '' : 's'}, chosen for warm, everyday living and shipped across the EU.</p>
    </div>
    <form action="/search" method="GET" class="mt-6 max-w-md lk-reveal" data-delay="60">
      <div class="relative">
        <svg class="w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.3-4.3m1.8-4.45a6.25 6.25 0 11-12.5 0 6.25 6.25 0 0112.5 0z"/></svg>
        <input type="text" name="q" placeholder="Search storage, kitchen, decor..." value="${activeQ}" class="w-full bg-white border border-stone-200 rounded-full pl-10 pr-4 py-3 text-sm shadow-sm focus:outline-none">
      </div>
    </form>
  </div>
</section>

<div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-10">
  <div class="flex flex-wrap items-center gap-2 mb-8 lk-reveal">
    <a href="/products" class="lk-chip text-xs font-semibold px-3.5 py-2 rounded-full border ${activeQ ? 'border-stone-200 text-stone-500 bg-white hover:border-stone-300' : 'border-primary bg-primary text-white'}">All products</a>
    ${allCats.map(c => {
      const on = activeQ.toLowerCase() === c.toLowerCase();
      return '<a href="/search?q=' + encodeURIComponent(c) + '" class="lk-chip text-xs font-semibold px-3.5 py-2 rounded-full border ' + (on ? 'border-primary bg-primary text-white' : 'border-stone-200 text-stone-500 bg-white hover:border-stone-300 hover:text-stone-700') + '">' + c + '</a>';
    }).join('')}
  </div>

  ${(products || []).length === 0 ? (
    '<div class="text-center py-16 lk-reveal">' +
      '<div class="w-16 h-16 rounded-full bg-stone-100 flex items-center justify-center mx-auto mb-4"><svg class="w-7 h-7 text-stone-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.3-4.3m1.8-4.45a6.25 6.25 0 11-12.5 0 6.25 6.25 0 0112.5 0z"/></svg></div>' +
      '<h2 class="text-lg font-bold text-stone-900 mb-2">No products match that search</h2>' +
      '<p class="text-sm text-stone-400 mb-6">Try a broader term, or browse the full collection.</p>' +
      '<a href="/products" class="btn-primary inline-block text-white px-6 py-2.5 rounded-full font-semibold text-sm">View all products</a>' +
    '</div>'
  ) : (
  '<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">' +
    (products || []).map((p, i) => {
      const cf = [1.25,1.3,1.35,1.4][i % 4];
      const compare = (p.price * cf).toFixed(2);
      const pct = Math.round((1 - 1/cf) * 100);
      return '<div class="lk-reveal lk-lift group flex flex-col bg-white lk-card rounded-2xl p-3 sm:p-4" data-delay="' + ((i % 4) * 60) + '">' +
        '<a href="/products/' + (p.slug || '') + '" class="block relative">' +
          '<div class="aspect-square rounded-xl bg-primary-50/50 mb-3 overflow-hidden flex items-center justify-center">' +
            '<img src="' + img(p) + '" alt="' + p.name + '" loading="lazy" class="w-full h-full object-contain p-3.5 group-hover:scale-[1.05] transition-transform duration-300">' +
          '</div>' +
          '<span class="absolute top-2 left-2 text-[10px] font-bold text-white bg-primary px-2 py-0.5 rounded-full">-' + pct + '%</span>' +
        '</a>' +
        '<span class="text-[10px] font-semibold text-stone-400 mb-1">' + (p.category || 'Homeware') + '</span>' +
        '<a href="/products/' + (p.slug || '') + '" class="block"><h3 class="font-semibold text-stone-900 text-sm leading-snug mb-2 line-clamp-2 group-hover:text-primary transition">' + p.name + '</h3></a>' +
        '<div class="flex items-baseline gap-2 mb-3 mt-auto"><span class="text-base font-extrabold text-stone-900">' + sym + (p.price ? p.price.toFixed(2) : '0.00') + '</span><span class="text-xs text-stone-300 line-through">' + sym + compare + '</span></div>' +
        '<button type="button" data-add-to-cart data-name="' + p.name + '" data-slug="' + (p.slug || '') + '" data-price="' + (p.price || 0) + '" class="btn-primary w-full text-white py-2.5 rounded-full font-semibold text-xs inline-flex items-center justify-center gap-1.5"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.4c.5 0 .95.34 1.08.83l.39 1.44M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.2c1.1-2.3 2.1-4.7 2.9-7.1a60 60 0 00-16.5-1.9M7.5 14.25L5.1 5.27"/></svg>Add to cart</button>' +
      '</div>';
    }).join('') +
  '</div>'
  )}
</div>
`, store, products, searchQuery: typeof searchQuery !== 'undefined' ? searchQuery : '' }) %>
