<% const pageTitle = product.name; const extraHead = ''; const sym = store.currencySymbol || '\u20ac'; const img = (p) => '/img/products/' + (p.slug || '') + '.png'; %>
<%- include('../layouts/store', { body: `
<section class="border-b border-stone-100 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-12">
    <nav class="flex items-center gap-1.5 text-xs text-stone-400 mb-6 lk-reveal">
      <a href="/" class="hover:text-stone-600 transition">Home</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      <a href="/products" class="hover:text-stone-600 transition">All products</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      <span class="text-stone-600 truncate max-w-[40vw]">${product.name}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-6 lk-reveal">
        <div class="aspect-square rounded-3xl bg-primary-50/50 lk-card overflow-hidden flex items-center justify-center">
          <img src="${img(product)}" alt="${product.name}" class="w-full h-full object-contain p-8 sm:p-12">
        </div>
        <div class="grid grid-cols-3 gap-3 mt-3">
          ${['Natural materials','Made to last','Ships flat-packed where sensible'].map(t => '<div class="lk-card bg-white rounded-xl px-3 py-2.5 text-center"><p class="text-[10px] font-semibold text-stone-600 leading-snug">' + t + '</p></div>').join('')}
        </div>
      </div>

      <div class="lg:col-span-6">
        <div class="lk-reveal">
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-primary bg-primary-50 px-3 py-1.5 rounded-full">${product.category || 'Homeware'}</span>
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-3 py-1.5 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> In stock
            </span>
          </div>
          <h1 class="text-2xl sm:text-3xl md:text-[2.4rem] font-bold text-stone-900 leading-tight tracking-tight mb-4">${product.name}</h1>
          <p class="text-sm sm:text-base text-stone-500 leading-relaxed mb-6">${product.description || 'A warm, practical piece for calmer, tidier everyday living.'}</p>

          <div class="flex items-end gap-2.5 mb-1">
            <span class="text-3xl font-extrabold text-stone-900">${sym}${product.price?.toFixed(2) || '0.00'}</span>
            <span class="text-sm text-stone-300 line-through mb-1">${sym}${((product.price || 0) * 1.3).toFixed(2)}</span>
          </div>
          <div class="flex items-center gap-2 mb-5">
            <span class="bg-primary-50 text-primary text-[10px] font-semibold px-2 py-0.5 rounded-full">Save 23%</span>
            <span class="text-[11px] text-stone-400">VAT included &middot; Free EU delivery over ${sym}50</span>
          </div>

          <div class="flex flex-col sm:flex-row gap-2.5 mb-6">
            <button onclick="Cart.add('${product.name}', '${product.slug || ''}', ${product.price || 0})" class="btn-primary flex-1 text-white py-3.5 rounded-full font-semibold text-sm transition-all flex items-center justify-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.4c.5 0 .95.34 1.08.83l.39 1.44M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.2c1.1-2.3 2.1-4.7 2.9-7.1a60 60 0 00-16.5-1.9M7.5 14.25L5.1 5.27M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/></svg>
              Add to cart
            </button>
            <a href="/cart" class="inline-flex items-center justify-center text-sm font-semibold text-stone-600 bg-white border border-stone-200 hover:border-stone-300 px-6 py-3.5 rounded-full transition">Go to cart</a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 mb-6">
            ${[
              { t: 'Free EU delivery', d: 'On orders over ' + sym + '50', icon: 'M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25' },
              { t: 'Ships in 2\u20134 days', d: 'Tracked EU courier', icon: 'M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z' },
              { t: '30-day returns', d: 'Unused &amp; boxed', icon: 'M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3' }
            ].map(b => '<div class="lk-card bg-white rounded-2xl p-3.5 text-center">' +
              '<svg class="w-5 h-5 text-primary mx-auto mb-1.5" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="' + b.icon + '"/></svg>' +
              '<p class="text-xs font-semibold text-stone-900">' + b.t + '</p><p class="text-[10px] text-stone-400">' + b.d + '</p></div>').join('')}
          </div>

          <div class="lk-card bg-primary-50/50 rounded-2xl p-5 lk-reveal">
            <h2 class="text-sm font-bold text-stone-900 mb-3">Why you will like it</h2>
            <div class="space-y-2.5">
              ${[
                'Chosen for materials and finish, not just looks',
                'Sized to fit real kitchens, cupboards and rooms',
                'Carefully packed to arrive in perfect condition',
                'Backed by friendly email support and easy returns'
              ].map(item => '<div class="flex items-center gap-2 text-xs text-stone-600">' +
                '<svg class="w-4 h-4 text-primary shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>' +
                '<span>' + item + '</span></div>').join('')}
            </div>
          </div>

          <div class="flex items-center justify-center gap-1.5 mt-5 pt-4 border-t border-stone-100">
            <svg class="h-5 rounded" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#1A1F71"/><path d="M15.6 16.3l2.4-9h2.9l-2.4 9h-2.9zm11.8-9l-2.7 6.2-.3-1.5-1-5.1s-.1-.6-.8-.6h-4.1l-.1.3s.8.2 1.8.5l2 7.2h3l4.6-7h-2.4zm-16.2 0h-4.5l-.1.3s.9.2 1.7.5c1 .4 1.1.6 1.3 1.3l2.3 7h3l4.7-9.1h-3l-3 6.2-1.2-5.3s-.2-.9-.9-.9z" fill="white"/></svg>
            <svg class="h-5 rounded" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#0b0b0b"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B"/><path d="M19 7.3a7 7 0 010 9.4 7 7 0 000-9.4z" fill="#FF5F00"/></svg>
            <span class="text-[10px] text-stone-400 ml-1">+ Apple Pay &amp; Google Pay</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
  ${related.length > 0 ? '<div><div class="flex items-end justify-between mb-5 lk-reveal"><h2 class="text-lg font-bold text-stone-900">You might also like</h2><a href="/products" class="text-sm text-primary font-semibold lk-link">All products</a></div>' +
    '<div class="grid grid-cols-2 lg:grid-cols-4 gap-3">' +
    related.map((r, i) => {
      return '<div class="lk-reveal lk-lift group flex flex-col bg-white lk-card rounded-2xl p-3" data-delay="' + (i * 60) + '">' +
        '<a href="/products/' + (r.slug || '') + '" class="block"><div class="aspect-square rounded-xl bg-primary-50/50 mb-3 overflow-hidden flex items-center justify-center"><img src="' + img(r) + '" alt="' + r.name + '" loading="lazy" class="w-full h-full object-contain p-3 group-hover:scale-[1.05] transition-transform duration-300"></div></a>' +
        '<span class="inline-flex w-fit items-center text-[10px] font-semibold text-primary bg-primary-50 px-2.5 py-1 rounded-full mb-2">' + (r.category || 'Homeware') + '</span>' +
        '<a href="/products/' + (r.slug || '') + '" class="block flex-1"><h3 class="font-semibold text-stone-900 text-xs leading-snug mb-2 line-clamp-2 group-hover:text-primary transition">' + r.name + '</h3></a>' +
        '<div class="flex items-center justify-between mt-auto pt-1"><span class="text-sm font-bold text-stone-900">' + sym + (r.price?.toFixed(2) || '0.00') + '</span>' +
        '<button type="button" data-add-to-cart data-name="' + r.name + '" data-slug="' + (r.slug || '') + '" data-price="' + (r.price || 0) + '" class="text-[11px] font-semibold text-primary lk-link">Add +</button></div>' +
      '</div>';
    }).join('') +
  '</div></div>' : ''}
</div>
`, store, product, related }) %>
